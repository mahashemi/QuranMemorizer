[{"id":"passage-031","sequence":31,"arabic_text":"وَلِقاؤُكَ قُرَّةُ عَيْنِي،","transliteration":"wa liqaaaw-uka qur-ratu a'y-nee","english_text":"Meeting You is the gladness of my eye,","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"وَوَصْلُكَ مُنىٰ نَفْسِي،","transliteration":"wa was'-luka munaa naf-see","english_text":"joining You the wish of my soul.","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"وَإلَيْكَ شَوْقِي،","transliteration":"wa ilay-ka shaw-qee","english_text":"Toward You is my yearning,","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"وَفِي مَحَبَّتِكَ وَلَهِي،","transliteration":"wa fee mah'ab-batika walahee","english_text":"in love for You my passionate longing,","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"وَإلىٰ هَواكَ صَبابَتِي،","transliteration":"wa ilaa hawaaka s'abaabatee","english_text":"in inclining toward You my fervent craving.","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"وَرِضاكَ بُغْيَتِي،","transliteration":"wa riz''aaka bugh-yatee","english_text":"Your good pleasure is the aim I seek,","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"وَرُؤْيَتُكَ حاجَتِي،","transliteration":"wa roo-yatuka h'aajatee","english_text":"vision of You my need,","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"وَجِوارُكَ طَلِبَتِي،","transliteration":"wa jiwaaruka t'alabee","english_text":"Your neighbourhood my request,","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-039","sequence":39,"arabic_text":"وَقُرْبُكَ غايَةُ سُؤْلِي،","transliteration":"wa qur-buka ghayatu soo-lee","english_text":"nearness to You the utmost object of my asking.","source_pair_start":39,"source_pair_end":39,"recitation_segment":{"id":"segment-039","title":"Recitation segment 39","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-040","sequence":40,"arabic_text":"وَفِي مُناجاتِكَ رَوْحِي وَراحَتِي،","transliteration":"wa fee munajaatika raw-h'ee wa raah'atee","english_text":"In whispered prayer to You I find my repose and my ease.","source_pair_start":40,"source_pair_end":40,"recitation_segment":{"id":"segment-040","title":"Recitation segment 40","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-041","sequence":41,"arabic_text":"وَعِنْدَكَ دَواءُ عِلَّتِي،","transliteration":"wa i'ndak dawaaa-u i'l-latee","english_text":"With You lies the remedy of my illness,","source_pair_start":41,"source_pair_end":41,"recitation_segment":{"id":"segment-041","title":"Recitation segment 41","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-042","sequence":42,"arabic_text":"وَشِفاءُ غُلَّتِي،","transliteration":"wa shifaaa-u ghul-latee","english_text":"the cure for my burning thirst,","source_pair_start":42,"source_pair_end":42,"recitation_segment":{"id":"segment-042","title":"Recitation segment 42","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-043","sequence":43,"arabic_text":"وَبَرْدُ لَوْعَتِي،","transliteration":"wa bar-du law-a'tee","english_text":"the coolness of my ardour,","source_pair_start":43,"source_pair_end":43,"recitation_segment":{"id":"segment-043","title":"Recitation segment 43","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-044","sequence":44,"arabic_text":"وَكَشْفُ كُرْبَتِي،","transliteration":"wa kash-fu kur-batee","english_text":"the removal of my distress.","source_pair_start":44,"source_pair_end":44,"recitation_segment":{"id":"segment-044","title":"Recitation segment 44","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-045","sequence":45,"arabic_text":"فَكُنْ أَنِيسِي فِي وَحْشَتِي،","transliteration":"fakun aneesee fee wah'-shatee","english_text":"Be my intimate in my loneliness,","source_pair_start":45,"source_pair_end":45,"recitation_segment":{"id":"segment-045","title":"Recitation segment 45","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-046","sequence":46,"arabic_text":"وَمُقِيلَ عَثْرَتِي،","transliteration":"wa muqeela a'th-ratee","english_text":"the releaser of my stumble,","source_pair_start":46,"source_pair_end":46,"recitation_segment":{"id":"segment-046","title":"Recitation segment 46","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-047","sequence":47,"arabic_text":"وَغافِرَ زَلَّتِي،","transliteration":"wa ghaafira zal-latee","english_text":"the forgiver of my slip,","source_pair_start":47,"source_pair_end":47,"recitation_segment":{"id":"segment-047","title":"Recitation segment 47","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-048","sequence":48,"arabic_text":"وَقابِلَ تَوْبَتِي،","transliteration":"wa qaabila taw-batee","english_text":"the accepter of my repentance,","source_pair_start":48,"source_pair_end":48,"recitation_segment":{"id":"segment-048","title":"Recitation segment 48","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-049","sequence":49,"arabic_text":"وَمُجِيبَ دَعْوَتِي،","transliteration":"wa mujeeba daa'-watee","english_text":"the responder to my supplication,","source_pair_start":49,"source_pair_end":49,"recitation_segment":{"id":"segment-049","title":"Recitation segment 49","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-050","sequence":50,"arabic_text":"وَوَلِيَّ عِصْمَتِي،","transliteration":"wa walee-ya i's'-matee","english_text":"the patron of preserving me from sin,","source_pair_start":50,"source_pair_end":50,"recitation_segment":{"id":"segment-050","title":"Recitation segment 50","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-051","sequence":51,"arabic_text":"وَمُغْنِيَ فاقَتِي،","transliteration":"wa mugh-neea faaqatee","english_text":"the one who frees me from my neediness!","source_pair_start":51,"source_pair_end":51,"recitation_segment":{"id":"segment-051","title":"Recitation segment 51","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-052","sequence":52,"arabic_text":"وَلا تَقْطَعْنِي عَنْكَ،","transliteration":"wa laa taq-t'aa'-nee a'nk","english_text":"Cut me not off from You","source_pair_start":52,"source_pair_end":52,"recitation_segment":{"id":"segment-052","title":"Recitation segment 52","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-053","sequence":53,"arabic_text":"وَلا تُبْعِدْنِي مِنْكَ،","transliteration":"wa laa tub-i'd-nee mink","english_text":"and keep me not far from You!","source_pair_start":53,"source_pair_end":53,"recitation_segment":{"id":"segment-053","title":"Recitation segment 53","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-054","sequence":54,"arabic_text":"يا نَعِيمِي وَجَنَّتِي،","transliteration":"yaa nae'emee wa jan-natee","english_text":"O my bliss and my garden!","source_pair_start":54,"source_pair_end":54,"recitation_segment":{"id":"segment-054","title":"Recitation segment 54","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-055","sequence":55,"arabic_text":"وَيا دُنْيايَ وَآخِرَتِي،","transliteration":"wa yaa dunyaaya wa aaakhiratee","english_text":"O my this world and my hereafter!","source_pair_start":55,"source_pair_end":55,"recitation_segment":{"id":"segment-055","title":"Recitation segment 55","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-056","sequence":56,"arabic_text":"يا أَرْحَمَ الرَّاحِمِينَ. ","transliteration":"yaaa ar-h'amar-raah'imeen","english_text":"O Most Merciful of the merciful!","source_pair_start":56,"source_pair_end":56,"recitation_segment":{"id":"segment-056","title":"Recitation segment 56","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
