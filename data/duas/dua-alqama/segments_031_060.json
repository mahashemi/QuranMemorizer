[{"id":"passage-031","sequence":31,"arabic_text":"وَبِهِمْ أَتَوَسَّلُ","transliteration":"wa bihim atawassalu","english_text":"I make them my means to You,","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"وَبِهِمْ أَتَشَفَّعُ إِلَيْكَ","transliteration":"wa bihim atashaffa`u ilayka","english_text":"I seek their intercession for me with You,","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"وَبِحَقِّهِمْ أَسْأَلُكَ وَأُقْسِمُ وَأَعْزِمُ عَلَيْكَ","transliteration":"wa bihaqqihim as'aluka wa uqsimu wa a`zimu `alayka","english_text":"I beseech You in the name of Your duty towards them, I adjure You, and I beg You earnestly,","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"وَبِٱلشَّأْنِ ٱلَّذِي لَهُمْ عِنْدَكَ","transliteration":"wa bilshsha'ni alladhi lahum `indaka","english_text":"in the name of the status that they enjoy with You,","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"وَبِٱلْقَدْرِ ٱلَّذِي لَهُمْ عِنْدَكَ","transliteration":"wa bilqadri alladhi lahum `indaka","english_text":"the value that they enjoy in Your sight,","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"وَبِٱلَّذِي فَضَّلْتَهُمْ عَلَىٰ ٱلْعَالَمِينَ","transliteration":"wa billadhi faddaltahum `ala al`alamina","english_text":"in the name of the thing by which You have preferred them over all the other beings,","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"وَبِٱسْمِكَ ٱلَّذِي جَعَلْتَهُ عِنْدَهُمْ","transliteration":"wa bismika alladhi ja`altahu `indahum","english_text":"in the name of Your Name that You have placed with them","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"وَبِهِ خَصَصْتَهُمْ دُونَ ٱلْعَالَمِينَ","transliteration":"wa bihi khasastahum duna al`alamina","english_text":"and given them exclusively other than all the other beings,","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-039","sequence":39,"arabic_text":"وَبِهِ أَبَنْتَهُمْ","transliteration":"wa bihi abantahum","english_text":"and through which You have distinguished them","source_pair_start":39,"source_pair_end":39,"recitation_segment":{"id":"segment-039","title":"Recitation segment 39","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-040","sequence":40,"arabic_text":"وَأَبَنْتَ فَضْلَهُمْ مِنْ فَضْلِ ٱلْعَالَمِينَ","transliteration":"wa abanta fadlahum min fadli al`alamina","english_text":"and demonstrated their distinctive precedence over all the other beings so uniquely","source_pair_start":40,"source_pair_end":40,"recitation_segment":{"id":"segment-040","title":"Recitation segment 40","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-041","sequence":41,"arabic_text":"حَتَّىٰ فَاقَ فَضْلُهُمْ فَضْلَ ٱلْعَالَمِينَ جَمِيعاً","transliteration":"hatta faqa fadluhum fadla al`alamina jami`an","english_text":"that their preference has exceeded all the distinctive features of all the other beings;","source_pair_start":41,"source_pair_end":41,"recitation_segment":{"id":"segment-041","title":"Recitation segment 41","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-042","sequence":42,"arabic_text":"أَسْأَلُكَ أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ","transliteration":"as'aluka an tusalliya `ala muhammadin wa ali muhammadin","english_text":"I beseech You (in the name of all that) to send blessings upon Muhammad and the Household of Muhammad,","source_pair_start":42,"source_pair_end":42,"recitation_segment":{"id":"segment-042","title":"Recitation segment 42","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-043","sequence":43,"arabic_text":"وَأَنْ تَكْشِفَ عَنِّي غَمِّي","transliteration":"wa an takshifa `anni ghammi","english_text":"to relieve me from my distress,","source_pair_start":43,"source_pair_end":43,"recitation_segment":{"id":"segment-043","title":"Recitation segment 43","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-044","sequence":44,"arabic_text":"وَهَمِّي وَكَرْبِي","transliteration":"wa hammi wa karbi","english_text":"grief, and agony,","source_pair_start":44,"source_pair_end":44,"recitation_segment":{"id":"segment-044","title":"Recitation segment 44","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-045","sequence":45,"arabic_text":"وَتَكْفِيَنِي ٱلْمُهِمَّ مِنْ أُمُورِي","transliteration":"wa takfiyani almuhimma min umuri","english_text":"to make up for me all my distressing affairs,","source_pair_start":45,"source_pair_end":45,"recitation_segment":{"id":"segment-045","title":"Recitation segment 45","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-046","sequence":46,"arabic_text":"وَتَقْضِيَ عَنِّي دَيْنِي","transliteration":"wa taqdiya `anni dayni","english_text":"to help me settle my debts,","source_pair_start":46,"source_pair_end":46,"recitation_segment":{"id":"segment-046","title":"Recitation segment 46","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-047","sequence":47,"arabic_text":"وَتُجِيـرَنِي مِنَ ٱلْفَقْرِ","transliteration":"wa tujirani min alfaqri","english_text":"to safeguard me against poverty,","source_pair_start":47,"source_pair_end":47,"recitation_segment":{"id":"segment-047","title":"Recitation segment 47","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-048","sequence":48,"arabic_text":"وَتُجِيـرَنِي مِنَ ٱلْفَاقَةِ","transliteration":"wa tujirani min alfaqati","english_text":"to safeguard me against scarcity,","source_pair_start":48,"source_pair_end":48,"recitation_segment":{"id":"segment-048","title":"Recitation segment 48","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-049","sequence":49,"arabic_text":"وَتُغْنِيَنِي عَنِ ٱلْمَسْأَلَةِ إِلَىٰ ٱلْمَخْلُوقِينَ","transliteration":"wa tughniyani `an almas'alati ila almakhluqina","english_text":"to make me dispense with begging from the created beings,","source_pair_start":49,"source_pair_end":49,"recitation_segment":{"id":"segment-049","title":"Recitation segment 49","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-050","sequence":50,"arabic_text":"وَتَكْفِيَنِي هَمَّ مَنْ أَخَافُ هَمَّهُ","transliteration":"wa takfiyani hamma man akhafu hammahu","english_text":"to spare me from the distress of what I anticipate to distress me,","source_pair_start":50,"source_pair_end":50,"recitation_segment":{"id":"segment-050","title":"Recitation segment 50","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-051","sequence":51,"arabic_text":"وَعُسْرَ مَنْ أَخَافُ عُسْرَهُ","transliteration":"wa `usra man akhafu `usrahu","english_text":"the difficulty of what I anticipate to be difficult for me,","source_pair_start":51,"source_pair_end":51,"recitation_segment":{"id":"segment-051","title":"Recitation segment 51","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-052","sequence":52,"arabic_text":"وَحُزُونَةَ مَنْ أَخَافُ حُزُونَتَهُ","transliteration":"wa huzunata man akhafu huzunatahu","english_text":"the toughness of what I anticipate to be hard for me (to deal with),","source_pair_start":52,"source_pair_end":52,"recitation_segment":{"id":"segment-052","title":"Recitation segment 52","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-053","sequence":53,"arabic_text":"وَشَرَّ مَنْ أَخَافُ شَرَّهُ","transliteration":"wa sharra man akhafu sharrahu","english_text":"the evil of what I anticipate to be evil,","source_pair_start":53,"source_pair_end":53,"recitation_segment":{"id":"segment-053","title":"Recitation segment 53","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-054","sequence":54,"arabic_text":"وَمَكْرَ مَنْ أَخَافُ مَكْرَهُ","transliteration":"wa makra man akhafu makrahu","english_text":"the conspiracy of whom I anticipate to plot conspiracy (against me),","source_pair_start":54,"source_pair_end":54,"recitation_segment":{"id":"segment-054","title":"Recitation segment 54","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-055","sequence":55,"arabic_text":"وَبَغْيَ مَنْ أَخَافُ بَغْيَهُ","transliteration":"wa baghya man akhafu baghyahu","english_text":"the tyranny of whom I anticipate to treat me tyrannically,","source_pair_start":55,"source_pair_end":55,"recitation_segment":{"id":"segment-055","title":"Recitation segment 55","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-056","sequence":56,"arabic_text":"وَجَوْرَ مَنْ أَخَافُ جَوْرَهُ","transliteration":"wa jawra man akhafu jawrahu","english_text":"the injustice of whom I anticipate to be unjust to me","source_pair_start":56,"source_pair_end":56,"recitation_segment":{"id":"segment-056","title":"Recitation segment 56","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-057","sequence":57,"arabic_text":"وَسُلْطَانَ مَنْ أَخَافُ سُلْطَانَهُ","transliteration":"wa sultana man akhafu sultanahu","english_text":"the domination of whom I anticipate to dominate me,","source_pair_start":57,"source_pair_end":57,"recitation_segment":{"id":"segment-057","title":"Recitation segment 57","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-058","sequence":58,"arabic_text":"وَكَيْدَ مَنْ أَخَافُ كَيْدَهُ","transliteration":"wa kayda man akhafu kaydahu","english_text":"the trickery of whom I anticipate to trick me,","source_pair_start":58,"source_pair_end":58,"recitation_segment":{"id":"segment-058","title":"Recitation segment 58","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-059","sequence":59,"arabic_text":"وَمَقْدُرَةَ مَنْ أَخَافُ مَقْدُرَتَهُ عَلَيَّ","transliteration":"wa maqdurata man akhafu maqduratahu `alayya","english_text":"and the authority of whom I anticipate to seize me,","source_pair_start":59,"source_pair_end":59,"recitation_segment":{"id":"segment-059","title":"Recitation segment 59","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-060","sequence":60,"arabic_text":"وَتَرُدَّ عَنِّي كَيْدَ ٱلْكَيَدَةِ","transliteration":"wa tarudda `anni kayda alkayadati","english_text":"and to ward off from me the trickeries of the deceivers","source_pair_start":60,"source_pair_end":60,"recitation_segment":{"id":"segment-060","title":"Recitation segment 60","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
