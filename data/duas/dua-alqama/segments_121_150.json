[{"id":"passage-121","sequence":121,"arabic_text":"وَٱصْرِفْنِي بِقَضَاءِ حَوَائِجِي","transliteration":"wasrifni biqada'i hawa'iji","english_text":"And make me leave having all my requests granted","source_pair_start":121,"source_pair_end":121,"recitation_segment":{"id":"segment-121","title":"Recitation segment 121","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-122","sequence":122,"arabic_text":"وَكِفَايَةِ مَا أَهَمَّنِي هَمُّهُ","transliteration":"wa kifayati ma ahammani hammahu","english_text":"and having all my distresses relieved,","source_pair_start":122,"source_pair_end":122,"recitation_segment":{"id":"segment-122","title":"Recitation segment 122","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-123","sequence":123,"arabic_text":"مِنْ أَمْرِ آخِرَتِي وَدُنْيَايَ","transliteration":"min amri akhirati wa dunyaya","english_text":"including the affairs of this world and the Hereafter.","source_pair_start":123,"source_pair_end":123,"recitation_segment":{"id":"segment-123","title":"Recitation segment 123","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-124","sequence":124,"arabic_text":"يَا أَمِيرَ ٱلْمُؤْمِنِينَ","transliteration":"ya amira almu'minina","english_text":"O Commander of the Faithful!","source_pair_start":124,"source_pair_end":124,"recitation_segment":{"id":"segment-124","title":"Recitation segment 124","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-125","sequence":125,"arabic_text":"وَيَا أَبَا عَبْدِ ٱللَّهِ","transliteration":"wa ya aba `abdillahi","english_text":"O Abu-`Abdullah!","source_pair_start":125,"source_pair_end":125,"recitation_segment":{"id":"segment-125","title":"Recitation segment 125","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-126","sequence":126,"arabic_text":"عَلَيْكُمَا مِنِّي سَلامُ ٱللَّهِ أَبَداً","transliteration":"`alaykuma minni salamu allahi abadan","english_text":"Peace of Allah be upon you both from me forever","source_pair_start":126,"source_pair_end":126,"recitation_segment":{"id":"segment-126","title":"Recitation segment 126","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-127","sequence":127,"arabic_text":"مَا بَقِيتُ وَبَقِيَ ٱللَّيْلُ وَٱلنَّهَارُ","transliteration":"ma baqitu wa baqiya allaylu walnnaharu","english_text":"as long as I am existent and as long as there are day and night.","source_pair_start":127,"source_pair_end":127,"recitation_segment":{"id":"segment-127","title":"Recitation segment 127","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-128","sequence":128,"arabic_text":"وَلاَ جَعَلَهُ ٱللَّهُ آخِرَ ٱلْعَهْدِ مِنْ زِيَارَتِكُمَا","transliteration":"wa la ja`alahu allahu akhira al`ahdi min ziyaratikuma","english_text":"May Allah not decide this time of my visit to you both to be the last.","source_pair_start":128,"source_pair_end":128,"recitation_segment":{"id":"segment-128","title":"Recitation segment 128","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-129","sequence":129,"arabic_text":"وَلاَ فَرَّقَ ٱللَّهُ بَيْنِي وَبَيْنَكُمَا","transliteration":"wa la farraqa allahu bayni wa baynakuma","english_text":"May Allah never separate me from you both.","source_pair_start":129,"source_pair_end":129,"recitation_segment":{"id":"segment-129","title":"Recitation segment 129","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-130","sequence":130,"arabic_text":"اَللَّهُمَّ أَحْيِنِي حَيَاةَ مُحَمَّدٍ وَذُرِّيَّتِهِ","transliteration":"allahumma ahyini hayata muhammadin wa dhurriyyatihi","english_text":"O Allah, (please) make me live the same lifestyle that Muhammad and his offspring lived,","source_pair_start":130,"source_pair_end":130,"recitation_segment":{"id":"segment-130","title":"Recitation segment 130","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-131","sequence":131,"arabic_text":"وَأَمِتْنِي مَمَاتَهُمْ","transliteration":"wa amitni mamatahum","english_text":"make me die on the same faith on which they died,","source_pair_start":131,"source_pair_end":131,"recitation_segment":{"id":"segment-131","title":"Recitation segment 131","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-132","sequence":132,"arabic_text":"وَتَوَفَّنِي عَلَىٰ مِلَّتِهِمْ","transliteration":"wa tawaffani `ala millatihim","english_text":"receive my soul while I am following their religion,","source_pair_start":132,"source_pair_end":132,"recitation_segment":{"id":"segment-132","title":"Recitation segment 132","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-133","sequence":133,"arabic_text":"وَٱحْشُرْنِي فِي زُمْرَتِهِمْ","transliteration":"wahshurni fi zumratihim","english_text":"include me with their group,","source_pair_start":133,"source_pair_end":133,"recitation_segment":{"id":"segment-133","title":"Recitation segment 133","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-134","sequence":134,"arabic_text":"وَلاَ تُفَرِّقْ بَيْنِي وَبَيْنَهُمْ","transliteration":"wa la tufarriq bayni wa baynahum","english_text":"and never separate me from them","source_pair_start":134,"source_pair_end":134,"recitation_segment":{"id":"segment-134","title":"Recitation segment 134","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-135","sequence":135,"arabic_text":"طَرْفَةَ عَيْنٍ أَبَداً","transliteration":"tarfata `aynin abadan","english_text":"not for even a winking of any eye","source_pair_start":135,"source_pair_end":135,"recitation_segment":{"id":"segment-135","title":"Recitation segment 135","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-136","sequence":136,"arabic_text":"فِي ٱلدُّنْيَا وَٱلآخِرَةِ","transliteration":"fi alddunya wal-akhirati","english_text":"in this world and in the Hereafter.","source_pair_start":136,"source_pair_end":136,"recitation_segment":{"id":"segment-136","title":"Recitation segment 136","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-137","sequence":137,"arabic_text":"يَا أَمِيرَ ٱلْمُؤْمِنِينَ","transliteration":"ya amira almu'minina","english_text":"O Commander of the Faithful!","source_pair_start":137,"source_pair_end":137,"recitation_segment":{"id":"segment-137","title":"Recitation segment 137","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-138","sequence":138,"arabic_text":"وَيَا أَبَا عَبْدِ ٱللَّهِ","transliteration":"wa ya aba `abdillahi","english_text":"O Abu-`Abdullah!","source_pair_start":138,"source_pair_end":138,"recitation_segment":{"id":"segment-138","title":"Recitation segment 138","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-139","sequence":139,"arabic_text":"أَتَيْتُكُمَا زَائِراً","transliteration":"ataytukuma za'iran","english_text":"I have come to you both to visit you,","source_pair_start":139,"source_pair_end":139,"recitation_segment":{"id":"segment-139","title":"Recitation segment 139","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-140","sequence":140,"arabic_text":"وَمُتَوَسِّلاً إِلَىٰ ٱللَّهِ رَبِّي وَرَبِّكُمَا","transliteration":"wa mutawassilan ila allahi rabbi wa rabbikuma","english_text":"making both of you to be my means to Allah your and my Lord,","source_pair_start":140,"source_pair_end":140,"recitation_segment":{"id":"segment-140","title":"Recitation segment 140","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-141","sequence":141,"arabic_text":"وَمُتَوَجِّهاً إِلَيْهِ بِكُمَا","transliteration":"wa mutawajjihan ilayhi bikuma","english_text":"turning my face to Him in your names,","source_pair_start":141,"source_pair_end":141,"recitation_segment":{"id":"segment-141","title":"Recitation segment 141","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-142","sequence":142,"arabic_text":"وَمُسْتَشْفِعاً بِكُمَا إِلَىٰ ٱللَّهِ تَعَالَىٰ فِي حَاجَتِي هٰذِهِ","transliteration":"wa mustashfi`an bikuma ila allahi ta`ala fi hajati hadhihi","english_text":"and seeking your intercession for me with Allah All-exalted to grant me this request of mine;","source_pair_start":142,"source_pair_end":142,"recitation_segment":{"id":"segment-142","title":"Recitation segment 142","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-143","sequence":143,"arabic_text":"فَٱشْفَعَا لِي","transliteration":"fashfa`a li","english_text":"so, intercede for me,","source_pair_start":143,"source_pair_end":143,"recitation_segment":{"id":"segment-143","title":"Recitation segment 143","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-144","sequence":144,"arabic_text":"فَإِنَّ لَكُمَا عِنْدَ ٱللَّهِ ٱلْمَقَامَ ٱلْمَحْمُودَ","transliteration":"fa'inna lakuma `inda allahi almaqama almahmuda","english_text":"since you both enjoy with Allah a praiseworthy position,","source_pair_start":144,"source_pair_end":144,"recitation_segment":{"id":"segment-144","title":"Recitation segment 144","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-145","sequence":145,"arabic_text":"وَٱلْجَاهَ ٱلْوَجِيهَ","transliteration":"waljaha alwajiha","english_text":"an admissible status,","source_pair_start":145,"source_pair_end":145,"recitation_segment":{"id":"segment-145","title":"Recitation segment 145","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-146","sequence":146,"arabic_text":"وَٱلْمَنْزِلَ ٱلرَّفِيعَ وَٱلْوَسِيلَةَ","transliteration":"walmanzila alrrafi`a walwasilata","english_text":"a lofty standing, and a means (of nearness to Him).","source_pair_start":146,"source_pair_end":146,"recitation_segment":{"id":"segment-146","title":"Recitation segment 146","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-147","sequence":147,"arabic_text":"إِنِّي أَنْقَلِبُ عَنْكُمَا","transliteration":"inni anqalibu `ankuma","english_text":"I will now leave you both,","source_pair_start":147,"source_pair_end":147,"recitation_segment":{"id":"segment-147","title":"Recitation segment 147","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-148","sequence":148,"arabic_text":"مُنْتَظِراً لِتَنَجُّزِ ٱلْحَاجَةِ","transliteration":"muntaziran litanajjuzi alhajati","english_text":"expecting my request to be granted,","source_pair_start":148,"source_pair_end":148,"recitation_segment":{"id":"segment-148","title":"Recitation segment 148","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-149","sequence":149,"arabic_text":"وَقَضَائِهَا وَنَجَاحِهَا مِنَ ٱللَّهِ","transliteration":"wa qada'iha wa najahiha min allahi","english_text":"settled, and made successful by Allah","source_pair_start":149,"source_pair_end":149,"recitation_segment":{"id":"segment-149","title":"Recitation segment 149","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-150","sequence":150,"arabic_text":"بِشَفَاعَتِكُمَا لِي إِلَىٰ ٱللَّهِ فِي ذٰلِكَ","transliteration":"bishafa`atikuma li ila allahi fi dhalika","english_text":"on account of your intercession for me with Allah in that;","source_pair_start":150,"source_pair_end":150,"recitation_segment":{"id":"segment-150","title":"Recitation segment 150","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
