e}},{"id":"passage-107","sequence":107,"arabic_text":"فَأَسْأَلُكَ يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ","transliteration":"fa'as'aluka ya allahu ya allahu ya allahu","english_text":"So, I beseech You, O Allah! O Allah! O Allah!","source_pair_start":107,"source_pair_end":107,"recitation_segment":{"id":"segment-107","title":"Recitation segment 107","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-108","sequence":108,"arabic_text":"بِحَقِّ مُحَمَّـدٍ وَآلِ مُحَمَّـدٍ","transliteration":"bihaqqi muhammadin wa ali muhammadin","english_text":"In the name of Muhammad and the Household of Muhammad","source_pair_start":108,"source_pair_end":108,"recitation_segment":{"id":"segment-108","title":"Recitation segment 108","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-109","sequence":109,"arabic_text":"أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ","transliteration":"an tusalliya `ala muhammadin wa ali muhammadin","english_text":"to send blessings upon Muhammad and the Household of Muhammad","source_pair_start":109,"source_pair_end":109,"recitation_segment":{"id":"segment-109","title":"Recitation segment 109","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-110","sequence":110,"arabic_text":"وَأَنْ تَكْشِفَ عَنِّي غَمِّي وَهَمِّي وَكَرْبِي","transliteration":"wa an takshifa `anni ghammi wa hammi wa karbi","english_text":"and to relieve my distress, grief, and agony","source_pair_start":110,"source_pair_end":110,"recitation_segment":{"id":"segment-110","title":"Recitation segment 110","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-111","sequence":111,"arabic_text":"فِي مَقَامِي هٰذَا","transliteration":"fi maqami hadha","english_text":"in this situation of mine","source_pair_start":111,"source_pair_end":111,"recitation_segment":{"id":"segment-111","title":"Recitation segment 111","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-112","sequence":112,"arabic_text":"كَمَا كَشَفْتَ عَنْ نَبِيِّكَ هَمَّهُ وَغَمَّهُ وَكَرْبَهُ","transliteration":"kama kashafta `an nabiyyika hammahu wa ghammahu wa karbahu","english_text":"in the same way as You have relieved the distress, grief, and agony of Your Prophet","source_pair_start":112,"source_pair_end":112,"recitation_segment":{"id":"segment-112","title":"Recitation segment 112","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-113","sequence":113,"arabic_text":"وَكَفَيْتَهُ هَوْلَ عَدُوِّهِ","transliteration":"wa kafaytahu hawla `aduwwihi","english_text":"and saved him from the horrors of his enemy.","source_pair_start":113,"source_pair_end":113,"recitation_segment":{"id":"segment-113","title":"Recitation segment 113","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-114","sequence":114,"arabic_text":"فَٱكْشِفْ عَنِّي كَمَا كَشَفْتَ عَنْهُ","transliteration":"fakshif `anni kama kashafta `anhu","english_text":"So, (please) relieve me in the same way as You did to him,","source_pair_start":114,"source_pair_end":114,"recitation_segment":{"id":"segment-114","title":"Recitation segment 114","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-115","sequence":115,"arabic_text":"وَفَرِّجْ عَنِّي كَمَا فَرَّجْتَ عَنْهُ","transliteration":"wa farrij `anni kama farrajta `anhu","english_text":"dispel my worries in the same way as You did to him,","source_pair_start":115,"source_pair_end":115,"recitation_segment":{"id":"segment-115","title":"Recitation segment 115","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-116","sequence":116,"arabic_text":"وَٱكْفِنِي كَمَا كَفَيْتَهُ","transliteration":"wakfini kama kafaytahu","english_text":"save me in the same way as You did to him,","source_pair_start":116,"source_pair_end":116,"recitation_segment":{"id":"segment-116","title":"Recitation segment 116","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-117","sequence":117,"arabic_text":"وَٱصْرِفْ عَنِّي هَوْلَ مَا أَخَافُ هَوْلَهُ","transliteration":"wasrif `anni hawla ma akhafu hawlahu","english_text":"drive away from me the horror of what I anticipate to horrify me,","source_pair_start":117,"source_pair_end":117,"recitation_segment":{"id":"segment-117","title":"Recitation segment 117","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-118","sequence":118,"arabic_text":"وَمَؤُونَةَ مَا أَخَافُ مَؤُونَتَهُ","transliteration":"wa ma'unata ma akhafu ma'unatahu","english_text":"the encumbrance of what I anticipate to overburden me,","source_pair_start":118,"source_pair_end":118,"recitation_segment":{"id":"segment-118","title":"Recitation segment 118","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-119","sequence":119,"arabic_text":"وَهَمَّ مَا أَخَافُ هَمَّهُ","transliteration":"wa hamma ma akhafu hammahu","english_text":"and the distress of what I anticipate to distress me","source_pair_start":119,"source_pair_end":119,"recitation_segment":{"id":"segment-119","title":"Recitation segment 119","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-120","sequence":120,"arabic_text":"بِلا مَؤُونَةٍ عَلَىٰ نَفْسِي مِنْ ذٰلِكَ","transliteration":"bila ma'unatin `ala nafsi min dhalika","english_text":"without making me suffer any encumbrance due to all that.","source_pair_start":120,"source_pair_end":120,"recitation_segment":{"id":"segment-120","title":"Recitation segment 120","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
