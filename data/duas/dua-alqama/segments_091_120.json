[{"id":"passage-091","sequence":91,"arabic_text":"خَابَ مَنْ كَانَ جَارُهُ سِوَاكَ","transliteration":"khaba man kana jaruhu siwaka","english_text":"Disappointed is he whose shelterer is other than You,","source_pair_start":91,"source_pair_end":91,"recitation_segment":{"id":"segment-091","title":"Recitation segment 91","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-092","sequence":92,"arabic_text":"وَمُغِيثُهُ سِوَاكَ","transliteration":"wa mughithuhu siwaka","english_text":"whose recourse to anywhere other than You,","source_pair_start":92,"source_pair_end":92,"recitation_segment":{"id":"segment-092","title":"Recitation segment 92","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-093","sequence":93,"arabic_text":"وَمَفْزَعُهُ إِلَىٰ سِوَاكَ","transliteration":"wa mafza`uhu ila siwaka","english_text":"whose resort is anywhere other than You,","source_pair_start":93,"source_pair_end":93,"recitation_segment":{"id":"segment-093","title":"Recitation segment 93","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-094","sequence":94,"arabic_text":"وَمَهْرَبُهُ إِلَىٰ سِوَاكَ","transliteration":"wa mahrabuhu ila siwaka","english_text":"whose way out is anywhere other than You,","source_pair_start":94,"source_pair_end":94,"recitation_segment":{"id":"segment-094","title":"Recitation segment 94","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-095","sequence":95,"arabic_text":"وَمَلْجَأُهُ إِلَىٰ غَيْرِكَ","transliteration":"wa malja'uhu ila ghayrika","english_text":"whose haven is anywhere other than You,","source_pair_start":95,"source_pair_end":95,"recitation_segment":{"id":"segment-095","title":"Recitation segment 95","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-096","sequence":96,"arabic_text":"وَمَنْجَاهُ مِنْ مَخْلُوقٍ غَيْرِكَ","transliteration":"wa manjahu min makhluqin ghayrika","english_text":"and whose savior from any created being is anyone other than You.","source_pair_start":96,"source_pair_end":96,"recitation_segment":{"id":"segment-096","title":"Recitation segment 96","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-097","sequence":97,"arabic_text":"فَأَنْتَ ثِقَتِي وَرَجَائِي","transliteration":"fa'anta thiqati wa raja'i","english_text":"You are verily my trust, my hope,","source_pair_start":97,"source_pair_end":97,"recitation_segment":{"id":"segment-097","title":"Recitation segment 97","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-098","sequence":98,"arabic_text":"وَمَفْزَعِي وَمَهْرَبِي","transliteration":"wa mafza`i wa mahrabi","english_text":"my resort, my way out,","source_pair_start":98,"source_pair_end":98,"recitation_segment":{"id":"segment-098","title":"Recitation segment 98","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-099","sequence":99,"arabic_text":"وَمَلْجَإِي وَمَنْجَايَ","transliteration":"wa malja'i wa manjaya","english_text":"my haven, and my savior.","source_pair_start":99,"source_pair_end":99,"recitation_segment":{"id":"segment-099","title":"Recitation segment 99","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-100","sequence":100,"arabic_text":"فَبِكَ أَسْتَفْتِحُ","transliteration":"fabika astaftihu","english_text":"With You do I commence","source_pair_start":100,"source_pair_end":100,"recitation_segment":{"id":"segment-100","title":"Recitation segment 100","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-101","sequence":101,"arabic_text":"وَبِكَ أَسْتَنْجِحُ","transliteration":"wa bika astanjihu","english_text":"and through You do I seek success.","source_pair_start":101,"source_pair_end":101,"recitation_segment":{"id":"segment-101","title":"Recitation segment 101","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-102","sequence":102,"arabic_text":"وَب