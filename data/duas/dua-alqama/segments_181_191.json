[{"id":"passage-181","sequence":181,"arabic_text":"تَائِباً حَامِداً لِلَّهِ","transliteration":"ta'iban hamidan lillahi","english_text":"repenting to and praising Allah,","source_pair_start":181,"source_pair_end":181,"recitation_segment":{"id":"segment-181","title":"Recitation segment 181","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-182","sequence":182,"arabic_text":"شَاكِراً رَاجِياً لِلإِْجَابَةِ","transliteration":"shakiran rajiyan lil-ijabati","english_text":"and thanking Him and hoping Him to respond to me;","source_pair_start":182,"source_pair_end":182,"recitation_segment":{"id":"segment-182","title":"Recitation segment 182","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-183","sequence":183,"arabic_text":"غَيْرَ آيِسٍ وَلاَ قَانِطٍ","transliteration":"ghayra ayisin wa la qanitin","english_text":"I neither despair nor lose hope,","source_pair_start":183,"source_pair_end":183,"recitation_segment":{"id":"segment-183","title":"Recitation segment 183","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-184","sequence":184,"arabic_text":"آئِباً عَائِداً رَاجِعاً إِلَىٰ زِيَارَتِكُمَا","transliteration":"a'iban `a'idan raji`an ila ziyaratikuma","english_text":"and I intend to come back, return, revisit you both,","source_pair_start":184,"source_pair_end":184,"recitation_segment":{"id":"segment-184","title":"Recitation segment 184","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-185","sequence":185,"arabic_text":"غَيْرَ رَاغِبٍ عَنْكُمَا وَلاَ عَنْ زِيَارَتِكُمَا","transliteration":"ghayra raghibin `ankuma wa la `an ziyaratikuma","english_text":"while I have never desired to leave you or to abandon visiting you;","source_pair_start":185,"source_pair_end":185,"recitation_segment":{"id":"segment-185","title":"Recitation segment 185","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-186","sequence":186,"arabic_tex