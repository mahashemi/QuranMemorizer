[{"id":"passage-001","sequence":1,"arabic_text":"يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ","transliteration":"ya allahu ya allahu ya allahu","english_text":"O Allah! O Allah! O Allah!","source_pair_start":1,"source_pair_end":1,"recitation_segment":{"id":"segment-001","title":"Recitation segment 1","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-002","sequence":2,"arabic_text":"يَا مُجِيبَ دَعْوَةِ ٱلْمُضْطَرِّينَ","transliteration":"ya mujiba da`wati almudtarrina","english_text":"O He Who responds to the prayer of the distressed!","source_pair_start":2,"source_pair_end":2,"recitation_segment":{"id":"segment-002","title":"Recitation segment 2","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-003","sequence":3,"arabic_text":"يَا كَاشِفَ كُرَبِ ٱلْمَكْرُوبِينَ","transliteration":"ya kashifa kurabi almakrubina","english_text":"O He Who relieves the agonies of the agonized!","source_pair_start":3,"source_pair_end":3,"recitation_segment":{"id":"segment-003","title":"Recitation segment 3","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-004","sequence":4,"arabic_text":"يَا غِيَاثَ ٱلْمُسْتَغِيثِينَ","transliteration":"ya ghiyatha almustaghithina","english_text":"O Aide of the callers for aid!","source_pair_start":4,"source_pair_end":4,"recitation_segment":{"id":"segment-004","title":"Recitation segment 4","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-005","sequence":5,"arabic_text":"يَا صَرِيخَ ٱلْمُسْتَصْرِخِينَ","transliteration":"ya sarikha almustasrikhina","english_text":"O Helper of those who cry for help!","source_pair_start":5,"source_pair_end":5,"recitation_segment":{"id":"segment-005","title":"Recitation segment 5","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-006","sequence":6,"arabic_text":"وَيَا مَنْ هُوَ أَقْرَبُ إِلَيَّ مِنْ حَبْلِ ٱلْوَرِيدِ","transliteration":"wa ya man huwa aqrabu ilayya min habli alwaridi","english_text":"O He Who is nearer to me than my life-vein!","source_pair_start":6,"source_pair_end":6,"recitation_segment":{"id":"segment-006","title":"Recitation segment 6","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-007","sequence":7,"arabic_text":"وَيَا مَنْ يَحُولُ بَيْنَ ٱلْمَرْءِ وَقَلْبِهِ","transliteration":"wa ya man yahulu bayna almar'i wa qalbihi","english_text":"O He Who intervenes between man and his heart!","source_pair_start":7,"source_pair_end":7,"recitation_segment":{"id":"segment-007","title":"Recitation segment 7","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-008","sequence":8,"arabic_text":"وَيَا مَنْ هُوَ بِٱلْمَنْظَرِ ٱلأَعْلَىٰ وَبِٱلأُفُقِ ٱلْمُبِينِ","transliteration":"wa ya man huwa bilmanzari al-a`la wa bil'ufuqi almubini","english_text":"O He Who is in the Highest Position and in the Clear Horizon!","source_pair_start":8,"source_pair_end":8,"recitation_segment":{"id":"segment-008","title":"Recitation segment 8","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-009","sequence":9,"arabic_text":"وَيَا مَنْ هُوَ ٱلرَّحْمٰنُ ٱلرَّحِيمُ عَلَىٰ ٱلْعَرْشِ ٱسْتَوَىٰ","transliteration":"wa ya man huwa alrrahmanu alrrahimu `ala al`arshi istawa","english_text":"O He Who is all-beneficent and all-merciful and is established on the Throne!","source_pair_start":9,"source_pair_end":9,"recitation_segment":{"id":"segment-009","title":"Recitation segment 9","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-010","sequence":10,"arabic_text":"وَيَا مَنْ يَعْلَمُ خَائِنَةَ ٱلأَعْيُنِ وَمَا تُخْفِي ٱلصُّدُورُ","transliteration":"wa ya man ya`lamu kha'inata al-a`yuni wa ma tukhfi alssuduru","english_text":"O He Who knows the stealthy looks and that which the breasts conceal!","source_pair_start":10,"source_pair_end":10,"recitation_segment":{"id":"segment-010","title":"Recitation segment 10","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-011","sequence":11,"arabic_text":"وَيَا مَنْ لاَ يَخْفَىٰ عَلَيْهِ خَافِيَةٌ","transliteration":"wa ya man la yakhfa `alayhi khafiyatun","english_text":"O He from Whom no secret can remain hidden!","source_pair_start":11,"source_pair_end":11,"recitation_segment":{"id":"segment-011","title":"Recitation segment 11","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-012","sequence":12,"arabic_text":"يَا مَنْ لاَ تَشْتَبِهُ عَلَيْهِ ٱلأَصْوَاتُ","transliteration":"ya man la tashtabihu `alayhi al-aswatu","english_text":"O He Whom is not confused by the many voices (that pray Him)!","source_pair_start":12,"source_pair_end":12,"recitation_segment":{"id":"segment-012","title":"Recitation segment 12","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-013","sequence":13,"arabic_text":"وَيَا مَنْ لاَ تُغَلِّطُهُ ٱلْحَاجَاتُ","transliteration":"wa ya man la tughallituhu alhajatu","english_text":"O He Whom is not confounded by the many requests (that are raised to Him)!","source_pair_start":13,"source_pair_end":13,"recitation_segment":{"id":"segment-013","title":"Recitation segment 13","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-014","sequence":14,"arabic_text":"وَيَا مَنْ لاَ يُبْرِمُهُ إِلْحَاحُ ٱلْمُلِحِّينَ","transliteration":"wa ya man la yubrimuhu ilhahu almulihhina","english_text":"O He Who is not annoyed by the insistence of those who entreat Him persistently!","source_pair_start":14,"source_pair_end":14,"recitation_segment":{"id":"segment-014","title":"Recitation segment 14","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-015","sequence":15,"arabic_text":"يَا مُدْرِكَ كُلِّ فَوْتٍ","transliteration":"ya mudrika kulli fawtin","english_text":"O He Who overtakes every attempt of escape!","source_pair_start":15,"source_pair_end":15,"recitation_segment":{"id":"segment-015","title":"Recitation segment 15","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-016","sequence":16,"arabic_text":"وَيَا جَامِعَ كُلِّ شَمْلٍ","transliteration":"wa ya jami`a kulli shamlin","english_text":"O Reunifier of every scattering thing!","source_pair_start":16,"source_pair_end":16,"recitation_segment":{"id":"segment-016","title":"Recitation segment 16","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-017","sequence":17,"arabic_text":"وَيَا بَارِئَ ٱلنُّفُوسِ بَعْدَ ٱلْمَوْتِ","transliteration":"wa ya bari'a alnnufusi ba`da almawti","english_text":"O Re-originator of the souls after death!","source_pair_start":17,"source_pair_end":17,"recitation_segment":{"id":"segment-017","title":"Recitation segment 17","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-018","sequence":18,"arabic_text":"يَا مَنْ هُوَ كُلِّ يَوْمٍ فِي شَأْنٍ","transliteration":"ya man huwa kulla yawmin fi sha'nin","english_text":"O He Who is in a state every moment!","source_pair_start":18,"source_pair_end":18,"recitation_segment":{"id":"segment-018","title":"Recitation segment 18","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-019","sequence":19,"arabic_text":"يَا قَاضِيَ ٱلْحَاجَاتِ","transliteration":"ya qadiya alhajati","english_text":"O Grantor of requests!","source_pair_start":19,"source_pair_end":19,"recitation_segment":{"id":"segment-019","title":"Recitation segment 19","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-020","sequence":20,"arabic_text":"يَا مُنَفِّسَ ٱلْكُرُبَاتِ","transliteration":"ya munaffisa alkurubati","english_text":"O Reliever of agonies!","source_pair_start":20,"source_pair_end":20,"recitation_segment":{"id":"segment-020","title":"Recitation segment 20","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-021","sequence":21,"arabic_text":"يَا مُعْطِيَ ٱلسُّؤُلاَتِ","transliteration":"ya mu`tiya alssu'ulati","english_text":"O Conferrer of demands!","source_pair_start":21,"source_pair_end":21,"recitation_segment":{"id":"segment-021","title":"Recitation segment 21","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-022","sequence":22,"arabic_text":"يَا وَلِيَّ ٱلرَّغَبَاتِ","transliteration":"ya waliyya alrraghabati","english_text":"O Bestower of desires!","source_pair_start":22,"source_pair_end":22,"recitation_segment":{"id":"segment-022","title":"Recitation segment 22","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-023","sequence":23,"arabic_text":"يَا كَافِيَ ٱلْمُهِمَّاتِ","transliteration":"ya kafiya almuhimmati","english_text":"O Savior from sufferings!","source_pair_start":23,"source_pair_end":23,"recitation_segment":{"id":"segment-023","title":"Recitation segment 23","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-024","sequence":24,"arabic_text":"يَا مَنْ يَكْفِي مِنْ كُلِّ شَيْءٍ","transliteration":"ya man yakfi min kulli shay'in","english_text":"O He Who can save from all things","source_pair_start":24,"source_pair_end":24,"recitation_segment":{"id":"segment-024","title":"Recitation segment 24","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-025","sequence":25,"arabic_text":"وَلاَ يَكْفِي مِنْهُ شَيْءٌ فِي ٱلسَّمَاوَاتِ وَٱلأَرْضِ","transliteration":"wa la yakfi minhu shay'un fi alssamawati wal-ardi","english_text":"and nothing in the heavens or in the earth can save from Him!","source_pair_start":25,"source_pair_end":25,"recitation_segment":{"id":"segment-025","title":"Recitation segment 25","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-026","sequence":26,"arabic_text":"أَسْأَلُكَ بِحَقِّ مُحَمَّدٍ خَاتَمِ ٱلنَّبِيِّينَ","transliteration":"as'aluka bihaqqi muhammadin khatami alnnabiyyina","english_text":"I beseech You in the name of Muhammad the seal of the Prophets,","source_pair_start":26,"source_pair_end":26,"recitation_segment":{"id":"segment-026","title":"Recitation segment 26","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-027","sequence":27,"arabic_text":"وَعَلِيٍّ أَمِيرِ ٱلْمُؤْمِنِينَ","transliteration":"wa `aliyyin amiri almu'minina","english_text":"`Ali the commander of the faithful,","source_pair_start":27,"source_pair_end":27,"recitation_segment":{"id":"segment-027","title":"Recitation segment 27","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-028","sequence":28,"arabic_text":"وَبِحَقِّ فَاطِمَةَ بِنْتِ نَبِيِّكَ","transliteration":"wa bihaqqi fatimata binti nabiyyika","english_text":"Fatimah the daughter of Your Prophet,","source_pair_start":28,"source_pair_end":28,"recitation_segment":{"id":"segment-028","title":"Recitation segment 28","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-029","sequence":29,"arabic_text":"وَبِحَقِّ ٱلْحَسَنِ وَٱلْحُسَيْنِ","transliteration":"wa bihaqqi alhasani walhusayni","english_text":"al-Hasan, and al-Husayn,","source_pair_start":29,"source_pair_end":29,"recitation_segment":{"id":"segment-029","title":"Recitation segment 29","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-030","sequence":30,"arabic_text":"فَإِنِّي بِهِمْ أَتَوَجَّهُ إِلَيْكَ فِي مَقَامِي هٰذَا","transliteration":"fa'inni bihim atawajjahu ilayka fi maqami hadha","english_text":"for I turn my face towards You in their names at this very situation of mine,","source_pair_start":30,"source_pair_end":30,"recitation_segment":{"id":"segment-030","title":"Recitation segment 30","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
