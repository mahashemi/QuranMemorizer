[{"id":"passage-151","sequence":151,"arabic_text":"فَلا أَخِيبُ","transliteration":"fala akhibu","english_text":"so, do not let me down","source_pair_start":151,"source_pair_end":151,"recitation_segment":{"id":"segment-151","title":"Recitation segment 151","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-152","sequence":152,"arabic_text":"وَلاَ يَكونُ مُنْقَلَبِي مُنْقَلَباً خَائِباً خَاسِراً","transliteration":"wa la yakunu munqalabi munqalaban kha'iban khasiran","english_text":"and do not make me leave with disappointment and loss;","source_pair_start":152,"source_pair_end":152,"recitation_segment":{"id":"segment-152","title":"Recitation segment 152","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-153","sequence":153,"arabic_text":"بَلْ يَكُونُ مُنْقَلَبِي مُنْقَلَباً رَاجِحاً","transliteration":"bal yakunu munqalabi munqalaban rajihan","english_text":"rather, make me leave with achievement,","source_pair_start":153,"source_pair_end":153,"recitation_segment":{"id":"segment-153","title":"Recitation segment 153","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-154","sequence":154,"arabic_text":"مُفْلِحاً مُنْجِحاً مُسْتَجَاباً","transliteration":"muflihan munjihan mustajaban","english_text":"prosperity, success, and response (of my prayers)","source_pair_start":154,"source_pair_end":154,"recitation_segment":{"id":"segment-154","title":"Recitation segment 154","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-155","sequence":155,"arabic_text":"بِقَضَاءِ جَمِيعِ حَوَائِجِي","transliteration":"biqada'i jami`i hawa'iji","english_text":"by having all my requests granted.","source_pair_start":155,"source_pair_end":155,"recitation_segment":{"id":"segment-155","title":"Recitation segment 155","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-156","sequence":156,"arabic_text":"وَتَشَفَّعَا لِي إِلَىٰ ٱللَّهِ","transliteration":"wa tashaffa`a li ila allahi","english_text":"And (please) intercede for me with Allah recurrently.","source_pair_start":156,"source_pair_end":156,"recitation_segment":{"id":"segment-156","title":"Recitation segment 156","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-157","sequence":157,"arabic_text":"إِنْقَلَبْتُ عَلَىٰ مَا شَاءَ ٱللَّهُ","transliteration":"inqalabtu `ala ma sha'a allahu","english_text":"I now leave on ‘whatever is willed by Allah shall come to pass’","source_pair_start":157,"source_pair_end":157,"recitation_segment":{"id":"segment-157","title":"Recitation segment 157","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-158","sequence":158,"arabic_text":"وَلا حَوْلَ وَلا قُوَّةَ إِلاَّ بِٱللَّهِ","transliteration":"wa la hawla wa la quwwata illa billahi","english_text":"and ‘there is neither might nor power except with Allah’,","source_pair_start":158,"source_pair_end":158,"recitation_segment":{"id":"segment-158","title":"Recitation segment 158","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-159","sequence":159,"arabic_text":"مُفَوِّضاً أَمْرِي إِلَىٰ ٱللَّهِ","transliteration":"mufawwidan amri ila allahi","english_text":"relegating all my affairs to Allah,","source_pair_start":159,"source_pair_end":159,"recitation_segment":{"id":"segment-159","title":"Recitation segment 159","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-160","sequence":160,"arabic_text":"مُلْجِئاً ظَهْرِي إِلَىٰ ٱللَّهِ","transliteration":"mulji'an zahri ila allahi","english_text":"referring all my power to Allah,","source_pair_start":160,"source_pair_end":160,"recitation_segment":{"id":"segment-160","title":"Recitation segment 160","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-161","sequence":161,"arabic_text":"مُتَوَكِّلاً عَلَىٰ ٱللَّهِ","transliteration":"mutawakklan `ala allahi","english_text":"depending upon Allah,","source_pair_start":161,"source_pair_end":161,"recitation_segment":{"id":"segment-161","title":"Recitation segment 161","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-162","sequence":162,"arabic_text":"وَأَقُولُ حَسْبِيَ ٱللَّهُ وَكَفَىٰ","transliteration":"wa aqulu hasbiya allahu wa kafa","english_text":"and repeating, ‘Allah is only sufficient to me,’","source_pair_start":162,"source_pair_end":162,"recitation_segment":{"id":"segment-162","title":"Recitation segment 162","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-163","sequence":163,"arabic_text":"سَمِعَ ٱللَّهُ لِمَنْ دَعَا","transliteration":"sami`a allahu liman da`a","english_text":"and ‘May Allah respond to him who prays Him.’","source_pair_start":163,"source_pair_end":163,"recitation_segment":{"id":"segment-163","title":"Recitation segment 163","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-164","sequence":164,"arabic_text":"لَيْسَ لِي وَرَاءَ ٱللَّهِ","transliteration":"laysa li wara'a allahi","english_text":"Other than Allah","source_pair_start":164,"source_pair_end":164,"recitation_segment":{"id":"segment-164","title":"Recitation segment 164","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-165","sequence":165,"arabic_text":"وَوَرَاءَكُمْ يَا سَادَتِي مُنْتَهَىٰ","transliteration":"wa wara'akum ya sadati muntaha","english_text":"and other than you all, O my masters, I have nothing to put my hope in.","source_pair_start":165,"source_pair_end":165,"recitation_segment":{"id":"segment-165","title":"Recitation segment 165","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-166","sequence":166,"arabic_text":"مَا شَاءَ رَبِّي كَانَ","transliteration":"ma sha'a rabbi kana","english_text":"Only that which my Lord wills shall come to pass,","source_pair_start":166,"source_pair_end":166,"recitation_segment":{"id":"segment-166","title":"Recitation segment 166","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-167","sequence":167,"arabic_text":"وَمَا لَمْ يَشَأْ لَمْ يَكُنْ","transliteration":"wa ma lam yasha' lam yakun","english_text":"and whatever He does not will shall never be.","source_pair_start":167,"source_pair_end":167,"recitation_segment":{"id":"segment-167","title":"Recitation segment 167","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-168","sequence":168,"arabic_text":"وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِٱللَّهِ","transliteration":"wa la hawla wa la quwwata illa billahi","english_text":"There is neither might nor power except with Allah.","source_pair_start":168,"source_pair_end":168,"recitation_segment":{"id":"segment-168","title":"Recitation segment 168","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-169","sequence":169,"arabic_text":"أَسْتَوْدِعُكُمَا ٱللَّهَ","transliteration":"astawdi`ukuma allaha","english_text":"I entrust you both with Allah.","source_pair_start":169,"source_pair_end":169,"recitation_segment":{"id":"segment-169","title":"Recitation segment 169","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-170","sequence":170,"arabic_text":"وَلا جَعَلَهُ ٱللَّهُ آخِرَ ٱلْعَهْدِ مِنِّي إِلَيْكُمَا","transliteration":"wa la ja`alahu allahu akhira al`ahdi minni ilaykuma","english_text":"May Allah never decide this time of my visit to you both to be the last.","source_pair_start":170,"source_pair_end":170,"recitation_segment":{"id":"segment-170","title":"Recitation segment 170","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-171","sequence":171,"arabic_text":"إِنْصَرَفْتُ يَا سَيِّدِي يَا أَمِيرَ ٱلْمُؤْمِنِينَ وَمَوْلاَي","transliteration":"insaraftu ya sayyidi ya amira almu'minina wa mawlaya","english_text":"May I now leave, O my master, O Commander of the faithful","source_pair_start":171,"source_pair_end":171,"recitation_segment":{"id":"segment-171","title":"Recitation segment 171","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-172","sequence":172,"arabic_text":"وَأَنْتَ يَا أَبَا عَبْدِ ٱللَّهِ يَا سَيِّدِي","transliteration":"wa anta ya aba `abdillahi ya sayyidi","english_text":"and you O Abu-`Abdullah, O my master.","source_pair_start":172,"source_pair_end":172,"recitation_segment":{"id":"segment-172","title":"Recitation segment 172","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-173","sequence":173,"arabic_text":"وَسَلاَمِي عَلَيْكُمَا مُتَّصِلٌ","transliteration":"wa salami `alaykuma muttasilun","english_text":"My greetings to you both are as continuous","source_pair_start":173,"source_pair_end":173,"recitation_segment":{"id":"segment-173","title":"Recitation segment 173","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-174","sequence":174,"arabic_text":"مَا ٱتَّصَلَ ٱللَّيْلُ وَٱلنَّهَارُ","transliteration":"ma ittasala allaylu walnnaharu","english_text":"as night and day.","source_pair_start":174,"source_pair_end":174,"recitation_segment":{"id":"segment-174","title":"Recitation segment 174","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-175","sequence":175,"arabic_text":"وَاصِلٌ ذٰلِكَ إِلَيْكُمَا","transliteration":"wasilun dhalika ilaykuma","english_text":"May my greetings reach you both (all the time)","source_pair_start":175,"source_pair_end":175,"recitation_segment":{"id":"segment-175","title":"Recitation segment 175","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-176","sequence":176,"arabic_text":"غَيْرُ مَحْجُوبٍ عَنْكُمَا سَلاَمِي","transliteration":"ghayru mahjubin `ankuma salami","english_text":"and my salutation never be screened from reaching you both,","source_pair_start":176,"source_pair_end":176,"recitation_segment":{"id":"segment-176","title":"Recitation segment 176","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-177","sequence":177,"arabic_text":"إِنْ شَاءَ ٱللَّهُ","transliteration":"in sha'a allahu","english_text":"Allah willing.","source_pair_start":177,"source_pair_end":177,"recitation_segment":{"id":"segment-177","title":"Recitation segment 177","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-178","sequence":178,"arabic_text":"وَأَسْأَلُهُ بِحَقِّكُمَا أَنْ يَشَاءَ ذٰلِكَ وَيَفْعَلَ","transliteration":"wa as'aluhu bihaqqikuma an yasha'a dhalika wa yaf`ala","english_text":"I also beseech Him in your names to determine and do that,","source_pair_start":178,"source_pair_end":178,"recitation_segment":{"id":"segment-178","title":"Recitation segment 178","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-179","sequence":179,"arabic_text":"فَإِنَّهُ حَمِيدٌ مَجِيدٌ","transliteration":"fa'innahu hamidun majidun","english_text":"for He is verily the owner of praise and the owner of glory.","source_pair_start":179,"source_pair_end":179,"recitation_segment":{"id":"segment-179","title":"Recitation segment 179","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-180","sequence":180,"arabic_text":"إِنْقَلَبْتُ يَا سَيِّدَيَّ عَنْكُمَا","transliteration":"inqalabtu ya sayyidayya `ankuma","english_text":"I am now leaving you both, O my masters,","source_pair_start":180,"source_pair_end":180,"recitation_segment":{"id":"segment-180","title":"Recitation segment 180","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
