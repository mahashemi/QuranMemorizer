[{"id":"passage-061","sequence":61,"arabic_text":"وَمَكْرَ ٱلْمَكَرَةِ","transliteration":"wa makra almakarati","english_text":"and the cunning of the devious.","source_pair_start":61,"source_pair_end":61,"recitation_segment":{"id":"segment-061","title":"Recitation segment 61","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-062","sequence":62,"arabic_text":"اَللَّهُمَّ مَنْ أَرَادَنِي فَأَرِدْهُ","transliteration":"allahumma man aradani fa'arid-hu","english_text":"O Allah, stand for me against him who intends evil for me,","source_pair_start":62,"source_pair_end":62,"recitation_segment":{"id":"segment-062","title":"Recitation segment 62","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-063","sequence":63,"arabic_text":"وَمَنْ كَادَنِي فَكِدْهُ","transliteration":"wa man kadani fakid-hu","english_text":"intrigue against him who intends to conspire against me,","source_pair_start":63,"source_pair_end":63,"recitation_segment":{"id":"segment-063","title":"Recitation segment 63","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-064","sequence":64,"arabic_text":"وَٱصْرِفْ عَنِّي كَيْدَهُ وَمَكْرَهُ","transliteration":"wasrif `anni kaydahu wa makrahu","english_text":"turn away from me his trickeries, cunning,","source_pair_start":64,"source_pair_end":64,"recitation_segment":{"id":"segment-064","title":"Recitation segment 64","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-065","sequence":65,"arabic_text":"وَبَأْسَهُ وَأَمَانِيَّهُ","transliteration":"wa ba'sahu wa amaniyyahu","english_text":"influence, and evil desires,","source_pair_start":65,"source_pair_end":65,"recitation_segment":{"id":"segment-065","title":"Recitation segment 65","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-066","sequence":66,"arabic_text":"وَٱمْنَعْهُ عَنِّي كَيْفَ شِئْتَ وَأَنَّىٰ شِئْتَ","transliteration":"wamna`hu `anni kayfa shi'ta wa anna shi'ta","english_text":"and prevent him against me in any way You choose and at any time You choose.","source_pair_start":66,"source_pair_end":66,"recitation_segment":{"id":"segment-066","title":"Recitation segment 66","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-067","sequence":67,"arabic_text":"اَللَّهُمَّ أَشْغِلْهُ عَنِّي","transliteration":"allahumma ashghalhu `anni","english_text":"O Allah, (please) preoccupy him against me","source_pair_start":67,"source_pair_end":67,"recitation_segment":{"id":"segment-067","title":"Recitation segment 67","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-068","sequence":68,"arabic_text":"بِفَقْرٍ لاَ تَجْبُرُهُ","transliteration":"bifaqrin la tajburuhu","english_text":"by means of poverty that You never cut down,","source_pair_start":68,"source_pair_end":68,"recitation_segment":{"id":"segment-068","title":"Recitation segment 68","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-069","sequence":69,"arabic_text":"وَبِبَلاءٍ لاَ تَسْتُرُهُ","transliteration":"wa bibala'in la tasturuhu","english_text":"ordeals that You never recover,","source_pair_start":69,"source_pair_end":69,"recitation_segment":{"id":"segment-069","title":"Recitation segment 69","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-070","sequence":70,"arabic_text":"وَبِفَاقَةٍ لاَ تَسُدُّهَا","transliteration":"wa bifaqatin la tasudduha","english_text":"neediness that You never stop,","source_pair_start":70,"source_pair_end":70,"recitation_segment":{"id":"segment-070","title":"Recitation segment 70","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-071","sequence":71,"arabic_text":"وَبِسُقْمٍ لاَ تُعَافِيهِ","transliteration":"wa bisuqmin la tu`afihi","english_text":"ailment that You never heal,","source_pair_start":71,"source_pair_end":71,"recitation_segment":{"id":"segment-071","title":"Recitation segment 71","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-072","sequence":72,"arabic_text":"وَذُلٍّ لاَ تُعِزُّهُ","transliteration":"wa dhullin la tu`izzuhu","english_text":"humility that You never change into dignity,","source_pair_start":72,"source_pair_end":72,"recitation_segment":{"id":"segment-072","title":"Recitation segment 72","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-073","sequence":73,"arabic_text":"وَبِمَسْكَنَةٍ لاَ تَجْبُرُهَا","transliteration":"wa bimaskanatin la tajburuha","english_text":"and destitution that You never cut down.","source_pair_start":73,"source_pair_end":73,"recitation_segment":{"id":"segment-073","title":"Recitation segment 73","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-074","sequence":74,"arabic_text":"اَللَّهُمَّ ٱضْرِبْ بِٱلذُّلِّ نَصْبَ عَيْنَيْهِ","transliteration":"allahumma idrib bildhdhulli nasba `aynayhi","english_text":"O Allah, (please) strike him with humility in the center of his eyes,","source_pair_start":74,"source_pair_end":74,"recitation_segment":{"id":"segment-074","title":"Recitation segment 74","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-075","sequence":75,"arabic_text":"وَأَدْخِلْ عَلَيْهِ ٱلْفَقْرَ فِي مَنْزِلِهِ","transliteration":"wa adkhil `alayhi alfaqra fi manzilihi","english_text":"interleave poverty to his own house,","source_pair_start":75,"source_pair_end":75,"recitation_segment":{"id":"segment-075","title":"Recitation segment 75","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-076","sequence":76,"arabic_text":"وَٱلْعِلَّةَ وَٱلسُّقْمَ فِي بَدَنِهِ","transliteration":"wal`illata walssuqma fi badanihi","english_text":"place ailment and disease in his body","source_pair_start":76,"source_pair_end":76,"recitation_segment":{"id":"segment-076","title":"Recitation segment 76","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-077","sequence":77,"arabic_text":"حَتَّىٰ تَشْغَلَهُ عَنِّي بِشُغْلٍ شَاغِلٍ لاَ فَرَاغَ لَهُ","transliteration":"hatta tashghalahu `anni bishughlin shaghilin la faragha lahu","english_text":"so that You will preoccupy him with an engrossing, relentless preoccupation,","source_pair_start":77,"source_pair_end":77,"recitation_segment":{"id":"segment-077","title":"Recitation segment 77","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-078","sequence":78,"arabic_text":"وَأَنْسِهِ ذِكْرِي كَمَا أَنْسَيْتَهُ ذِكْرَكَ","transliteration":"wa ansihi dhikri kama ansaytahu dhikraka","english_text":"make him fail to remember me in the same was as he has failed to remember You,","source_pair_start":78,"source_pair_end":78,"recitation_segment":{"id":"segment-078","title":"Recitation segment 78","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-079","sequence":79,"arabic_text":"وَخُذْ عَنِّي بِسَمْعِهِ وَبَصَرِهِ","transliteration":"wa khudh `anni bisam`ihi wa basarihi","english_text":"divert from me his hearing, sight,","source_pair_start":79,"source_pair_end":79,"recitation_segment":{"id":"segment-079","title":"Recitation segment 79","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-080","sequence":80,"arabic_text":"وَلِسَانِهِ وَيَدِهِ","transliteration":"wa lisanihi wa yadihi","english_text":"tongue, hand,","source_pair_start":80,"source_pair_end":80,"recitation_segment":{"id":"segment-080","title":"Recitation segment 80","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-081","sequence":81,"arabic_text":"وَرِجْلِهِ وَقَلْبِهِ","transliteration":"wa rijlihi wa qalbihi","english_text":"leg, heart,","source_pair_start":81,"source_pair_end":81,"recitation_segment":{"id":"segment-081","title":"Recitation segment 81","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-082","sequence":82,"arabic_text":"وَجَمِيعِ جَوَارِحِهِ","transliteration":"wa jami`i jawarihihi","english_text":"and all of his organs,","source_pair_start":82,"source_pair_end":82,"recitation_segment":{"id":"segment-082","title":"Recitation segment 82","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-083","sequence":83,"arabic_text":"وَأَدْخِلْ عَلَيْهِ فِي جَمِيعِ ذٰلِكَ ٱلسُّقْمَ","transliteration":"wa adkhil `alayhi fi jami`i dhalika alssuqma","english_text":"place in him sickness in all these (organs),","source_pair_start":83,"source_pair_end":83,"recitation_segment":{"id":"segment-083","title":"Recitation segment 83","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-084","sequence":84,"arabic_text":"وَلا تَشْفِهِ حَتَّىٰ تَجْعَلَ ذٰلِكَ لَهُ شُغْلاً شَاغِلاً بِهِ","transliteration":"wa la tashfihi hatta taj`ala dhalika lahu shughlan shaghilan bihi","english_text":"and do not heal him so that all these (sicknesses) will preoccupy him relentlessly","source_pair_start":84,"source_pair_end":84,"recitation_segment":{"id":"segment-084","title":"Recitation segment 84","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-085","sequence":85,"arabic_text":"عَنِّي وَعَنْ ذِكْرِي","transliteration":"`anni wa `an dhikri","english_text":"from me and from mentioning me.","source_pair_start":85,"source_pair_end":85,"recitation_segment":{"id":"segment-085","title":"Recitation segment 85","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-086","sequence":86,"arabic_text":"وَٱكْفِنِي يَا كَافِي مَا لاَ يَكْفِي سِوَاكَ","transliteration":"wakfini ya kafi ma la yakfi siwaka","english_text":"And spare me, O Savior, from all that which cannot be spared by anyone other than You,","source_pair_start":86,"source_pair_end":86,"recitation_segment":{"id":"segment-086","title":"Recitation segment 86","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-087","sequence":87,"arabic_text":"فَإِنَّكَ ٱلْكَافِي لاَ كَافِيَ سِوَاكَ","transliteration":"fa'innaka alkafi la kafiya siwaka","english_text":"for You are verily the Savior; and there is no savior other than You,","source_pair_start":87,"source_pair_end":87,"recitation_segment":{"id":"segment-087","title":"Recitation segment 87","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-088","sequence":88,"arabic_text":"وَمُفَرِّجٌ لاَ مُفَرِّجَ سِوَاكَ","transliteration":"wa mufarrijun la mufarrija siwaka","english_text":"You are verily the Reliever, and there is no reliever other than You,","source_pair_start":88,"source_pair_end":88,"recitation_segment":{"id":"segment-088","title":"Recitation segment 88","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-089","sequence":89,"arabic_text":"وَمُغِيثٌ لاَ مُغِيثَ سِوَاكَ","transliteration":"wa mughithun la mughitha siwaka","english_text":"You are verily the Succorer, and there is no succorer other than You,","source_pair_start":89,"source_pair_end":89,"recitation_segment":{"id":"segment-089","title":"Recitation segment 89","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-090","sequence":90,"arabic_text":"وَجَارٌ لاَ جَارَ سِوَاكَ","transliteration":"wa jarun la jara siwaka","english_text":"and You are verily the Shelterer, and there is no shelterer other than You.","source_pair_start":90,"source_pair_end":90,"recitation_segment":{"id":"segment-090","title":"Recitation segment 90","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
