[{"id":"passage-001","sequence":1,"arabic_text":"اللَّهُمَّ رَبَّ النُّورِ الْعَظِيمِ","transliteration":"allāhumma rabba alnūri al`aẓīmi","english_text":"O Allah the Lord of the Great Light,","source_pair_start":1,"source_pair_end":1,"recitation_segment":{"id":"segment-001","title":"Recitation segment 1","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-002","sequence":2,"arabic_text":"وَرَبَّ الْكُرْسِيِّ الرَّفِيعِ","transliteration":"wa rabba alkursiyyi alrrafī`i","english_text":"the Lord of the Elevated Throne,","source_pair_start":2,"source_pair_end":2,"recitation_segment":{"id":"segment-002","title":"Recitation segment 2","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-003","sequence":3,"arabic_text":"وَرَبَّ الْبَحْرِ الْمَسْجُورِ","transliteration":"wa rabba albaḥri almasjūri","english_text":"the Lord of the swollen ocean,","source_pair_start":3,"source_pair_end":3,"recitation_segment":{"id":"segment-003","title":"Recitation segment 3","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-004","sequence":4,"arabic_text":"وَمُنْزِلَ التَّوْرَاةِ وَالْإِنْجِيلِ وَالزَّبُورِ","transliteration":"wa munzila alttawrāti wal-injīli wallzzabūri","english_text":"the Revealer of the Torah, the Gospel, and the Psalms,","source_pair_start":4,"source_pair_end":4,"recitation_segment":{"id":"segment-004","title":"Recitation segment 4","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-005","sequence":5,"arabic_text":"وَرَبَّ الظِّلِّ وَالْحَرُورِ","transliteration":"wa rabba alẓẓilli walḥarūri","english_text":"the Lord of shade and heat,","source_pair_start":5,"source_pair_end":5,"recitation_segment":{"id":"segment-005","title":"Recitation segment 5","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-006","sequence":6,"arabic_text":"وَمُنْزِلَ الْقُرْآنِ الْعَظِيمِ","transliteration":"wa munzila alqur'āni al`aẓīmi","english_text":"the Revealer of the Great Qur'an,","source_pair_start":6,"source_pair_end":6,"recitation_segment":{"id":"segment-006","title":"Recitation segment 6","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-007","sequence":7,"arabic_text":"وَرَبَّ الْمَلَائِكَةِ الْمُقَرَّبِينَ","transliteration":"wa rabba almalā'ikati almuqarrabīna","english_text":"and the Lord of the Archangels,","source_pair_start":7,"source_pair_end":7,"recitation_segment":{"id":"segment-007","title":"Recitation segment 7","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-008","sequence":8,"arabic_text":"وَالْأَنْبِيَاءِ وَالْمُرْسَلِينَ","transliteration":"wal-anbiyā'i walmursalīna","english_text":"the Prophets, and the Messengers:","source_pair_start":8,"source_pair_end":8,"recitation_segment":{"id":"segment-008","title":"Recitation segment 8","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-009","sequence":9,"arabic_text":"اللَّهُمَّ إِنِّي أَسْأَلُكَ بِاسْمِكَ الْكَرِيمِ","transliteration":"allāhumma innī as'aluka bismika alkarīmi","english_text":"O Allah, I beseech You in Your Noble Name,","source_pair_start":9,"source_pair_end":9,"recitation_segment":{"id":"segment-009","title":"Recitation segment 9","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-010","sequence":10,"arabic_text":"وَبِنُورِ وَجْهِكَ الْمُنِيرِ","transliteration":"wa binūri wajhika almunīri","english_text":"in the Light of Your Luminous Face","source_pair_start":10,"source_pair_end":10,"recitation_segment":{"id":"segment-010","title":"Recitation segment 10","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-011","sequence":11,"arabic_text":"وَمُلْكِكَ الْقَدِيمِ","transliteration":"wa mulkika alqadīmi","english_text":"and Your Eternal Kingdom.","source_pair_start":11,"source_pair_end":11,"recitation_segment":{"id":"segment-011","title":"Recitation segment 11","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-012","sequence":12,"arabic_text":"يَا حَيُّ يَا قَيُّومُ","transliteration":"yā ḥayyu yā qayyūmu","english_text":"O Ever-living! O Self-Subsistent!","source_pair_start":12,"source_pair_end":12,"recitation_segment":{"id":"segment-012","title":"Recitation segment 12","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-013","sequence":13,"arabic_text":"أَسْأَلُكَ بِاسْمِكَ الَّذِي أَشْرَقَتْ بِهِ السَّمَاوَاتُ وَالْأَرَضُونَ","transliteration":"as'aluka bismika alladhī ashraqat bihī alssamāwātu wal-araḍūna","english_text":"I beseech You in the name of Your Name with which the heavens and the earth have lit up","source_pair_start":13,"source_pair_end":13,"recitation_segment":{"id":"segment-013","title":"Recitation segment 13","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-014","sequence":14,"arabic_text":"وَبِاسْمِكَ الَّذِي يَصْلُحُ بِهِ الْأَوَّلُونَ وَالْآخِرُونَ","transliteration":"wa bismika alladhī yaṣluḥu bihī al-awwalūna wal-ākhirūna","english_text":"and in Your Name with which the past and the coming generations have become upright!","source_pair_start":14,"source_pair_end":14,"recitation_segment":{"id":"segment-014","title":"Recitation segment 14","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-015","sequence":15,"arabic_text":"يَا حَيًّا قَبْلَ كُلِّ حَيٍّ","transliteration":"yā ḥayyan qabla kulli ḥayyin","english_text":"O He Who has been always alive before the existence of all living things!","source_pair_start":15,"source_pair_end":15,"recitation_segment":{"id":"segment-015","title":"Recitation segment 15","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-016","sequence":16,"arabic_text":"وَيَا حَيًّا بَعْدَ كُلِّ حَيٍّ","transliteration":"wa yā ḥayyan ba`da kulli ḥayyin","english_text":"O He Who shall be alive after the extinction of all living things!","source_pair_start":16,"source_pair_end":16,"recitation_segment":{"id":"segment-016","title":"Recitation segment 16","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-017","sequence":17,"arabic_text":"وَيَا حَيًّا حِينَ لَا حَيَّ","transliteration":"wa yā ḥayyan ḥīna lā ḥayyu","english_text":"O He Who has been always alive even when there was nothing else alive!","source_pair_start":17,"source_pair_end":17,"recitation_segment":{"id":"segment-017","title":"Recitation segment 17","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-018","sequence":18,"arabic_text":"يَا مُحْيِيَ الْمَوْتَى وَمُمِيتَ الْأَحْيَاءِ","transliteration":"yā muḥyiya almawtā wa mumīta al-aḥyā'i","english_text":"O He Who revives the dead ones and causes the living ones to die!","source_pair_start":18,"source_pair_end":18,"recitation_segment":{"id":"segment-018","title":"Recitation segment 18","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-019","sequence":19,"arabic_text":"يَا حَيُّ لَا إِلَهَ إِلَّا أَنْتَ","transliteration":"yā ḥayyu lā ilāha illā anta","english_text":"O Ever-living! There is no god save You.","source_pair_start":19,"source_pair_end":19,"recitation_segment":{"id":"segment-019","title":"Recitation segment 19","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-020","sequence":20,"arabic_text":"اللَّهُمَّ بَلِّغْ مَوْلَانَا الْإِمَامَ الْهَادِيَ الْمَهْدِيَّ الْقَائِمَ بِأَمْرِكَ","transliteration":"allāhumma balligh mawlānā al-imāma alhādiya almahdiyya alqā'ima bi'amrika","english_text":"O Allah, convey to our master Imam al-Mahdi, the guide who is to undertake Your orders,","source_pair_start":20,"source_pair_end":20,"recitation_segment":{"id":"segment-020","title":"Recitation segment 20","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-021","sequence":21,"arabic_text":"صَلَوَاتُ اللَّهِ عَلَيْهِ وَعَلَى آبَائِهِ الطَّاهِرِينَ","transliteration":"ṣalawātu allāhi `alayhi wa `alā abā'ihi alṭṭāhirīna","english_text":"may Allah’s blessings be upon him and upon his immaculate fathers,","source_pair_start":21,"source_pair_end":21,"recitation_segment":{"id":"segment-021","title":"Recitation segment 21","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-022","sequence":22,"arabic_text":"عَنْ جَمِيعِ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ","transliteration":"`an jamī`i almu'minīna walm u'mināti","english_text":"on behalf of all of the believing men and women","source_pair_start":22,"source_pair_end":22,"recitation_segment":{"id":"segment-022","title":"Recitation segment 22","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-023","sequence":23,"arabic_text":"فِي مَشَارِقِ الْأَرْضِ وَمَغَارِبِهَا","transliteration":"fī mashāriqi al-arḍi wa maghāribihā","english_text":"in the east and west of the earth","source_pair_start":23,"source_pair_end":23,"recitation_segment":{"id":"segment-023","title":"Recitation segment 23","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-024","sequence":24,"arabic_text":"سَهْلِهَا وَجِبَالِهَا","transliteration":"sahlihā wa jabalihā","english_text":"and in plains, mountains,","source_pair_start":24,"source_pair_end":24,"recitation_segment":{"id":"segment-024","title":"Recitation segment 24","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-025","sequence":25,"arabic_text":"وَبَرِّهَا وَبَحْرِهَا","transliteration":"wa barrihā wa baḥrihā","english_text":"lands, and seas,","source_pair_start":25,"source_pair_end":25,"recitation_segment":{"id":"segment-025","title":"Recitation segment 25","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-026","sequence":26,"arabic_text":"وَعَنِّي وَعَنْ وَالِدَيَّ","transliteration":"wa `annī wa `an wālidayya","english_text":"and on behalf of my parents","source_pair_start":26,"source_pair_end":26,"recitation_segment":{"id":"segment-026","title":"Recitation segment 26","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-027","sequence":27,"arabic_text":"مِنَ الصَّلَوَاتِ زِنَةَ عَرْشِ اللَّهِ","transliteration":"min alṣṣalawati zinata `arshi allāhi","english_text":"(convey to him) blessings that are as weighty as Allah’s Throne,","source_pair_start":27,"source_pair_end":27,"recitation_segment":{"id":"segment-027","title":"Recitation segment 27","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-028","sequence":28,"arabic_text":"وَمِدَادَ كَلِمَاتِهِ","transliteration":"wa midāda kalimātihi","english_text":"as much as the ink of His Words,","source_pair_start":28,"source_pair_end":28,"recitation_segment":{"id":"segment-028","title":"Recitation segment 28","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-029","sequence":29,"arabic_text":"وَمَا أَحْصَاهُ عِلْمُهُ وَأَحَاطَ بِهِ كِتَابُهُ","transliteration":"wa mā aḥṣāhu `ilmuhu wa aḥāṭa bihi kitābuhu","english_text":"and as many as that which is counted by His knowledge and encompassed by His Book.","source_pair_start":29,"source_pair_end":29,"recitation_segment":{"id":"segment-029","title":"Recitation segment 29","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-030","sequence":30,"arabic_text":"اللَّهُمَّ إِنِّي أُجَدِّدُ لَهُ فِي صَبِيحَةِ يَوْمِي هَذَا","transliteration":"allāhumma innī ujaddidu lahū fī ṣabīḥati yawmī hādhā","english_text":"O Allah, I update to him in the beginning of this day","source_pair_start":30,"source_pair_end":30,"recitation_segment":{"id":"segment-030","title":"Recitation segment 30","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
