[{"id":"passage-061","sequence":61,"arabic_text":"وَابْنَ بِنْتِ نَبِيِّكَ","transliteration":"wabna binti nabiyyika","english_text":"the son of Your Prophet,","source_pair_start":61,"source_pair_end":61,"recitation_segment":{"id":"segment-061","title":"Recitation segment 61","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-062","sequence":62,"arabic_text":"الْمُسَمَّى بِاسْمِ رَسُولِكَ","transliteration":"almusammā bismi rasūlika","english_text":"and the namesake of Your Messenger,","source_pair_start":62,"source_pair_end":62,"recitation_segment":{"id":"segment-062","title":"Recitation segment 62","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-063","sequence":63,"arabic_text":"صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ","transliteration":"ṣallā allāhu `alayhi wa ālihī","english_text":"peace be upon him and his Household,","source_pair_start":63,"source_pair_end":63,"recitation_segment":{"id":"segment-063","title":"Recitation segment 63","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-064","sequence":64,"arabic_text":"حَتَّى لَا يَظْفَرَ بِشَيْءٍ مِنَ الْبَاطِلِ إِلَّا مَزَّقَهُ","transliteration":"ḥattā lā yazfara bishay'in min albāṭili illā mazzaqahū","english_text":"so that he shall tear up any wrong item that he will face","source_pair_start":64,"source_pair_end":64,"recitation_segment":{"id":"segment-064","title":"Recitation segment 64","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-065","sequence":65,"arabic_text":"وَيُحِقَّ الْحَقَّ وَيُحَقِّقَهُ","transliteration":"wa yuḥaqqiqa alḥaqqa wa yuḥaqqiqahū","english_text":"and shall confirm and approve of the truth.","source_pair_start":65,"source_pair_end":65,"recitation_segment":{"id":"segment-065","title":"Recitation segment 65","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-066","sequence":66,"arabic_text":"وَاجْعَلْهُ اللَّهُمَّ مَفْزَعًا لِمَظْلُومِ عِبَادِكَ","transliteration":"waj`alhu allāhumma mafza`an limazlūmi `ibādika","english_text":"O Allah, (please) make him the shelter to whom Your wronged servants shall resort,","source_pair_start":66,"source_pair_end":66,"recitation_segment":{"id":"segment-066","title":"Recitation segment 66","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-067","sequence":67,"arabic_text":"وَنَاصِرًا لِمَنْ لَا يَجِدُ لَهُ نَاصِرًا غَيْرَكَ","transliteration":"wa nāṣiran liman lā yajidu lahū nāṣiran ghayraka","english_text":"the supporter of those who cannot find any supporter save You,","source_pair_start":67,"source_pair_end":67,"recitation_segment":{"id":"segment-067","title":"Recitation segment 67","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-068","sequence":68,"arabic_text":"وَمُجَدِّدًا لِمَا عُطِّلَ مِنْ أَحْكَامِ كِتَابِكَ","transliteration":"wa mujaddidan limā `uṭṭila min aḥkāmi kitābika","english_text":"the reviver of the laws of Your Book that have been suspended,","source_pair_start":68,"source_pair_end":68,"recitation_segment":{"id":"segment-068","title":"Recitation segment 68","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-069","sequence":69,"arabic_text":"وَمُشَيِّدًا لِمَا وَرَدَ مِنْ أَعْلَامِ دِينِكَ وَسُنَنِ نَبِيِّكَ","transliteration":"wa mushayyidan limā warada min a`lāmi dīnika wa sunani nabiyyika","english_text":"and the constructor of all signs of Your religion and instructions of Your Messenger,","source_pair_start":69,"source_pair_end":69,"recitation_segment":{"id":"segment-069","title":"Recitation segment 69","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-070","sequence":70,"arabic_text":"صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ","transliteration":"ṣallā allāhu `alayhi wa ālihī","english_text":"peace be upon him and his Household.","source_pair_start":70,"source_pair_end":70,"recitation_segment":{"id":"segment-070","title":"Recitation segment 70","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-071","sequence":71,"arabic_text":"وَاجْعَلْهُ اللَّهُمَّ مِمَّنْ حَصَّنْتَهُ مِنْ بَأْسِ الْمُعْتَدِينَ","transliteration":"waj`alhu allāhumma mimman ḥaṣṣantahū min ba'si almu`tadīna","english_text":"O Allah, (please) include him with those whom You protect from the domination of the aggressors.","source_pair_start":71,"source_pair_end":71,"recitation_segment":{"id":"segment-071","title":"Recitation segment 71","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-072","sequence":72,"arabic_text":"اللَّهُمَّ وَسُرَّ نَبِيَّكَ مُحَمَّدًا","transliteration":"allāhumma wa surra nabiyyaka muḥammadan","english_text":"O Allah, (please) delight Your Prophet Muḥammad,","source_pair_start":72,"source_pair_end":72,"recitation_segment":{"id":"segment-072","title":"Recitation segment 72","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-073","sequence":73,"arabic_text":"صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ","transliteration":"ṣallā allāhu `alayhi wa ālihī","english_text":"peace be upon him and his Household,","source_pair_start":73,"source_pair_end":73,"recitation_segment":{"id":"segment-073","title":"Recitation segment 73","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-074","sequence":74,"arabic_text":"بِرُؤْيَتِهِ وَمَنْ تَبِعَهُ عَلَى دَعْوَتِهِ","transliteration":"biru'yatihī wa man tabi`ahū `alā da`watihī","english_text":"as well as all those who followed him in his promulgation by making (us) see him,","source_pair_start":74,"source_pair_end":74,"recitation_segment":{"id":"segment-074","title":"Recitation segment 74","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-075","sequence":75,"arabic_text":"وَارْحَمْ اسْتِكَانَتَنَا بَعْدَهُ","transliteration":"warham istikānatana ba`dahū","english_text":"and (please) have mercy upon our humiliation after him.","source_pair_start":75,"source_pair_end":75,"recitation_segment":{"id":"segment-075","title":"Recitation segment 75","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-076","sequence":76,"arabic_text":"اللَّهُمَّ اكْشِفْ هَذِهِ الْغُمَّةَ عَنْ هَذِهِ الْأُمَّةِ بِحُضُورِهِ","transliteration":"allāhumma ikshif hādhihi alghummata `an hādhihi al-ummati biḥuḍūrihī","english_text":"O Allah, (please) relieve this community from the (current) grief through presenting him","source_pair_start":76,"source_pair_end":76,"recitation_segment":{"id":"segment-076","title":"Recitation segment 76","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-077","sequence":77,"arabic_text":"وَعَجِّلْ لَنَا ظُهُورَهُ","transliteration":"wa `ajjil lanā ẓuhūrahū","english_text":"and expedite his advent for us:","source_pair_start":77,"source_pair_end":77,"recitation_segment":{"id":"segment-077","title":"Recitation segment 77","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-078","sequence":78,"arabic_text":"إِنَّهُمْ يَرَوْنَهُ بَعِيدًا وَنَرَاهُ قَرِيبًا","transliteration":"innahum yarawnahū ba`īdan wa narāhu qarīban","english_text":"“Surely, they think it to be far off, and We see it nigh.”","source_pair_start":78,"source_pair_end":78,"recitation_segment":{"id":"segment-078","title":"Recitation segment 78","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-079","sequence":79,"arabic_text":"بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِينَ","transliteration":"birahmatika yā arḥama alrrāḥimīna","english_text":"[do all that] In the name of Your mercy; O most merciful of all those who show mercy.","source_pair_start":79,"source_pair_end":79,"recitation_segment":{"id":"segment-079","title":"Recitation segment 79","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-080","sequence":80,"arabic_text":"الْعَجَلَ الْعَجَلَ يَا مَوْلَايَ يَا صَاحِبَ الزَّمَانِ","transliteration":"al`ajala al`ajala yā mawlāya yā ṣāḥiba alzzamāni","english_text":"(We pray for Your) earliest advent, earliest advent, O Patron of the Age.","source_pair_start":80,"source_pair_end":80,"recitation_segment":{"id":"segment-080","title":"Recitation segment 80","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
