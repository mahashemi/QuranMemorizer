[{"id":"passage-031","sequence":31,"arabic_text":"وَمَا عِشْتُ مِنْ أَيَّامِي","transliteration":"wa mā `ishtu min ayyāmī","english_text":"and throughout the days of lifetime a pledge,","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"عَهْدًا وَعَقْدًا وَبَيْعَةً لَهُ فِي عُنُقِي","transliteration":"`ahdan wa `aqdan wa bay`atan lahū fī `unuqī","english_text":"a covenant, and allegiance to which I commit myself","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"لَا أَحُولُ عَنْهُ وَلَا أَزُولُ أَبَدًا","transliteration":"lā aḥūlu `anhu wa lā azūlu abadan","english_text":"and from which I neither convert nor change.","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"اللَّهُمَّ اجْعَلْنِي مِنْ أَنْصَارِهِ","transliteration":"allāhumma ij`alnī min anṣārihī","english_text":"O Allah, (please do) make me of his supporters,","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"وَأَعْوَانِهِ وَالذَّابِّينَ عَنْهُ","transliteration":"wa a`wānihi waldhābbīna `anhu","english_text":"sponsors, defenders,","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"وَالْمُسَارِعِينَ إِلَيْهِ فِي قَضَاءِ حَوَائِجِهِ","transliteration":"walmusāri`īna ilayhi fī qaḍā'i ḥawā'ijihī","english_text":"and those who hurry in carrying out his instructions,","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"وَالْمُمْتَثِلِينَ لِأَوَامِرِهِ","transliteration":"walmumtathilīna li'awāmirihī","english_text":"those who comply with his orders,","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"وَالْمُحَامِينَ عَنْهُ","transliteration":"walmuḥāmīna `anhu","english_text":"those who uphold him,","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-039","sequence":39,"arabic_text":"وَالسَّابِقِينَ إِلَى إِرَادَتِهِ","transliteration":"walsābiqīna ilā irādatihī","english_text":"those who precede others to implementing his will,","source_pair_start":39,"source_pair_end":39,"recitation_segment":{"id":"segment-039","title":"Recitation segment 39","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-040","sequence":40,"arabic_text":"وَالْمُسْتَشْهَدِينَ بَيْنَ يَدَيْهِ","transliteration":"walmustashhadīna bayna yadayhi","english_text":"and those who will be martyred before him.","source_pair_start":40,"source_pair_end":40,"recitation_segment":{"id":"segment-040","title":"Recitation segment 40","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-041","sequence":41,"arabic_text":"اللَّهُمَّ إِنْ حَالَ بَيْنِي وَبَيْنَهُ الْمَوْتُ الَّذِي جَعَلْتَهُ عَلَى عِبَادِكَ حَتْمًا مَقْضِيًّا","transliteration":"allāhumma in ḥāla baynī wa baynahū almawtu alladhī ja`altahū `alā `ibādika ḥatman maqḍiyyan","english_text":"O Allah, if death that You have made inevitably and certainly incumbent upon Your servants stands between me and him,","source_pair_start":41,"source_pair_end":41,"recitation_segment":{"id":"segment-041","title":"Recitation segment 41","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-042","sequence":42,"arabic_text":"فَأَخْرِجْنِي مِنْ قَبْرِي مُؤْتَزِرًا كَفَنِي","transliteration":"fa'akh rijnī min qabrī mu'taziran kafanī","english_text":"then (please) take me out of my grave using my shroud as dress,","source_pair_start":42,"source_pair_end":42,"recitation_segment":{"id":"segment-042","title":"Recitation segment 42","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-043","sequence":43,"arabic_text":"شَاهِرًا سَيْفِي","transliteration":"shāhiran sayfī","english_text":"unsheathing my sword,","source_pair_start":43,"source_pair_end":43,"recitation_segment":{"id":"segment-043","title":"Recitation segment 43","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-044","sequence":44,"arabic_text":"مُجَرِّدًا قَنَاتِي","transliteration":"mujarridan qanātī","english_text":"holding my lance in my hand,","source_pair_start":44,"source_pair_end":44,"recitation_segment":{"id":"segment-044","title":"Recitation segment 44","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-045","sequence":45,"arabic_text":"مُلَبِّيًا دَعْوَةَ الدَّاعِي فِي الْحَاضِرِ وَالْبَادِي","transliteration":"mulabbiyan da`wata alddā`ī fīlḥāḍiri walbādī","english_text":"and responding to the call of the Caller who shall announce (his advent) in urban areas and deserts.","source_pair_start":45,"source_pair_end":45,"recitation_segment":{"id":"segment-045","title":"Recitation segment 45","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-046","sequence":46,"arabic_text":"اللَّهُمَّ أَرِنِي الطَّلْعَةَ الرَّشِيدَةَ","transliteration":"allāhumma arinī alṭṭal`ata alrrashīdata","english_text":"O Allah, (please do) show me his magnificent mien","source_pair_start":46,"source_pair_end":46,"recitation_segment":{"id":"segment-046","title":"Recitation segment 46","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-047","sequence":47,"arabic_text":"وَالْغُرَّةَ الْحَمِيدَةَ","transliteration":"walghurrata alḥamīdata","english_text":"and his praiseworthy forehead,","source_pair_start":47,"source_pair_end":47,"recitation_segment":{"id":"segment-047","title":"Recitation segment 47","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-048","sequence":48,"arabic_text":"وَاكْحُلْ نَاظِرِي بِنَظْرَةٍ مِنِّي إِلَيْهِ","transliteration":"wakḥul nāẓirī binaẓratin minnī ilayhi","english_text":"delight my eyes by letting me have a look at him.","source_pair_start":48,"source_pair_end":48,"recitation_segment":{"id":"segment-048","title":"Recitation segment 48","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-049","sequence":49,"arabic_text":"وَعَجِّلْ فَرَجَهُ","transliteration":"wa `ajjil farajahū","english_text":"And (please) expedite his relief,","source_pair_start":49,"source_pair_end":49,"recitation_segment":{"id":"segment-049","title":"Recitation segment 49","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-050","sequence":50,"arabic_text":"وَسَهِّلْ مَخْرَجَهُ","transliteration":"wa sahhil makhrajahū","english_text":"make his reappearance easy,","source_pair_start":50,"source_pair_end":50,"recitation_segment":{"id":"segment-050","title":"Recitation segment 50","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-051","sequence":51,"arabic_text":"وَأَوْسِعْ مَنْهَجَهُ","transliteration":"wa awsi` manhajahū","english_text":"clear a spacious space for him,","source_pair_start":51,"source_pair_end":51,"recitation_segment":{"id":"segment-051","title":"Recitation segment 51","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-052","sequence":52,"arabic_text":"وَاسْلُكْ بِي مَحَجَّتَهُ","transliteration":"wasluk bī muḥajjatahū","english_text":"guide me to follow his course,","source_pair_start":52,"source_pair_end":52,"recitation_segment":{"id":"segment-052","title":"Recitation segment 52","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-053","sequence":53,"arabic_text":"وَأَنْفِذْ أَمْرَهُ","transliteration":"wa anfidh amrahū","english_text":"give success to his issues,","source_pair_start":53,"source_pair_end":53,"recitation_segment":{"id":"segment-053","title":"Recitation segment 53","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-054","sequence":54,"arabic_text":"وَاشْدُدْ أَزْرَهُ","transliteration":"wash dud azrahū","english_text":"and confirm his strength.","source_pair_start":54,"source_pair_end":54,"recitation_segment":{"id":"segment-054","title":"Recitation segment 54","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-055","sequence":55,"arabic_text":"وَاعْمُرِ اللَّهُمَّ بِهِ بِلَادَكَ","transliteration":"wa`mur allāhumma bihī bilādaka","english_text":"O Allah, construct Your lands through him","source_pair_start":55,"source_pair_end":55,"recitation_segment":{"id":"segment-055","title":"Recitation segment 55","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-056","sequence":56,"arabic_text":"وَأَحْيِ بِهِ عِبَادَكَ","transliteration":"wa aḥyi bihī `ibādaka","english_text":"and refresh Your servants through him,","source_pair_start":56,"source_pair_end":56,"recitation_segment":{"id":"segment-056","title":"Recitation segment 56","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-057","sequence":57,"arabic_text":"فَإِنَّكَ قُلْتَ وَقَوْلُكَ الْحَقُّ","transliteration":"fa'innaka qulta wa qawluka alḥaqqu","english_text":"For You have said, and true are Your words:","source_pair_start":57,"source_pair_end":57,"recitation_segment":{"id":"segment-057","title":"Recitation segment 57","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-058","sequence":58,"arabic_text":"ظَهَرَ الْفَسَادُ فِي الْبَرِّ وَالْبَحْرِ","transliteration":"zahara alfasādu filbarri walbaḥri","english_text":"“Corruption has appeared in the land and the sea","source_pair_start":58,"source_pair_end":58,"recitation_segment":{"id":"segment-058","title":"Recitation segment 58","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-059","sequence":59,"arabic_text":"بِمَا كَسَبَتْ أَيْدِي النَّاسِ","transliteration":"bimā kasabat aydi alnnāsi","english_text":"on account of what the hands of men have wrought.”","source_pair_start":59,"source_pair_end":59,"recitation_segment":{"id":"segment-059","title":"Recitation segment 59","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-060","sequence":60,"arabic_text":"فَأَظْهِرِ اللَّهُمَّ لَنَا وَلِيَّكَ","transliteration":"fa'azhir allāhumma lanā waliyyaka","english_text":"So, O Allah, (please) show us Your vicegerent,","source_pair_start":60,"source_pair_end":60,"recitation_segment":{"id":"segment-060","title":"Recitation segment 60","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
