[{"id":"passage-031","sequence":31,"arabic_text":"وَلا تُصَيِّرَنِي لِلْفِتَنِ غَرَضاً،","transliteration":"wa laa tus'ay-yir-nee lil-fitani gharaz''aa","english_text":"and not to turn me into a target for trials!","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"وَكُنْ لِي عَلَىٰ الأَعْداءِ ناصِراً،","transliteration":"wa kul-lee a'laal-aa'-daaa-i naas'iraa","english_text":"Be for me a helper against enemies,","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"وَعَلَىٰ الْمَخازِي وَالْعُيُوبِ ساتِراً،","transliteration":"wa a'laal-makhaazee wal-u'yoobi saatiraa","english_text":"a coverer of shameful things and faults,","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"وَمِنَ الْبَلاءِ واقِياً،","transliteration":"wa minal-balaa’ee waaqeean","english_text":"a protector against afflictions,","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"وَعَنِ الْمَعاصِي عاصِماً،","transliteration":"waa'nil-maa'as'ee a'as'iman","english_text":"a preserver against acts of disobedience!","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"بِرَأْفَتِكَ وَرَحْمَتِكَ يا أَرْحَمَ الرَّاحِمِينَ. ","tr