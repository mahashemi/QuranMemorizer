[{"id":"passage-001","sequence":1,"arabic_text":"إِلـٰهِي إلَيْكَ أَشْكُو نَفْساً بِالسُّوءِ أَمَّارَةً،","transliteration":"ilaaheee ilay-ka ash-koo naf-sana bis-sooo-i am-maarah","english_text":"My God, to You I complain of a soul commanding to evil,","source_pair_start":1,"source_pair_end":1,"recitation_segment":{"id":"segment-001","title":"Recitation segment 1","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-002","sequence":2,"arabic_text":"وَإلَىٰ الْخَطيئَةِ مُبادِرَةً،","transliteration":"wa ilaal-khat'ee-ati mubaadirah","english_text":"rushing to offenses,","source_pair_start":2,"source_pair_end":2,"recitation_segment":{"id":"segment-002","title":"Recitation segment 2","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-003","sequence":3,"arabic_text":"وَبِمَعاصِيكَ مُولَعَةً،","transliteration":"wa bimaa'as'eeka moolaa'h","english_text":"eager to disobey You,","source_pair_start":3,"source_pair_end":3,"recitation_segment":{"id":"segment-003","title":"Recitation segment 3","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-004","sequence":4,"arabic_text":"وَلِسَخَطِكَ مُتَعَرِّضَةً،","transliteration":"wa lisakhat'ika mutaa'r-riz''atan","english_text":"and exposing itself to Your anger.","source_pair_start":4,"source_pair_end":4,"recitation_segment":{"id":"segment-004","title":"Recitation segment 4","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-005","sequence":5,"arabic_text":"تَسْلُكُ بِي مَسالِكَ الْمَهالِكِ،","transliteration":"tas-luka bee masaalikal-mahaalik","english_text":"It takes me on the roads of disasters,","source_pair_start":5,"source_pair_end":5,"recitation_segment":{"id":"segment-005","title":"Recitation segment 5","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-006","sequence":6,"arabic_text":"وَتَجْعَلُنِي عِنْدَكَ أَهْوَنَ هَالِكٍ،","transliteration":"wa taj-a'lunee i'ndaka ah-wana haalik","english_text":"it makes me the easiest of perishers before You;","source_pair_start":6,"source_pair_end":6,"recitation_segment":{"id":"segment-006","title":"Recitation segment 6","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-007","sequence":7,"arabic_text":"كَثِيرَةَ الْعِلَلِ طَوِيلَةَ الأَمَلِ،","transliteration":"kathyratal-i'lal, t'awylatal-amal","english_text":"many its pretexts, drawn out its expectations;","source_pair_start":7,"source_pair_end":7,"recitation_segment":{"id":"segment-007","title":"Recitation segment 7","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-008","sequence":8,"arabic_text":"إنْ مَسَّهَا الشَّرُّ تَجْزَعُ،","transliteration":"im-mas-sahaash-shar-ru taj-zau'","english_text":"when evil touches it, it is anxious,","source_pair_start":8,"source_pair_end":8,"recitation_segment":{"id":"segment-008","title":"Recitation segment 8","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-009","sequence":9,"arabic_text":"وَإنْ مَسَّهَا الْخَيْرُ تَمْنَعُ،","transliteration":"wa im-mas-sahaal-khay-ru tam-nau'","english_text":"when good touches it, grudging;","source_pair_start":9,"source_pair_end":9,"recitation_segment":{"id":"segment-009","title":"Recitation segment 9","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-010","sequence":10,"arabic_text":"مَيَّالَةً إلَىٰ اللَّعِبِ وَاللَّهْوِ،","transliteration":"may-yaalatan ilaal-lai'bi wal-laah-wi","english_text":"inclining to play and diversion,","source_pair_start":10,"source_pair_end":10,"recitation_segment":{"id":"segment-010","title":"Recitation segment 10","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-011","sequence":11,"arabic_text":"مَمْلُوَّةً بِالْغَفْلَةِ وَالسَّهْوِ،","transliteration":"mam-looo-atam-bil-ghaf-lati was-sah-wi","english_text":"full of heedlessness and inattention,","source_pair_start":11,"source_pair_end":11,"recitation_segment":{"id":"segment-011","title":"Recitation segment 11","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-012","sequence":12,"arabic_text":"تُسْرِعُ بِي إلَىٰ الْحَوْبَةِ،","transliteration":"tus-riu' beee ilaal-h'aw-bah","english_text":"it hurries me to misdeeds","source_pair_start":12,"source_pair_end":12,"recitation_segment":{"id":"segment-012","title":"Recitation segment 12","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-013","sequence":13,"arabic_text":"وَتُسَوِّفُنِي بِالتَّوْبَةِ. ","transliteration":"wa tusaw-wifunee bit-taw-bah","english_text":"and makes me delay repentance.","source_pair_start":13,"source_pair_end":13,"recitation_segment":{"id":"segment-013","title":"Recitation segment 13","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-014","sequence":14,"arabic_text":"إِلـٰهِي أَشْكُو إلَيْكَ عَدُوّاً يُضِلُّنِي","transliteration":"ilaaheee ash-kooo ilay-k a'doo-way-yuz''il-lunee","english_text":"My God, I complain to You of an enemy who misguides me","source_pair_start":14,"source_pair_end":14,"recitation_segment":{"id":"segment-014","title":"Recitation segment 14","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-015","sequence":15,"arabic_text":"وَشَيْطانَاً يَغْوِينِي،","transliteration":"wa shay-t'aanay-yugh-weenee","english_text":"and a satan who leads me astray.","source_pair_start":15,"source_pair_end":15,"recitation_segment":{"id":"segment-015","title":"Recitation segment 15","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-016","sequence":16,"arabic_text":"قَدْ مَلأَ بِالْوَسْواسِ صَدْرِي،","transliteration":"qad malaa bil-was-waasi s'ad-ree","english_text":"He has filled my breast with tempting thoughts,","source_pair_start":16,"source_pair_end":16,"recitation_segment":{"id":"segment-016","title":"Recitation segment 16","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-017","sequence":17,"arabic_text":"وَأَحاطَتْ هَواجِسُهُ بِقَلْبِي،","transliteration":"wa ah'aat'at hawaajisuhoo biqal-bee","english_text":"and his suggestions have encompassed my heart.","source_pair_start":17,"source_pair_end":17,"recitation_segment":{"id":"segment-017","title":"Recitation segment 17","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-018","sequence":18,"arabic_text":"يُعاضِدُ لِيَ الْهَوىٰ،","transliteration":"yua'az''idu leeal-hawaa","english_text":"He supports caprice against me,","source_pair_start":18,"source_pair_end":18,"recitation_segment":{"id":"segment-018","title":"Recitation segment 18","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-019","sequence":19,"arabic_text":"وَيُزَيِّنُ لِي حُبَّ الدُّنْيا،","transliteration":"wa yuzay-yinu lee h'ub-bad-dunyaa","english_text":"embellishes for me the love of this world,","source_pair_start":19,"source_pair_end":19,"recitation_segment":{"id":"segment-019","title":"Recitation segment 19","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-020","sequence":20,"arabic_text":"وَيَحُولُ بَيْنِي وَبَيْنَ الطَّاعَةِ وَالزُّلْفىٰ. ","transliteration":"wa yah'oolu bay-nee wa bay-nat'-t'aaa'ti waz-zul-faa","english_text":"and separates me from obedience and proximity!","source_pair_start":20,"source_pair_end":20,"recitation_segment":{"id":"segment-020","title":"Recitation segment 20","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-021","sequence":21,"arabic_text":"إِلـٰهِي إلَيْكَ أَشْكُو قَلْباً قاسِياً","transliteration":"ilaaheee ilay-ka ash-koo qal-bana qaaseea","english_text":"My God, to You I complain of a heart that is hard,","source_pair_start":21,"source_pair_end":21,"recitation_segment":{"id":"segment-021","title":"Recitation segment 21","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-022","sequence":22,"arabic_text":"مَعَ الْوَسْواسِ مُتَقَلِّباً،","transliteration":"maa'l-was-waasi mutaqal-liban","english_text":"turned this way and that by tempting thoughts,","source_pair_start":22,"source_pair_end":22,"recitation_segment":{"id":"segment-022","title":"Recitation segment 22","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-023","sequence":23,"arabic_text":"وَبِالرَّيْنِ وَالطَّبْعِ مُتَلَبِّساً،","transliteration":"w-wa bir-ray-ni wat'-t'ab-i' mutalab-bisaa","english_text":"clothed in rust and the seal,","source_pair_start":23,"source_pair_end":23,"recitation_segment":{"id":"segment-023","title":"Recitation segment 23","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-024","sequence":24,"arabic_text":"وَعَيْناً عَنِ الْبُكاءِ مِنْ خَوْفِكَ جامِدَةً،","transliteration":"wa a'y-nana a'nil-bukaaa-i min khaw-fika jaamidatan","english_text":"and of an eye too indifferent to weep in fear of You","source_pair_start":24,"source_pair_end":24,"recitation_segment":{"id":"segment-024","title":"Recitation segment 24","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-025","sequence":25,"arabic_text":"وَإلَىٰ ما تَسُرُّها طامِحَةً. ","transliteration":"w-wa ilaa maa tasur-ruhaa t'aamih'ah","english_text":"and eagerly seeking that which gladdens it!","source_pair_start":25,"source_pair_end":25,"recitation_segment":{"id":"segment-025","title":"Recitation segment 25","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-026","sequence":26,"arabic_text":"إِلـٰهِي لا حَوْلَ وَلا قُوَّةَ إلاَّ بِقُدْرَتِكَ،","transliteration":"ilaahee laa h'aw-la wa laa qoo-wata il-laa biqud-ratik","english_text":"My God, there is no force and no strength except in Your power,","source_pair_start":26,"source_pair_end":26,"recitation_segment":{"id":"segment-026","title":"Recitation segment 26","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-027","sequence":27,"arabic_text":"وَلا نَجاةَ لِي مِنْ مَكارِهِ الدُّنْيا إلاَّ بِعِصْمَتِكَ،","transliteration":"wa laa najaata lee mim-makaarihid-dunyaaa il-laa bii's'-matik","english_text":"and no deliverance for me from the detested things of this world save through Your preservation.","source_pair_start":27,"source_pair_end":27,"recitation_segment":{"id":"segment-027","title":"Recitation segment 27","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-028","sequence":28,"arabic_text":"فَأَسْأَلُكَ بِبَلاغَةِ حِكْمَتِكَ،","transliteration":"faas-aluka bibalaaghati h'ik-matika","english_text":"So I ask You by Your far-reaching wisdom","source_pair_start":28,"source_pair_end":28,"recitation_segment":{"id":"segment-028","title":"Recitation segment 28","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-029","sequence":29,"arabic_text":"وَنَفاذِ مَشِيَّتِكَ،","transliteration":"wa nafaad'i mashee-yatika","english_text":"and Your penetrating will","source_pair_start":29,"source_pair_end":29,"recitation_segment":{"id":"segment-029","title":"Recitation segment 29","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-030","sequence":30,"arabic_text":"أَنْ لا تَجْعَلَنِي لِغَيْرِ جُودِكَ مُتَعَرِّضاً،","transliteration":"an-laa taj-a'l-nee lighay-ri joodika mutaa'r-riz''aa","english_text":"not to let me expose myself to other than Your munificence","source_pair_start":30,"source_pair_end":30,"recitation_segment":{"id":"segment-030","title":"Recitation segment 30","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
