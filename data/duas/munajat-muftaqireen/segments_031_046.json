[{"id":"passage-031","sequence":31,"arabic_text":"وَيا أَكْرَمَ الأَكْرَمِينَ،","transliteration":"wa yaaa ak-ramal-ak-rameen","english_text":"O Most Generous of the most generous!","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"وَيا أَرْحَمَ الرَّاحِمِينَ،","transliteration":"wa yaaa ar-h'amar-raah'imeen","english_text":"O Most Merciful of the merciful!","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"لَكَ تَخَضُّعِي وَسُؤَالِي،","transliteration":"laka takhaz''-z''ue'e wa soo-aalee","english_text":"To You is my humble subjection and request,","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"وَإلَيْكَ تَضَرُّعِي وَابْتِهالِي،","transliteration":"wa ilay-ka taz''ar-rue'e wa ab-tihaalee","english_text":"to You my pleading and imploring!","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"أَسْأَلُكَ أَنْ تُنِيلَنِي مِنْ رَوْحِ رِضْوانِكَ،","transliteration":"as-aluka an tuneelanee mir-raw-hee riz''-waanik","english_text":"I ask You to let me attain the repose of Your good pleasure,","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"وَتُدِيمَ عَلَيَّ نِعَمَ امْتِنانِكَ،","transliteration":"wa tudeema a'lay-ya nia'ma im-tinaanik","english_text":"and to make constant toward me the favours of Your kindness!","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"وَها أَنا بِبابِ كَرَمِكَ واقِفٌ،","transliteration":"wahaaa ana bibaabi karamika waaqif","english_text":"Here am I, standing before the gate of Your generosity,","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"وَلِنَفَحاتِ بِرِّكَ مُتَعَرِّضٌ،","transliteration":"wa linafah'aati bir-rika mutaa'r-riz''","english_text":"opening myself up to the breezes of Your goodness,","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-039","sequence":39,"arabic_text":"وَبِحَبْلِكَ الشَّدِيدِ مُعْتَصِمٌ،","transliteration":"wa bih'ab-likash-shadeedi mua'-tas'im","english_text":"holding fast to Your strong cord,","source_pair_start":39,"source_pair_end":39,"recitation_segment":{"id":"segment-039","title":"Recitation segment 39","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-040","sequence":40,"arabic_text":"وَبِعُرْوَتِكَ الْوُثْقىٰ مُتَمَسِّكٌ،","transliteration":"wa biu'r-watikal-wuth-qaa mutamas-sik","english_text":"clinging to Your firm handle!","source_pair_start":40,"source_pair_end":40,"recitation_segment":{"id":"segment-040","title":"Recitation segment 40","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-041","sequence":41,"arabic_text":"إِلـٰهِي ارْحَمْ عَبْدَكَ الذَّلِيلَ،","transliteration":"ilaaheer-h'am a'b-dakad'-d'aleel","english_text":"My God, have mercy upon Your lowly slave","source_pair_start":41,"source_pair_end":41,"recitation_segment":{"id":"segment-041","title":"Recitation segment 41","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-042","sequence":42,"arabic_text":"ذَا اللِّسانِ الْكَليلِ وَالْعَمَلِ الْقَلِيلِ،","transliteration":"d'aal-lisaanil-kaleeli wal-a'malil-qaleel","english_text":"of silent tongue and few good works,","source_pair_start":42,"source_pair_end":42,"recitation_segment":{"id":"segment-042","title":"Recitation segment 42","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-043","sequence":43,"arabic_text":"وَامْنُنْ عَلَيْهِ بِطَوْلِكَ الْجَزِيلِ،","transliteration":"wa am-nun a'lay-hee bit'aw-likal-jazeel","english_text":"bestow Your favours upon him through Your plentiful graciousness,","source_pair_start":43,"source_pair_end":43,"recitation_segment":{"id":"segment-043","title":"Recitation segment 43","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-044","sequence":44,"arabic_text":"وَاكْنُفْهُ تَحْتَ ظِلِّكَ الظَّلِيلِ،","transliteration":"wa ak-nuf-hoo tah'-ta z'il-likaz'-z'aleel","english_text":"shelter him under Your plenteous shade!","source_pair_start":44,"source_pair_end":44,"recitation_segment":{"id":"segment-044","title":"Recitation segment 44","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-045","sequence":45,"arabic_text":"يا كَرِيمُ يا جَمِيلُ،","transliteration":"yaa kareemu yaa jameel","english_text":"O Generous, O Beautiful,","source_pair_start":45,"source_pair_end":45,"recitation_segment":{"id":"segment-045","title":"Recitation segment 45","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-046","sequence":46,"arabic_text":"يا أَرْحَمَ الرَّاحِمِينَ.","transliteration":"yaaa ar-h'amar-raah'imeen","english_text":"O Most Merciful of the merciful!","source_pair_start":46,"source_pair_end":46,"recitation_segment":{"id":"segment-046","title":"Recitation segment 46","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
