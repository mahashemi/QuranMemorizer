[{"id":"passage-031","sequence":31,"arabic_text":"وَقُلْتَ وَقَوْلُكَ الْحَقُّ،","transliteration":"wa qul-ta wa qaw-lukal-h'aq","english_text":"You have said - and Your word is true -","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"فَاذْكُرُونِي أَذْكُرْكُمْ،","transliteration":"fad'-kuroonee ad'-kurkum","english_text":"Remember Me, and I will remember you!","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"فَأَمَرْتَنا بِذِكْرِكَ،","transliteration":"faamartanaa bid'ik-rik","english_text":"You have commanded us to remember You,","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"وَوَعَدْتَنا عَلَيْهِ أَنْ تَذْكُرَنا تَشْرِيفاً لَنا وَتَفْخِيماً وَإِعْظاماً،","transliteration":"wa waaa'-adtanaa a'lay-hee an tad'-kuranaa tash-reefan lana wa taf-kheeman wa ia'z'aamaa","english_text":"and promised us that You would remember us thereby, to honour, respect, and magnify us,","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"وَها نَحْنُ ذاكِرُوكَ كَما أَمَرْتَنا،","transliteration":"wa haaa nah'-nu d'aakirooka kamaa amartanaa","english_text":"here we are, remembering You as You have commanded us!","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"فَأَنْجِزْ لَنا ما وَعَدْتَنا،","transliteration":"fa an-jiz lana ma waaa'-adtanaa","english_text":"So accomplish what You have promised us,","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"يا ذاكِرَ الذَّاكِرِينَ،","transliteration":"yaa d'aakiral-d'aakireen","english_text":"O Rememberer of the rememberers!","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"وَيا أَرْحَمَ الرَّاحِمِينَ.","transliteration":"wa yaaa ar-h'amar-raah'imeen","english_text":"O Most Merciful of the merciful!","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
