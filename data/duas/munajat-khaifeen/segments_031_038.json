[{"id":"passage-031","sequence":31,"arabic_text":"يا جَبَّارُ يا قَهَّارُ،","transliteration":"yaa jab-baaru yaa qah-haaru","english_text":"O Compeller, O Subduer!","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"يا غَفَّارُ يا سَتَّارُ،","transliteration":"yaa ghaf-faaru yaa sat-taaru","english_text":"O All-forgiver, O All-covering!","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"نَجّـِنِي بِرَحْمَتِكَ مِنْ عَذابِ النَّارِ،","transliteration":"naj-jinee birah'-matika min a'd'aabin-naari","english_text":"Deliver me through Your mercy from the chastisement of the Fire","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"وَفَضِيحَةِ الْعارِ،","transliteration":"wa faz''eeh'atil-a'ari","english_text":"and the disgrace of shame","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"إذَا امْتازَ الأَخْيارُ مِنَ الأَشْرارِ،","transliteration":"id'aa im-taazal-akh-yaaru minal-ash-raar","english_text":"when the good are set apart from the evil,","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"وَحالَتِ الأَحْوالُ، وَهالَتِ الأَهْوالُ،","transliteration":"wa h'aalatil-ah'-waal wa haalatil-ah-waal","english_text":"forms are transformed, terrors terrify,","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"وَقَرُبَ الْمُحْسِنُونَ، وَبَعُدَ الْمُسِيئُونَ،","transliteration":"wa qarubal-muh'-sinoon wa bau'dal-musee-oon","english_text":"the good-doers are brought near, the evildoers taken far,","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"وَوُفّـِيَتْ كُلُّ نَفْسٍ ما كَسَبَتْ وَهُمْ لا يُظْلَمُونَ.","transliteration":"wa wuf-feeat kul-lu naf-sim-maa kasabat wa hum laa yuz'-lamoon","english_text":"and every soul is paid in full what it has earned, and they shall not be wronged.","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
