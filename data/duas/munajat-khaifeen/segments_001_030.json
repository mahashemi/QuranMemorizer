[{"id":"passage-001","sequence":1,"arabic_text":"إِلـٰهِي أَتَرَاكَ بَعْدَ الإِيْمانِ بِكَ تُعَذّ ِبُنِي،","transliteration":"ilaaheee aturaak baa'-dal-eemaani bika tua'd'-d'ibunee","english_text":"My God, what thinkest You? Will You chastise me after my faith in You?","source_pair_start":1,"source_pair_end":1,"recitation_segment":{"id":"segment-001","title":"Recitation segment 1","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-002","sequence":2,"arabic_text":"أَمْ بَعْدَ حُبّـِي إيَّاكَ تُبَعّـِدُنِي،","transliteration":"am baa'-da h'ub-beee ee-yaaka tubaa'-i'dunee","english_text":"Drive me far away after my love for You?","source_pair_start":2,"source_pair_end":2,"recitation_segment":{"id":"segment-002","title":"Recitation segment 2","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-003","sequence":3,"arabic_text":"أَمْ مَعَ رَجائِي بِرَحْمَتِكَ وَصَفْحِكَ تَحْرِمُنِي،","transliteration":"am maa' rajaaa-ee birah'-matika wa s'af-h'ika t ah'-rimunee","english_text":"Deprive me while I hope for Your mercy and forgiveness?","source_pair_start":3,"source_pair_end":3,"recitation_segment":{"id":"segment-003","title":"Recitation segment 3","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-004","sequence":4,"arabic_text":"أَمْ مَعَ اسْتِجارَتِي بِعَفْوِكَ تُسْلِمُنِي؟","transliteration":"am maa' as-tijaaratee bia'f-wika tus-limunee","english_text":"Forsake me while I seek sanctuary in Your pardon?","source_pair_start":4,"source_pair_end":4,"recitation_segment":{"id":"segment-004","title":"Recitation segment 4","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-005","sequence":5,"arabic_text":"حَاشَا لِوَجْهِكَ الْكَرِيمِ أَنْ تُخَيّـِبَنِي،","transliteration":"h'aashaa liwaj-hikal-kareemi an tukhay-yibanee","english_text":"How could Your generous face disappoint me?!","source_pair_start":5,"source_pair_end":5,"recitation_segment":{"id":"segment-005","title":"Recitation segment 5","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-006","sequence":6,"arabic_text":"لَيْتَ شِعْرِي،","transliteration":"lay-ta shia'-ree","english_text":"I wish that I know -","source_pair_start":6,"source_pair_end":6,"recitation_segment":{"id":"segment-006","title":"Recitation segment 6","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-007","sequence":7,"arabic_text":"أَلِلشَّقاءِ وَلَدَتْنِي أُمّـِي،","transliteration":"alilsh-shaqaaa-i waladat-neee um-mee","english_text":"Did my mother bear me for wretchedness?","source_pair_start":7,"source_pair_end":7,"recitation_segment":{"id":"segment-007","title":"Recitation segment 7","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-008","sequence":8,"arabic_text":"أَمْ لِلْعَناءِ رَبَّتْنِي؟","transliteration":"am lil-a'naaa-i rab-bat-nee","english_text":"Did she nurture me for suffering?","source_pair_start":8,"source_pair_end":8,"recitation_segment":{"id":"segment-008","title":"Recitation segment 8","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-009","sequence":9,"arabic_text":"فَلَيْتَهَا لَمْ تَلِدْنِي وَلَمْ تُرَبّـِنِي،","transliteration":"falay-tahaa lam talid-nee wa lam turab-binee","english_text":"If such, then I wish that she had not borne me and had not nurtured me!","source_pair_start":9,"source_pair_end":9,"recitation_segment":{"id":"segment-009","title":"Recitation segment 9","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-010","sequence":10,"arabic_text":"وَلَيْتَنِي عَلِمْتُ،","transliteration":"wa lay-tanee a'lim-tu","english_text":"I wish that I had knowledge -","source_pair_start":10,"source_pair_end":10,"recitation_segment":{"id":"segment-010","title":"Recitation segment 10","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-011","sequence":11,"arabic_text":"أَمِنْ أَهْلِ السَّعادَةِ جَعَلْتَنِي؟","transliteration":"amin ah-lis-saa'dati jaa'l-tanee","english_text":"Have You appointed me one of the people of felicity?","source_pair_start":11,"source_pair_end":11,"recitation_segment":{"id":"segment-011","title":"Recitation segment 11","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-012","sequence":12,"arabic_text":"وَبِقُرْبِكَ وَجَوارِكَ خَصَصْتَنِي؟","transliteration":"wa biqur-bika wa jiwaarika khas'as'-tanee","english_text":"Have You singled me out for Your nearness and neighbourhood?","source_pair_start":12,"source_pair_end":12,"recitation_segment":{"id":"segment-012","title":"Recitation segment 12","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-013","sequence":13,"arabic_text":"فَتَقَرَّ بِذالِكَ عَيْنِي، وَتَطْمَئِنَّ لَهُ نَفْسِي. ","transliteration":"fataqar-ra bid'alika a'y-nee wa tat'-ma-in-na lahoo naf-see","english_text":"Then would my eyes be gladdened, and in that my soul reach serenity.","source_pair_start":13,"source_pair_end":13,"recitation_segment":{"id":"segment-013","title":"Recitation segment 13","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-014","sequence":14,"arabic_text":"إِلـٰهِي هَلْ تُسَوّ ِدُ وُجُوهاً خَرَّتْ ساجِدَةً لِعَظَمَتِكَ؟","transliteration":"Ilaahee hal tusaw-widu wujoohana khar-rat saajidatal-lia'z'amatik","english_text":"My God, do You blacken faces which fall down in prostration before Your mightiness?","source_pair_start":14,"source_pair_end":14,"recitation_segment":{"id":"segment-014","title":"Recitation segment 14","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-015","sequence":15,"arabic_text":"أَوْ تُخْرِسُ أَلْسِنَةً نَطَقَتْ بِالثَّناءِ عَلَىٰ مَجْدِكَ وَجَلالَتِكَ؟","transliteration":"aw tukh-risu al-sinatan-nat'aqat bith-thanaaa-i a'laa maj-dika wa jalaalatik","english_text":"Do You strike dumb tongues which speak in laudation of Your glory and majesty?","source_pair_start":15,"source_pair_end":15,"recitation_segment":{"id":"segment-015","title":"Recitation segment 15","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-016","sequence":16,"arabic_text":"أَوْ تَطْبَعُ عَلَىٰ قُلُوبٍ انْطَوَتْ عَلىٰ مَحَبَّتِكَ؟","transliteration":"aw tat'-bau' a'laa quloobin ant'awat a'laa mah'ab-batika","english_text":"Do You seal hearts which harbour Your love?","source_pair_start":16,"source_pair_end":16,"recitation_segment":{"id":"segment-016","title":"Recitation segment 16","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-017","sequence":17,"arabic_text":"أَوْ تُصِمُّ أَسْماعاً تَلَذَّذَتْ بِسَماعِ ذِكْرِكَ فِي إرادَتِكَ؟","transliteration":"aw tus'im-mu as-maaa'n talad'-d'ad'at bisamaai' d'ik-rika feee iraadatik","english_text":"Do You deafen ears which take pleasure in hearing Your remembrance according to Your will?","source_pair_start":17,"source_pair_end":17,"recitation_segment":{"id":"segment-017","title":"Recitation segment 17","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-018","sequence":18,"arabic_text":"أَوْ تَغُلُّ أَكُفّاً رَفَعَتْها الآمالُ إلَيْكَ رَجاءَ رَأْفَتِكَ؟","transliteration":"aw taghul-lu akuf-far-rafaa't-haal-aaamaalu ilay-ka rajaaa-a raa-fatik","english_text":"Do You manacle hands which expectations have raised to You in hope of Your clemency?","source_pair_start":18,"source_pair_end":18,"recitation_segment":{"id":"segment-018","title":"Recitation segment 18","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-019","sequence":19,"arabic_text":"أَوْ تُعاقِبُ أَبْداناً عَمِلَتْ بِطاعَتِكَ","transliteration":"aw tua'aqibu ab-daanana a'milat bit'aaa'tika","english_text":"Do You punish bodies which worked to obey You","source_pair_start":19,"source_pair_end":19,"recitation_segment":{"id":"segment-019","title":"Recitation segment 19","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-020","sequence":20,"arabic_text":"حَتَّىٰ نَحِلَتْ فِي مُجاهَدَتِكَ،","transliteration":"h'at-taa nah'ilat fee mujaahadatik","english_text":"until they grew thin in struggling for You?","source_pair_start":20,"source_pair_end":20,"recitation_segment":{"id":"segment-020","title":"Recitation segment 20","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-021","sequence":21,"arabic_text":"أَوْ تُعَذّ ِبُ أَرْجُلاً سَعَتْ فِي عِبادَتِكَ؟","transliteration":"aw tua'd'-d'ibu ar-julana saa't fee i'baadatik","english_text":"Do You chastise legs which ran to worship You?","source_pair_start":21,"source_pair_end":21,"recitation_segment":{"id":"segment-021","title":"Recitation segment 21","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-022","sequence":22,"arabic_text":"إِلَـٰهِي لا تُغْلِقْ عَلىٰ مُوَحّـِدِيكَ أَبْوابَ رَحْمَتِكَ،","transliteration":"ilaahee laa tugh-liq a'laa muwah'-h'ideeka ab-waaba rah'-matik","english_text":"My God, lock not toward those who profess Your Unity the doors of Your mercy,","source_pair_start":22,"source_pair_end":22,"recitation_segment":{"id":"segment-022","title":"Recitation segment 22","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-023","sequence":23,"arabic_text":"وَلا تَحْجُبْ مُشْتاقِيكَ عَنِ النَّظَرِ إلَىٰ جَمِيلِ رُؤْيَتِكَ. ","transliteration":"wa laa th'-jub mush-taaqeeka a'nin-naz'ari ilaa jameeli roo-yatik","english_text":"and veil not those who yearn for You from looking upon the vision of Your beauty!","source_pair_start":23,"source_pair_end":23,"recitation_segment":{"id":"segment-023","title":"Recitation segment 23","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-024","sequence":24,"arabic_text":"إِلَـٰهِي نَفْسٌ أَعْزَزْتَها بِتَوْحِيدِكَ،","transliteration":"ilaahee naf-sun aa'-zaz-tahaa bitawh'eedika","english_text":"My God, a soul which You have exalted by its professing Your Unity -","source_pair_start":24,"source_pair_end":24,"recitation_segment":{"id":"segment-024","title":"Recitation segment 24","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-025","sequence":25,"arabic_text":"كَيْفَ تُذِلُّها بِمَهانَةِ هِجْرانِكَ؟","transliteration":"kay-fa tud'il-luhaa bimahaanati hij-raanik","english_text":"how will You humiliate it by leaving it?","source_pair_start":25,"source_pair_end":25,"recitation_segment":{"id":"segment-025","title":"Recitation segment 25","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-026","sequence":26,"arabic_text":"وَضَمِيرٌ انْعَقَدَ عَلىٰ مَوَدَّتِكَ،","transliteration":"wa z''ameerun-in-a'qada a'laa mawad-datika","english_text":"My God, a heart which has been knotted by its love for You—","source_pair_start":26,"source_pair_end":26,"recitation_segment":{"id":"segment-026","title":"Recitation segment 26","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-027","sequence":27,"arabic_text":"كَيْفَ تُحْرِقُهُ بِحَرارَةِ نِيرانِكَ؟","transliteration":"kay-fa tuh'-riquhoo bih'araarati neeraanik","english_text":"how will You burn it in the heat of Your fires?","source_pair_start":27,"source_pair_end":27,"recitation_segment":{"id":"segment-027","title":"Recitation segment 27","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-028","sequence":28,"arabic_text":"إِلَـٰهِي أَجِرْنِي مِنْ أَلِيمِ غَضَبِكَ وَعَظِيمِ سَخَطِكَ،","transliteration":"ilaahee ajir-nee min aleemi ghaz''abika wa a'z'eemi sakhat'ika","english_text":"My God, give me sanctuary from Your painful wrath and Your mighty anger!","source_pair_start":28,"source_pair_end":28,"recitation_segment":{"id":"segment-028","title":"Recitation segment 28","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-029","sequence":29,"arabic_text":"يا حَنَّانُ يا مَنَّانُ،","transliteration":"yaa h'an-naanu yaa man-naanu","english_text":"O All-loving, O All-kind!","source_pair_start":29,"source_pair_end":29,"recitation_segment":{"id":"segment-029","title":"Recitation segment 29","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-030","sequence":30,"arabic_text":"يا رَحِيمُ يا رَحْمنُ،","transliteration":"yaa rah'eemu yaa rah'-maan","english_text":"O Compassionate, O Merciful!","source_pair_start":30,"source_pair_end":30,"recitation_segment":{"id":"segment-030","title":"Recitation segment 30","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
