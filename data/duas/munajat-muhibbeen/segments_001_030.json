[{"id":"passage-001","sequence":1,"arabic_text":"إِلـٰهِي مَنْ ذَا الَّذِي ذَاقَ حَلاوَةَ مَحَبَّتِكَ،","transliteration":"ilaahee man d'aal-lad'ee d'aaqa h'alaawata mah'ab-batika","english_text":"My God, who can have tasted the sweetness of Your love,","source_pair_start":1,"source_pair_end":1,"recitation_segment":{"id":"segment-001","title":"Recitation segment 1","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-002","sequence":2,"arabic_text":"فَرامَ مِنْكَ بَدَلاً؟","transliteration":"faraama minka badalaa","english_text":"then wanted another in place of You?","source_pair_start":2,"source_pair_end":2,"recitation_segment":{"id":"segment-002","title":"Recitation segment 2","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-003","sequence":3,"arabic_text":"وَمَنْ ذَا الَّذِي أَنِسَ بِقُرْبِكَ،","transliteration":"wa man d'aal-lad'eee anisa biqur-bika","english_text":"Who can have become intimate with Your nearness,","source_pair_start":3,"source_pair_end":3,"recitation_segment":{"id":"segment-003","title":"Recitation segment 3","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-004","sequence":4,"arabic_text":"فَابْتَغَىٰ عَنْكَ حِوَلاً؟","transliteration":"fab-taghaa a'nka h'iwalaa","english_text":"then sought removal from You?","source_pair_start":4,"source_pair_end":4,"recitation_segment":{"id":"segment-004","title":"Recitation segment 4","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-005","sequence":5,"arabic_text":"إِلـٰهِي فَاجْعَلْنا مِمَّنِ اصْطَفَيْتَهُ لِقُرْبِكَ وَوِلايَتِكَ،","transliteration":"ilaahee faj-a'l-naa mim-man is'-t'afay-tahoo liqur-bika wa wilaayatik","english_text":"My God, place us with him whom You have chosen for Your nearness and Your friendship,","source_pair_start":5,"source_pair_end":5,"recitation_segment":{"id":"segment-005","title":"Recitation segment 5","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-006","sequence":6,"arabic_text":"وَأَخْلَصْتَهُ لِوُدِّكَ وَمَحَبَّتِكَ،","transliteration":"wa akh-las'-tahoo liwud-dika wa mah'ab-batik","english_text":"purified through Your affection and Your love,","source_pair_start":6,"source_pair_end":6,"recitation_segment":{"id":"segment-006","title":"Recitation segment 6","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-007","sequence":7,"arabic_text":"وَشَوَّقْتَهُ إِلىٰ لِقائِكَ،","transliteration":"wa shaw-waq-tahooo ilaa liqaaa-ik","english_text":"given yearning for the meeting with You,","source_pair_start":7,"source_pair_end":7,"recitation_segment":{"id":"segment-007","title":"Recitation segment 7","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-008","sequence":8,"arabic_text":"وَرَضَّيْتَهُ بِقَضائِكَ،","transliteration":"wa raz''-z''ay-tahoo biqaz''aaa-ik","english_text":"made pleased with Your decree,","source_pair_start":8,"source_pair_end":8,"recitation_segment":{"id":"segment-008","title":"Recitation segment 8","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-009","sequence":9,"arabic_text":"وَمَنَحْتَهُ بِالنَّظَرِ إلىٰ وَجْهِكَ،","transliteration":"wa manah'-tahoo bin-naz'ari ilaa waj-hik","english_text":"granted gazing upon Your face,","source_pair_start":9,"source_pair_end":9,"recitation_segment":{"id":"segment-009","title":"Recitation segment 9","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-010","sequence":10,"arabic_text":"وَحَبَوْتَهُ بِرِضاكَ،","transliteration":"wa h'abaw-tahoo biriz''aak","english_text":"shown the favour of Your good pleasure,","source_pair_start":10,"source_pair_end":10,"recitation_segment":{"id":"segment-010","title":"Recitation segment 10","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-011","sequence":11,"arabic_text":"وَأَعَذْتَهُ مِنْ هَجْرِكَ وَقِلاكَ،","transliteration":"wa aa'd'-tahoo min haj-rika wa qilaak","english_text":"given refuge from separation from You and Your loathing,","source_pair_start":11,"source_pair_end":11,"recitation_segment":{"id":"segment-011","title":"Recitation segment 11","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-012","sequence":12,"arabic_text":"وَبَوَّأْتَهُ مَقْعَدَ الصِّدْقِ فِي جَوارِكَ،","transliteration":"wa baw-waa-tahoo maq-a'das'-s'id-qi fee jiwaarik","english_text":"settled in a sure sitting place in Your neighbourhood,","source_pair_start":12,"source_pair_end":12,"recitation_segment":{"id":"segment-012","title":"Recitation segment 12","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-013","sequence":13,"arabic_text":"وَخَصَصْتَهُ بِمَعْرِفَتِكَ،","transliteration":"wa khas'as'-tahoo bimaa'-rifatik","english_text":"singled out for true knowledge of You,","source_pair_start":13,"source_pair_end":13,"recitation_segment":{"id":"segment-013","title":"Recitation segment 13","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-014","sequence":14,"arabic_text":"وَأَهَّلْتَهُ لِعِبادَتِكَ،","transliteration":"wa ah-hal-tahoo lii'baadatik","english_text":"made worthy for worship of You,","source_pair_start":14,"source_pair_end":14,"recitation_segment":{"id":"segment-014","title":"Recitation segment 14","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-015","sequence":15,"arabic_text":"وَهَيَّمْتَ قَلْبَهُ لِإِرادَتِكَ،","transliteration":"wa hay-yam-ta qal-bahoo liiraadatik","english_text":"whose heart You have captivated with Your will,","source_pair_start":15,"source_pair_end":15,"recitation_segment":{"id":"segment-015","title":"Recitation segment 15","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-016","sequence":16,"arabic_text":"وَاجْتَبَيْتَهُ لِمُشاهَدَتِكَ،","transliteration":"wa aj-tabay-tahoo limushaahadatik","english_text":"whom You have picked for contemplating You,","source_pair_start":16,"source_pair_end":16,"recitation_segment":{"id":"segment-016","title":"Recitation segment 16","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-017","sequence":17,"arabic_text":"وَأَخْلَيْتَ وَجْهَهُ لَكَ،","transliteration":"wa akh-lay-ta waj-hahoo lak","english_text":"whose look You have made empty for You,","source_pair_start":17,"source_pair_end":17,"recitation_segment":{"id":"segment-017","title":"Recitation segment 17","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-018","sequence":18,"arabic_text":"وَفَرَّغْتَ فُؤادَهُ لِحُبِّكَ،","transliteration":"wa far-ragh-ta foo-aadahoo lih'ub-bik","english_text":"whose breast You have freed for Your love,","source_pair_start":18,"source_pair_end":18,"recitation_segment":{"id":"segment-018","title":"Recitation segment 18","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-019","sequence":19,"arabic_text":"وَرَغَّبْتَهُ فِيمَا عِنْدَكَ،","transliteration":"wa ragh-ghab-tahoo feemaa i'ndak","english_text":"whom You have made desirous of what is with You,","source_pair_start":19,"source_pair_end":19,"recitation_segment":{"id":"segment-019","title":"Recitation segment 19","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-020","sequence":20,"arabic_text":"وَأَلْهَمْتَهُ ذِكْرَكَ،","transliteration":"wa al-ham-tahoo d'ik-rak","english_text":"inspired with Your remembrance,","source_pair_start":20,"source_pair_end":20,"recitation_segment":{"id":"segment-020","title":"Recitation segment 20","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-021","sequence":21,"arabic_text":"وَأَوْزَعْتَهُ شُكْرَكَ،","transliteration":"wa aw-zaa'-tahoo shuk-rak","english_text":"allotted thanksgiving to You,","source_pair_start":21,"source_pair_end":21,"recitation_segment":{"id":"segment-021","title":"Recitation segment 21","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-022","sequence":22,"arabic_text":"وَشَغَلْتَهُ بِطاعَتِكَ،","transliteration":"wa shaghal-tahoo bit'aaa'tik","english_text":"occupied with obeying You,","source_pair_start":22,"source_pair_end":22,"recitation_segment":{"id":"segment-022","title":"Recitation segment 22","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-023","sequence":23,"arabic_text":"وَصَيَّرْتَهُ مِنْ صالِحِي بَرِيَّتِكَ،","transliteration":"wa s'ay-yar-tahoo min s'aalih'ee baree-yatik","english_text":"turned into one of Your righteous creatures,","source_pair_start":23,"source_pair_end":23,"recitation_segment":{"id":"segment-023","title":"Recitation segment 23","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-024","sequence":24,"arabic_text":"وَاخْتَرْتَهُ لِمُناجاتِكَ،","transliteration":"wa akh-tar-tahoo limunaajaatik","english_text":"chosen for whispered prayer to You,","source_pair_start":24,"source_pair_end":24,"recitation_segment":{"id":"segment-024","title":"Recitation segment 24","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-025","sequence":25,"arabic_text":"وَقَطَعْتَ عَنْهُ كُلَّ شَيْءٍ يَقْطَعُهُ عَنْكَ!","transliteration":"wa qat'aa'-ta a'n-hoo kul-la shay-ee-yaq-t'au'hoo a'nk","english_text":"and from whom You have cut off all things which cut him off from You!","source_pair_start":25,"source_pair_end":25,"recitation_segment":{"id":"segment-025","title":"Recitation segment 25","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-026","sequence":26,"arabic_text":"اَللَّهُمَّ اجْعَلْنا مِمَّنْ دَأْبُهُمُ الارْتِياحُ إلَيْكَ وَالْحَنِينُ،","transliteration":"al-lahum-ma aj-a'l-naa mim-man daa-buhumulir-teeaahoo ilay-ka wal-h'aneen","english_text":"O God, place us among those whose habit is rejoicing in You and yearning for You,","source_pair_start":26,"source_pair_end":26,"recitation_segment":{"id":"segment-026","title":"Recitation segment 26","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-027","sequence":27,"arabic_text":"وَدَهْرُهُمُ الزَّفْرَةُ وَالأَنِينُ،","transliteration":"wa dah-ruhumuz-zaf-ratu wal-aneen","english_text":"whose time is spent in sighing and moaning!","source_pair_start":27,"source_pair_end":27,"recitation_segment":{"id":"segment-027","title":"Recitation segment 27","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-028","sequence":28,"arabic_text":"جِباهُهُمْ ساجِدَةٌ لِعَظَمَتِكَ،","transliteration":"jibaahuhum saajidatul-lia'z'amatik","english_text":"Their foreheads are bowed down before Your mightiness,","source_pair_start":28,"source_pair_end":28,"recitation_segment":{"id":"segment-028","title":"Recitation segment 28","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-029","sequence":29,"arabic_text":"وَعُيُونُهُمْ ساهِرَةٌ فِي خِدْمَتِكَ،","transliteration":"wa u'yoonuhum saahiratun fee khid-matik","english_text":"their eyes wakeful in Your service,","source_pair_start":29,"source_pair_end":29,"recitation_segment":{"id":"segment-029","title":"Recitation segment 29","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-030","sequence":30,"arabic_text":"وَدُمُوعُهُمْ سائِلَةٌ مِنْ خَشْيَتِكَ،","transliteration":"wa dumoou'hum saaa-ilatum-min khash-yatik","english_text":"their tears flowing in dread of You,","source_pair_start":30,"source_pair_end":30,"recitation_segment":{"id":"segment-030","title":"Recitation segment 30","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
