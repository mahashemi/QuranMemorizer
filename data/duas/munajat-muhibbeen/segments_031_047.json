[{"id":"passage-031","sequence":31,"arabic_text":"وَقُلُوبُهُمْ مُتَعَلِّقَةٌ بِمَحَبَّتِكَ،","transliteration":"wa quloobuhum mutaa'l-liqatum-bimah'ab-batik","english_text":"their hearts fixed upon Your love,","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"وَأَفْئِدَتُهُمْ مُنْخَلِعَةٌ مِنْ مَهابَتِكَ،","transliteration":"wa af-idatuhum mun-khalia-tum-mim-mahaabatik","english_text":"their cores shaken with awe of You.","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"يا مَنْ أَنْوارُ قُدْسِهِ لِأَبْصارِ مُحِبِّيهِ رائِقَةٌ،","transliteration":"yaa man anwaaru qud-sihee liab-s'aari muh'ib-beehee raaa-iqah","english_text":"O He the lights of whose holiness induce wonder in the eyes of His lovers,","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"وَسُبُحاتُ وَجْهِهِ لِقُلُوبِ عارِفِيهِ شائِقَةٌ،","transliteration":"wa subuh'aatu waj-hihee liquloobi a'arifeehee shaaa-iqatun","english_text":"the glories of whose face arouse the longing of the hearts of His knowers!","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"يا مُنىٰ قُلُوبِ الْمُشْتاقِينَ،","transliteration":"yaa munaa quloobil-mush-taaqeen","english_text":"O Furthest Wish of the hearts of the yearners!","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"وَيا غايَةَ آمالِ الْمُحِبِّينَ،","transliteration":"wa yaa ghaayata aaamaalil-muh'ib-been","english_text":"O Utmost Limit of the hopes of the lovers!","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"أَسْأَلُكَ حُبَّكَ وَحُبَّ مَنْ يُحِبُّكَ،","transliteration":"as-aluka h'ub-bak wa h'ub-ba may-yuh'ib-buk","english_text":"I ask from You love for You, love for those who love You,","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"وَحُبَّ كُلِّ عَمَلٍ يُوصِلُنِي إلىٰ قُرْبِكَ،","transliteration":"wa h'ub-ba kul-li a'malee-yoos'iluneee ila qur-bik","english_text":"love for every work which will join me to Your nearness,","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-039","sequence":39,"arabic_text":"وَأَنْ تَجْعَلَكَ أَحَبَّ إلَيَّ مِمَّا سِواكَ،","transliteration":"wa an taj-a'laka ah'ab-ba ilay-ya mim-maa siwaak","english_text":"and that You make Yourself more beloved to me than anything other than You","source_pair_start":39,"source_pair_end":39,"recitation_segment":{"id":"segment-039","title":"Recitation segment 39","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-040","sequence":40,"arabic_text":"وَأَنْ تَجْعَلَ حُبّـِي إيَّاكَ قائِداً إلىٰ رِضْوانِكَ،","transliteration":"wa an taj-a'l h'ub-beee ee-yaaka qaaa-idan ilaa riz''-waanik","english_text":"and make my love for You lead to Your good pleasure,","source_pair_start":40,"source_pair_end":40,"recitation_segment":{"id":"segment-040","title":"Recitation segment 40","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-041","sequence":41,"arabic_text":"وَشَوْقِي إلَيْكَ ذائِداً عَنْ عِصْيانِكَ،","transliteration":"wa shaw-qeee ilay-ka d'aaa-idan a'n i's'-yaanik","english_text":"and my yearning for You protect against disobeying You!","source_pair_start":41,"source_pair_end":41,"recitation_segment":{"id":"segment-041","title":"Recitation segment 41","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-042","sequence":42,"arabic_text":"وَامْنُنْ بِالنَّظَرِ إلَيْكَ عَلَيَّ،","transliteration":"wa am-num-bin-naz'ari ilay-ka a'lay","english_text":"Oblige me by allowing me to gaze upon You,","source_pair_start":42,"source_pair_end":42,"recitation_segment":{"id":"segment-042","title":"Recitation segment 42","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-043","sequence":43,"arabic_text":"وَانْظُرْ بِعَيْنِ الْوُدِّ وَالْعَطْفِ إلَيَّ،","transliteration":"wa anz'ur bia'y-nil-wud-di wal-a't'-fi ilay","english_text":"gaze upon me with the eye of affection and tenderness,","source_pair_start":43,"source_pair_end":43,"recitation_segment":{"id":"segment-043","title":"Recitation segment 43","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-044","sequence":44,"arabic_text":"وَلا تَصْرِفْ عَنِّي وَجْهَكَ،","transliteration":"wa laa tas'-rif a'n-nee waj-hak","english_text":"turn not Your face away from me,","source_pair_start":44,"source_pair_end":44,"recitation_segment":{"id":"segment-044","title":"Recitation segment 44","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-045","sequence":45,"arabic_text":"وَاجْعَلْنِي مِنْ أَهْلِ الإِسْعادِ وَالْحُظْوَةِ عِنْدَكَ،","transliteration":"waj-a'l-nee min ah-lil-is-a'adi wal-h'uz'-wati i'ndaka","english_text":"and make me one of the people of happiness with You and favoured position!","source_pair_start":45,"source_pair_end":45,"recitation_segment":{"id":"segment-045","title":"Recitation segment 45","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-046","sequence":46,"arabic_text":"يا مُجِيبُ،","transliteration":"yaa mujeebu","english_text":"O Responder,","source_pair_start":46,"source_pair_end":46,"recitation_segment":{"id":"segment-046","title":"Recitation segment 46","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-047","sequence":47,"arabic_text":"يا أَرْحَمَ الرَّاحِمِينَ.","transliteration":"yaaa ar-h'amar-raah'imeen","english_text":"O Most Merciful of the merciful!","source_pair_start":47,"source_pair_end":47,"recitation_segment":{"id":"segment-047","title":"Recitation segment 47","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
