[{"id":"passage-031","sequence":31,"arabic_text":"أَتَيْتُكَ طامِعاً فِي إِحْسانِكَ،","transliteration":"atay-tuk t'aamia'na feee ih'-saanik","english_text":"I have come to You craving Your beneficence,","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"راغِباً فِي امْتِنانِكَ،","transliteration":"raghiban fim-tinanik","english_text":"desiring Your kindness,","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"مُسْتَسْقِياً وابِلَ طَوْلِكَ،","transliteration":"mus-tas-qeeaw-waabila t'aw-lik","english_text":"seeking water from the deluge of Your graciousness,","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"مُسْتَمْطِراً غَمامَ فَضْلِكَ،","transliteration":"mus-tam-t'iran ghamaama faz''-lik","english_text":"begging rain from the clouds of Your bounty,","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"طالِباً مَرْضاتَكَ،","transliteration":"t'aalibam-mar-z''aatak","english_text":"requesting Your good pleasure,","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"قاصِداً جَنابَكَ،","transliteration":"qaas'idan janaabak","english_text":"going straight to Your side,","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"وارِداً شَرِيعَةَ رِفْدِكَ،","transliteration":"waaridan shareea'ta rif-dik","english_text":"arriving at the watering-place of Your support,","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"مُلْتَمِساً سَنِيَّ الْخَيْراتِ مِنْ عِنْدِكَ،","transliteration":"mul-tamisan sanee-yal-khay-raati min i'ndik","english_text":"seeking exalted good things from Your quarter,","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-039","sequence":39,"arabic_text":"وافِداً إلىٰ حَضْرَةِ جَمالِكَ،","transliteration":"waafidan ila h'az''-rati jamaalik","english_text":"reaching for the presence of Your beauty,","source_pair_start":39,"source_pair_end":39,"recitation_segment":{"id":"segment-039","title":"Recitation segment 39","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-040","sequence":40,"arabic_text":"مُرِيداً وَجْهَكَ،","transliteration":"mureedaw-waj-hak","english_text":"wanting Your face,","source_pair_start":40,"source_pair_end":40,"recitation_segment":{"id":"segment-040","title":"Recitation segment 40","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-041","sequence":41,"arabic_text":"طارِقاً بابَكَ،","transliteration":"t'aariqam-baabak","english_text":"knocking at Your door,","source_pair_start":41,"source_pair_end":41,"recitation_segment":{"id":"segment-041","title":"Recitation segment 41","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-042","sequence":42,"arabic_text":"مُسْتَكِيناً لِعَظَمَتِكَ وَجَلالِكَ،","transliteration":"mus-takeenal-lia'z'amatika wa jalaalika","english_text":"abasing myself before Your mightiness and majesty!","source_pair_start":42,"source_pair_end":42,"recitation_segment":{"id":"segment-042","title":"Recitation segment 42","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-043","sequence":43,"arabic_text":"فَافْعَلْ بِي ما أَنْتَ أَهْلُهُ مِنَ الْمَغْفِرَةِ وَالرَّحْمَةِ،","transliteration":"faf-a'l bee maaa anta ah-luhoo minal-magh-firati war-rah'-mati","english_text":"So act toward me with the forgiveness and mercy of which You are worthy!","source_pair_start":43,"source_pair_end":43,"recitation_segment":{"id":"segment-043","title":"Recitation segment 43","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-044","sequence":44,"arabic_text":"وَلا تَفْعَلْ بِي ما أَنا أَهْلُهُ مِنَ الْعَذابِ وَالنِّقْمَةِ،","transliteration":"wa laa taf-a'l bee maaa ana ah-luhoo minal-a'd'aabi wan-niq-mati","english_text":"Act not toward me with the chastisement and vengeance of which I am worthy!","source_pair_start":44,"source_pair_end":44,"recitation_segment":{"id":"segment-044","title":"Recitation segment 44","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-045","sequence":45,"arabic_text":"بِرَحْمَتِكَ يا أَرْحَمَ الرَّاحِمِينَ.","transliteration":"birah'-matika yaaa ar-h'amar-raah'imeen","english_text":"By Your mercy, O Most Merciful of the merciful!","source_pair_start":45,"source_pair_end":45,"recitation_segment":{"id":"segment-045","title":"Recitation segment 45","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
