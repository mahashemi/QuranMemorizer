          }
        },
        {
          "id": "passage-013",
          "sequence": 13,
          "arabic_text": "أَسْأَلُكَ بِاسْمِكَ الَّذِي أَشْرَقَتْ بِهِ السَّمَاوَاتُ وَالْأَرَضُونَ",
          "transliteration": "as'aluka bismika alladhī ashraqat bihī alssamāwātu wal-araḍūna",
          "english_text": "I beseech You in the name of Your Name with which the heavens and the earth have lit up",
