        },
        {
          "id": "passage-020",
          "sequence": 20,
          "arabic_text": "اللَّهُمَّ بَلِّغْ مَوْلَانَا الْإِمَامَ الْهَادِيَ الْمَهْدِيَّ الْقَائِمَ بِأَمْرِكَ",
          "transliteration": "allāhumma balligh mawlānā al-imāma alhādiya almahdiyya alqā'ima bi'amrika",
          "english_text": "O Allah, convey to our master Imam al-Mahdi, the guide who is to undertake Your orders,",
