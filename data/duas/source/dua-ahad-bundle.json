        {
          "id": "passage-012",
          "sequence": 12,
          "arabic_text": "يَا حَيُّ يَا قَيُّومُ",
          "transliteration": "yā ḥayyu yā qayyūmu",
          "english_text": "O Ever-living! O Self-Subsistent!",
