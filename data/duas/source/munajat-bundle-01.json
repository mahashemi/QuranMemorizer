        {
          "id": "passage-034",
          "sequence": 34,
          "arabic_text": "فَما عُذْرُ مَنْ أَغْفَلَ دُخُولَ الْبابِ بَعْدَ فَتْحِهِ؟",
          "transliteration": "famaa u'd'-ru man agh-fala dukhoolal-baabi baa'-da fat-h'ih",
          "english_text": "What is the excuse of him who remains heedless of entering the door after its opening?",
