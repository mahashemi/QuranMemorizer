        },
        {
          "id": "passage-036",
          "sequence": 36,
          "arabic_text": "فَلْيَحْسُنِ الْعَفْوُ مِنْ عِنْدِكَ. ",
          "transliteration": "fal-yah'-sunil-a'f-wu min i'ndik",
          "english_text": "Your pardon is beautiful.",
