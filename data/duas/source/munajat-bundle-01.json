            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-035",
          "sequence": 35,
          "arabic_text": "إِلـٰهِي إنْ كانَ قَبُحَ الذَّنْبُ مِنْ عَبْدِكَ،",
          "transliteration": "ilaaheee in kaana qabuh'ad'-d'ambu min a'b-dika",
          "english_text": "My God, though the sins of Your servant are ugly,",
