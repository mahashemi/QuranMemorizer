            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-006",
          "sequence": 6,
          "arabic_text": "وَخَلَّتِي لا يَسُدُّها إلاَّ طَوْلُكَ،",
          "transliteration": "wa khal-latee laa yasud-duhaaa il-laa t'aw-luk",
          "english_text": "remedy my lack but Your graciousness,",
