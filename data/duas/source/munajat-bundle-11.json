        {
          "id": "passage-001",
          "sequence": 1,
          "arabic_text": "إِلـٰهِي كَسْرِي لا يَجْبُرُهُ إلاَّ لُطْفُكَ وَحَنانُكَ،",
          "transliteration": "ilaahee kas-ree laa yaj-buruhooo il-laa lut'-fuk wa h'anaanuka",
          "english_text": "My God, nothing will mend my fracture but Your gentleness and loving care,",
          "source_pair_start": 1,
          "source_pair_end": 1,
          "recitation_segment": {
            "id": "segment-001",
            "title": "Recitation segment 1",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-002",
          "sequence": 2,
          "arabic_text": "وَفَقْرِي لا يُغْنِيهِ إلاَّ عَطْفُكَ وَإحْسانُكَ،",
          "transliteration": "wa faq-ree laa yugh-neeheee il-laa a't'-fuka wa ih'-saanuk",
          "english_text": "free me of my poverty but Your affection and beneficence,",
          "source_pair_start": 2,
          "source_pair_end": 2,
          "recitation_segment": {
