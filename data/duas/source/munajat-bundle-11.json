            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-004",
          "sequence": 4,
          "arabic_text": "وَذِلَّتِي لا يُعِزُّها إلاَّ سُلْطانُكَ،",
          "transliteration": "wa d'il-latee laa yui'z-zuhaaa il-laa sul-t'anuk",
          "english_text": "exalt my abasement but Your sovereignty,",
