            "pause_after": true
          }
        },
        {
          "id": "passage-003",
          "sequence": 3,
          "arabic_text": "وَرَوْعَتِي لا يُسَكّـِنُها إلاَّ أَمانُكَ،",
          "transliteration": "wa raw-a'tee laa yusak-kinuhaaa il-laaa amaanuk",
          "english_text": "still my fright but Your security,",
