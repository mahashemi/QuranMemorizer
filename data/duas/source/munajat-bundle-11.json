            "pause_after": true
          }
        },
        {
          "id": "passage-005",
          "sequence": 5,
          "arabic_text": "وَأُمْنِيَّتِي لا يُبَلّـِغُنِيها إلاَّ فَضْلُكَ،",
          "transliteration": "wa um-neeatee laa yubal-lighuneehaaa il-laa faz''-luka",
          "english_text": "take me to my hope but Your bounty,",
          "source_pair_start": 5,
          "source_pair_end": 5,
          "recitation_segment": {
