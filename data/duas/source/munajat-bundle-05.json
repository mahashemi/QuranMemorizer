      "records": [
        {
          "id": "passage-001",
          "sequence": 1,
          "arabic_text": "إِلـٰهِي إنْ كانَ قَلَّ زادِي فِي الْمَسِيرِ إلَيْكَ،",
          "transliteration": "ilaaheee in kaana qal-la zaadee fil-maseeri ilay-ka",
          "english_text": "My God, though my stores for travelling to You are few,",
          "source_pair_start": 1,
          "source_pair_end": 1,
          "recitation_segment": {
            "id": "segment-001",
            "title": "Recitation segment 1",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-002",
          "sequence": 2,
          "arabic_text": "فَلَقَدْ حَسُنَ ظَنّـِي بِالتَّوَكُّلِ عَلَيْكَ،",
          "transliteration": "falaqad h'asuna z'an-nee bit-tawak-kuli a'lay-ka",
          "english_text": "my confidence in You has given me a good opinion.",
          "source_pair_start": 2,
          "source_pair_end": 2,
          "recitation_segment": {
            "id": "segment-002",
            "title": "Recitation segment 2",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-003",
          "sequence": 3,
          "arabic_text": "وَإنْ كانَ جُرْمِي قَدْ أَخافَنِي مِنْ عُقُوبَتِكَ،",
          "transliteration": "wa in kaana jur-mee qad akhaafanee min u'qoobatik",
          "english_text": "Though my sin has made me fear Your punishment,",
          "source_pair_start": 3,
          "source_pair_end": 3,
          "recitation_segment": {
            "id": "segment-003",
            "title": "Recitation segment 3",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-004",
          "sequence": 4,
          "arabic_text": "فَإنَّ رَجائِي قَدْ أَشْعَرَنِي بِالأَمْنِ مِنْ نِقْمَتِكَ،",
          "transliteration": "fa in-na rajaaa-ee qad ash-a'ranee bil-am-ni min-naqimatika",
          "english_text": "my hope has let me feel secure from Your vengeance.",
          "source_pair_start": 4,
          "source_pair_end": 4,
          "recitation_segment": {
            "id": "segment-004",
            "title": "Recitation segment 4",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-005",
          "sequence": 5,
          "arabic_text": "وَإنْ كانَ ذَنْبِي قَدْ عَرَّضَنِي لِعِقابِكَ،",
          "transliteration": "wa in kaana d'ambee qad a'r-raz''anee lii'qaabika",
          "english_text": "Though my misdeed has exposed me to Your penalty,",
          "source_pair_start": 5,
          "source_pair_end": 5,
          "recitation_segment": {
            "id": "segment-005",
            "title": "Recitation segment 5",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-006",
          "sequence": 6,
          "arabic_text": "فَقَدْ آذَنَنِي حُسْنُ ثِقَتِي بِثَوابِكَ،",
          "transliteration": "faqad aaad'ananee h'us-nu thiqatee bithawaabik",
          "english_text": "my excellent trust has apprised me of Your reward.",
          "source_pair_start": 6,
          "source_pair_end": 6,
          "recitation_segment": {
            "id": "segment-006",
            "title": "Recitation segment 6",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-007",
          "sequence": 7,
          "arabic_text": "وَإنْ أَنامَتْنِي الْغَفْلَةُ عَنِ الاسْتِعْدادِ لِلِقائِكَ،",
          "transliteration": "wa in anamat-neel-ghaf-latu a'nilis-tia'-daadi liliqaaa-ika",
          "english_text": "Though heedlessness has put to sleep my readiness to meet You,",
          "source_pair_start": 7,
          "source_pair_end": 7,
          "recitation_segment": {
            "id": "segment-007",
            "title": "Recitation segment 7",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-008",
          "sequence": 8,
          "arabic_text": "فَقَدْ نَبَّهَتْنِي الْمَعْرِفَةُ بِكَرَمِكَ وَآلائِكَ،",
          "transliteration": "faqad nab-bahat-neel-maa'-rifatu bikaramika wa aaalaaa-ika",
          "english_text": "knowledge has awakened me to Your generosity and boons.",
          "source_pair_start": 8,
          "source_pair_end": 8,
          "recitation_segment": {
            "id": "segment-008",
            "title": "Recitation segment 8",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-009",
          "sequence": 9,
          "arabic_text": "وَإنْ أَوْحَشَ ما بَيْنِي وَبَيْنَكَ فَرْطُ الْعِصْيانِ وَالطُّغْيانِ،",
          "transliteration": "wa in aw-h'asha maa bay-nee wa bay-naka far-t'ul-i's'-yaani wat'-t'ugh-yaani",
          "english_text": "Though excessive disobedience and rebellion have estranged me from You,",
          "source_pair_start": 9,
          "source_pair_end": 9,
          "recitation_segment": {
            "id": "segment-009",
            "title": "Recitation segment 9",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-010",
          "sequence": 10,
          "arabic_text": "فَقَدْ آنَسَنِي بُشْرىٰ الْغُفْرانِ وَالرِّضْوانِ،",
          "transliteration": "faqad aaanasanee bush-raal-ghuf-raani war-riz''-waan",
          "english_text": "the glad tidings of forgiveness and good pleasure have made me feel intimate with You.",
          "source_pair_start": 10,
          "source_pair_end": 10,
          "recitation_segment": {
            "id": "segment-010",
            "title": "Recitation segment 10",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-011",
          "sequence": 11,
          "arabic_text": "أَسْأَلُكَ بِسُبُحاتِ وَجْهِكَ وَبِأَنْوارِ قُدْسِكَ،",
          "transliteration": "as-aluka bisubuh'aati waj-hika wa bi anwari qud-sik",
          "english_text": "I ask You by the splendours of Your face and the lights of Your holiness,",
          "source_pair_start": 11,
          "source_pair_end": 11,
          "recitation_segment": {
            "id": "segment-011",
            "title": "Recitation segment 11",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-012",
          "sequence": 12,
          "arabic_text": "وَأَبْتَهِلُ إلَيْكَ بِعَواطِفِ رَحْمَتِكَ وَلَطائِفِ بِرِّكَ،",
          "transliteration": "wa ab-tahilu ilay-ka bia'waat'ifi rah'-matika wa lat'aaa-ifi bir-rika",
          "english_text": "and I implore You by the tenderness of Your mercy and the gentleness of Your goodness,",
          "source_pair_start": 12,
          "source_pair_end": 12,
          "recitation_segment": {
            "id": "segment-012",
            "title": "Recitation segment 12",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-013",
          "sequence": 13,
          "arabic_text": "أَنْ تُحَقِّقَ ظَنّـِي بِما أُؤَمِّلُهُ مِنْ جَزِيلِ إِكْرامِكَ،",
          "transliteration": "an tuh'aq-qiqa z'an-nee bimaaa oo-am-miluhoo min jazeeli ik-raamika",
          "english_text": "to verify my opinion in expecting Your great generosity",
          "source_pair_start": 13,
          "source_pair_end": 13,
          "recitation_segment": {
            "id": "segment-013",
            "title": "Recitation segment 13",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-014",
          "sequence": 14,
          "arabic_text": "وَجَمِيلِ إِنْعامِكَ،",
          "transliteration": "wa jameeli in-a'amika",
          "english_text": "and Your beautiful favour,",
          "source_pair_start": 14,
          "source_pair_end": 14,
          "recitation_segment": {
            "id": "segment-014",
            "title": "Recitation segment 14",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-015",
          "sequence": 15,
          "arabic_text": "فِي الْقُرْبىٰ مِنْكَ،",
          "transliteration": "fil-qur-baa minka",
          "english_text": "through nearness to You,",
          "source_pair_start": 15,
          "source_pair_end": 15,
          "recitation_segment": {
            "id": "segment-015",
            "title": "Recitation segment 15",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-016",
          "sequence": 16,
          "arabic_text": "وَالزُّلْفىٰ لَدَيْكَ،",
          "transliteration": "waz-zul-faa laday-ka",
          "english_text": "proximity with You,",
          "source_pair_start": 16,
          "source_pair_end": 16,
          "recitation_segment": {
            "id": "segment-016",
            "title": "Recitation segment 16",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-017",
          "sequence": 17,
          "arabic_text": "وَالتَّمَتُّعِ بِالنَّظَرِ إلَيْكَ،",
          "transliteration": "wat-tamat-tui' bin-naz'ari ilay-k",
          "english_text": "and enjoyment of gazing upon You!",
          "source_pair_start": 17,
          "source_pair_end": 17,
          "recitation_segment": {
            "id": "segment-017",
            "title": "Recitation segment 17",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-018",
          "sequence": 18,
          "arabic_text": "وَها أَنا مُتَعَرِّضٌ لِنَفَحاتِ رَوْحِكَ وَعَطْفِكَ،",
          "transliteration": "wa haaa ana mutaa'r-riz''ul-linafah'aati raw-h'ika wa a't'-fika",
          "english_text": "Here am I, addressing myself to the breezes of Your freshness and tenderness,",
          "source_pair_start": 18,
          "source_pair_end": 18,
          "recitation_segment": {
            "id": "segment-018",
            "title": "Recitation segment 18",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-019",
          "sequence": 19,
          "arabic_text": "وَمُنْتَجِعٌ غَيْثَ جُودِكَ وَلُطْفِكَ،",
          "transliteration": "wa muntajiu'n ghay-tha joodika wa lut'-fika",
          "english_text": "having recourse to the rain of Your generosity and gentleness,",
          "source_pair_start": 19,
          "source_pair_end": 19,
          "recitation_segment": {
            "id": "segment-019",
            "title": "Recitation segment 19",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-020",
          "sequence": 20,
          "arabic_text": "فارٌّ مِنْ سَخَطِكَ إلىٰ رِضاكَ،",
          "transliteration": "far-ru min sakhat'ika ilaa riz''aak",
          "english_text": "fleeing from Your displeasure to Your good pleasure",
          "source_pair_start": 20,
          "source_pair_end": 20,
          "recitation_segment": {
            "id": "segment-020",
            "title": "Recitation segment 20",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-021",
          "sequence": 21,
          "arabic_text": "هارِبٌ مِنْكَ إلَيْكَ،",
          "transliteration": "haaribum-minka ilay-k",
          "english_text": "and from You to You,",
          "source_pair_start": 21,
          "source_pair_end": 21,
          "recitation_segment": {
            "id": "segment-021",
            "title": "Recitation segment 21",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-022",
          "sequence": 22,
          "arabic_text": "راجٍ أَحْسَنَ ما لَدَيْكَ،",
          "transliteration": "raajin ah'-sana maa laday-k",
          "english_text": "hoping for the best of what is with You,",
          "source_pair_start": 22,
          "source_pair_end": 22,
          "recitation_segment": {
            "id": "segment-022",
            "title": "Recitation segment 22",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-023",
          "sequence": 23,
          "arabic_text": "مُعَوِّلٌ عَلىٰ مَواهِبِكَ،",
          "transliteration": "mua'w-wilun a'laa mawahibika",
          "english_text": "relying upon Your gifts,",
          "source_pair_start": 23,
          "source_pair_end": 23,
          "recitation_segment": {
            "id": "segment-023",
            "title": "Recitation segment 23",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-024",
          "sequence": 24,
          "arabic_text": "مُفْتَقِرٌ إلىٰ رِعايَتِكَ. ",
          "transliteration": "muf-taqirun ilaa ria'ayatik",
          "english_text": "utterly poor toward Your guarding!",
          "source_pair_start": 24,
          "source_pair_end": 24,
          "recitation_segment": {
            "id": "segment-024",
            "title": "Recitation segment 24",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-025",
          "sequence": 25,
          "arabic_text": "إِلـٰهِي ما بَدَأْتَ بِهِ مِنْ فَضْلِكَ فَتَمِّمْهُ،",
          "transliteration": "ilaahee maa badaa-ta bihee min faz''-lika fatam-mim-hoo",
          "english_text": "My God, Your bounty which You have begun - complete it!",
          "source_pair_start": 25,
          "source_pair_end": 25,
          "recitation_segment": {
            "id": "segment-025",
            "title": "Recitation segment 25",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-026",
          "sequence": 26,
          "arabic_text": "وَما وَهَبْتَ لِي مِنْ كَرَمِكَ فَلا تَسْلُبْهُ،",
          "transliteration": "wa maa wahab-ta lee min karamika falaa tas-lub-h",
          "english_text": "Your generosity which You have given me - strip it not away!",
          "source_pair_start": 26,
          "source_pair_end": 26,
          "recitation_segment": {
            "id": "segment-026",
            "title": "Recitation segment 26",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-027",
          "sequence": 27,
          "arabic_text": "وَما سَتَرْتَهُ عَلَيَّ بِحِلْمِكَ فَلا تَهْتِكْهُ،",
          "transliteration": "wa maa satar-tahoo a'lay-ya bih'il-mika fala tah-tik-h",
          "english_text": "Your cover over me through Your clemency - tear it not away!",
          "source_pair_start": 27,
          "source_pair_end": 27,
          "recitation_segment": {
            "id": "segment-027",
            "title": "Recitation segment 27",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-028",
          "sequence": 28,
          "arabic_text": "وَما عَلِمْتَهُ مِنْ قَبِيحِ فِعْلِي فَاغْفِرْهُ. ",
          "transliteration": "wa maa a'lim-tahoo min qabeehee fia'-lee fagh-fir-h",
          "english_text": "My ugly acts which You have come to know - forgive them!",
          "source_pair_start": 28,
          "source_pair_end": 28,
          "recitation_segment": {
            "id": "segment-028",
            "title": "Recitation segment 28",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-029",
          "sequence": 29,
          "arabic_text": "إِلـٰهِي اسْتَشْفَعْتُ بِكَ إلَيْكَ،",
          "transliteration": "ilaahee is-tash-faa'-tu bika ilay-k",
          "english_text": "My God, I seek intercession from You with You,",
          "source_pair_start": 29,
          "source_pair_end": 29,
          "recitation_segment": {
            "id": "segment-029",
            "title": "Recitation segment 29",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-030",
          "sequence": 30,
          "arabic_text": "وَاسْتَجَرْتُ بِكَ مِنْكَ،",
          "transliteration": "was-tajar-tu bika minka",
          "english_text": "and I seek sanctuary in You from You!",
          "source_pair_start": 30,
          "source_pair_end": 30,
          "recitation_segment": {
            "id": "segment-030",
            "title": "Recitation segment 30",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-031",
          "sequence": 31,
          "arabic_text": "أَتَيْتُكَ طامِعاً فِي إِحْسانِكَ،",
          "transliteration": "atay-tuk t'aamia'na feee ih'-saanik",
          "english_text": "I have come to You craving Your beneficence,",
          "source_pair_start": 31,
          "source_pair_end": 31,
          "recitation_segment": {
            "id": "segment-031",
            "title": "Recitation segment 31",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-032",
          "sequence": 32,
          "arabic_text": "راغِباً فِي امْتِنانِكَ،",
          "transliteration": "raghiban fim-tinanik",
          "english_text": "desiring Your kindness,",
          "source_pair_start": 32,
          "source_pair_end": 32,
          "recitation_segment": {
            "id": "segment-032",
            "title": "Recitation segment 32",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-033",
          "sequence": 33,
          "arabic_text": "مُسْتَسْقِياً وابِلَ طَوْلِكَ،",
          "transliteration": "mus-tas-qeeaw-waabila t'aw-lik",
          "english_text": "seeking water from the deluge of Your graciousness,",
          "source_pair_start": 33,
          "source_pair_end": 33,
          "recitation_segment": {
            "id": "segment-033",
            "title": "Recitation segment 33",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-034",
          "sequence": 34,
          "arabic_text": "مُسْتَمْطِراً غَمامَ فَضْلِكَ،",
          "transliteration": "mus-tam-t'iran ghamaama faz''-lik",
          "english_text": "begging rain from the clouds of Your bounty,",
          "source_pair_start": 34,
