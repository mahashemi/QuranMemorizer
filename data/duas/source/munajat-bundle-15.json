  "readings": [
    {
      "id": "munajat-zaahideen",
      "title": "15. The Whispered Prayer of the Abstainers (Zaahideen)",
      "arabicTitle": "مناجاة الزاهدين",
      "description": "The fifteenth of the fifteen whispered prayers attributed to Imam al-Sajjad (عليه السلام).",
      "group": "15 Munajat",
      "order": 215,
      "attribution": "Arabic, transliteration, and English translation transcribed from Duas.org's Sahifa Sajjadiya page; attribution requested by the source.",
      "source": {
        "label": "Duas.org — Sahifa Sajjadiya, Munajat 15",
        "url": "https://www.duas.org/sajjadiya/dua83.htm",
        "license": "Duas.org no-copyright statement; attribution requested",
        "licenseUrl": "https://www.duas.org/mobile/index.jaw.html"
      },
      "sourceStatus": "imported-review-required",
      "sourcePairCount": 23,
      "storageChunkSize": 30,
      "records": [
        {
          "id": "passage-001",
          "sequence": 1,
          "arabic_text": "إِلـٰهِي أَسْكَنْتَنا داراً حَفَرَتْ لَنا حُفَرَ مَكْرِها،",
          "transliteration": "ilaaheee as-kantanaa daaran h'afarat lanaa h'ufara mak-rihaa",
          "english_text": "My God, You have settled us in an abode which has dug for us pits of deception,",
          "source_pair_start": 1,
          "source_pair_end": 1,
          "recitation_segment": {
            "id": "segment-001",
            "title": "Recitation segment 1",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-002",
          "sequence": 2,
          "arabic_text": "وَعَلَّقَتْنا بِأَيْدِي الْمَنايا فِي حَبائِلِ غَدْرِها،",
          "transliteration": "wa a'l-laq-tanaa biy-deel-manaayaa fee h'abaaa-ili ghad-rihaa",
          "english_text": "and You have fastened us by the hands of death in the snares of that abode's treachery!",
          "source_pair_start": 2,
          "source_pair_end": 2,
          "recitation_segment": {
            "id": "segment-002",
            "title": "Recitation segment 2",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-003",
          "sequence": 3,
          "arabic_text": "فَإِلَيْكَ نَلْتَجِئُ مِنْ مَكائِدِ خُدَعِها،",
          "transliteration": "faalay-ka nal-taji-u mim-makaaa-idi khudae'haa",
          "english_text": "In You we seek asylum from the tricks of its guile,",
          "source_pair_start": 3,
          "source_pair_end": 3,
          "recitation_segment": {
            "id": "segment-003",
            "title": "Recitation segment 3",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-004",
          "sequence": 4,
          "arabic_text": "وَبِكَ نَعْتَصِمُ مِنَ الاغْتِرارِ بِزَخارِفِ زِينَتِها،",
          "transliteration": "wa bika naa'-tas'imu minaligh-tiraar bizakhaarifi zeenatihaa",
          "english_text": "and to You we hold fast, lest we be deluded by the glitter of its ornaments!",
          "source_pair_start": 4,
          "source_pair_end": 4,
          "recitation_segment": {
            "id": "segment-004",
            "title": "Recitation segment 4",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-005",
          "sequence": 5,
          "arabic_text": "فَإِنَّها الْمُهْلِكَةُ طُلاَّبَها،",
          "transliteration": "fa in-naha al-muh-likatu t'ul-laabahaa",
          "english_text": "It destroys its pursuers,",
          "source_pair_start": 5,
          "source_pair_end": 5,
          "recitation_segment": {
            "id": "segment-005",
            "title": "Recitation segment 5",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-006",
          "sequence": 6,
          "arabic_text": "الْمُتْلِفَةُ حُلاَّلَها،",
          "transliteration": "al-mut-lifatu h'ul-laalahaa",
          "english_text": "and ruins its settlers,",
          "source_pair_start": 6,
          "source_pair_end": 6,
          "recitation_segment": {
            "id": "segment-006",
            "title": "Recitation segment 6",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-007",
          "sequence": 7,
          "arabic_text": "الْمَحْشُوَّةُ بِالآفاتِ،",
          "transliteration": "al-mah'-shoo-watu bil-aaafaati",
          "english_text": "it is stuffed with blights,",
          "source_pair_start": 7,
          "source_pair_end": 7,
          "recitation_segment": {
            "id": "segment-007",
            "title": "Recitation segment 7",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-008",
          "sequence": 8,
          "arabic_text": "الْمَشْحُونَةُ بِالنَّكَباتِ. ",
          "transliteration": "al-mash-h'oonaatu bin-nakabaat",
          "english_text": "and loaded with calamities.",
          "source_pair_start": 8,
          "source_pair_end": 8,
          "recitation_segment": {
            "id": "segment-008",
            "title": "Recitation segment 8",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-009",
          "sequence": 9,
          "arabic_text": "إِلـٰهِي فَزَهِّدْنا فِيها،",
          "transliteration": "ilaaheee fazah-hid-na feehaa",
          "english_text": "My God, induce us to renounce it",
          "source_pair_start": 9,
          "source_pair_end": 9,
          "recitation_segment": {
            "id": "segment-009",
            "title": "Recitation segment 9",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-010",
          "sequence": 10,
          "arabic_text": "وَسَلِّمْنا مِنْها بِتَوْفِيقِكَ وَعِصْمَتِكَ،",
          "transliteration": "wa sal-lim-naa min-haa bitaw-feeqika wa i's'-matika",
          "english_text": "and keep us safe from it by Your giving success and Your preservation from sin.",
          "source_pair_start": 10,
          "source_pair_end": 10,
          "recitation_segment": {
            "id": "segment-010",
            "title": "Recitation segment 10",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-011",
          "sequence": 11,
          "arabic_text": "وَانْزَعْ عَنَّا جَلابِيبَ مُخالَفَتِكَ،",
          "transliteration": "wa anz-aa' a'n-naa jalaabeeba mukhaalafatik",
          "english_text": "Strip from us the robes of opposing You,",
          "source_pair_start": 11,
          "source_pair_end": 11,
          "recitation_segment": {
            "id": "segment-011",
            "title": "Recitation segment 11",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-012",
          "sequence": 12,
          "arabic_text": "وَتَوَلَّ أُمُورَنا بِحُسْنِ كِفايَتِكَ،",
          "transliteration": "wa tawal-la umooranaa bih'us-ni kifaayatika",
          "english_text": "attend to our affairs through Your good sufficiency,",
          "source_pair_start": 12,
          "source_pair_end": 12,
          "recitation_segment": {
            "id": "segment-012",
            "title": "Recitation segment 12",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-013",
          "sequence": 13,
          "arabic_text": "وَأَوْفِرْ مَزِيدَنا مِنْ سَعَةِ رَحْمَتِكَ،",
          "transliteration": "wa aw-fir mazeedanaa min saa'ti rah'-matika",
          "english_text": "amplify our increase from the boundless plenty of Your mercy,",
          "source_pair_start": 13,
          "source_pair_end": 13,
          "recitation_segment": {
            "id": "segment-013",
            "title": "Recitation segment 13",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-014",
          "sequence": 14,
          "arabic_text": "وَأَجْمِلْ صِلاتِنا مِنْ فَيْضِ مَواهِبِكَ،",
          "transliteration": "wa aj-mil s'ilaati naa min fay-z''i mawaahibik",
          "english_text": "be liberal in our gifts from the overflow of Your grants,",
          "source_pair_start": 14,
          "source_pair_end": 14,
          "recitation_segment": {
            "id": "segment-014",
            "title": "Recitation segment 14",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-015",
          "sequence": 15,
          "arabic_text": "وَاغْرِسْ فِي أَفْئِدَتِنا أَشْجارَ مَحَبَّتِكَ،",
          "transliteration": "wagh-ris feee af-idatinaaa ash-jaara mah'ab-batik",
          "english_text": "plant in our hearts the trees of Your love,",
          "source_pair_start": 15,
          "source_pair_end": 15,
          "recitation_segment": {
            "id": "segment-015",
            "title": "Recitation segment 15",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-016",
          "sequence": 16,
          "arabic_text": "وَأَتْمِمْ لَنا أَنْوارَ مَعْرِفَتِكَ،",
          "transliteration": "wa at-mim lanaaa anwaara maa'-rifatik",
          "english_text": "complete for us the lights of Your knowledge,",
          "source_pair_start": 16,
          "source_pair_end": 16,
          "recitation_segment": {
            "id": "segment-016",
            "title": "Recitation segment 16",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-017",
          "sequence": 17,
          "arabic_text": "وَأَذِقْنا حَلاوَةَ عَفْوِكَ وَلَذَّةَ مَغْفِرَتِكَ،",
          "transliteration": "wa ad'iq-naa h'alaawata a'f-wika wa lad'-d'ata magh-firatik",
          "english_text": "give us to taste the sweetness of Your pardon and the pleasure of Your forgiveness,",
          "source_pair_start": 17,
          "source_pair_end": 17,
          "recitation_segment": {
            "id": "segment-017",
            "title": "Recitation segment 17",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-018",
          "sequence": 18,
          "arabic_text": "وَأَقْرِرْ أَعْيُنَنا يَوْمَ لِقائِكَ بِرُؤْيَتِكَ،",
          "transliteration": "wa aq-rir aa'-yunanaa yaw-ma liqaaa-ika biroo-yatik",
          "english_text": "gladden our eyes on the day of meeting You with the vision of You,",
          "source_pair_start": 18,
          "source_pair_end": 18,
          "recitation_segment": {
            "id": "segment-018",
            "title": "Recitation segment 18",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-019",
          "sequence": 19,
          "arabic_text": "وَأَخْرِجْ حُبَّ الدُّنْيا مِنْ قُلُوبِنا،",
          "transliteration": "wa akh-rij h'ub-bad-dunyaa min quloobinaa",
          "english_text": "dislodge the love of this world from our spirits,",
          "source_pair_start": 19,
          "source_pair_end": 19,
          "recitation_segment": {
            "id": "segment-019",
            "title": "Recitation segment 19",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-020",
          "sequence": 20,
          "arabic_text": "كَما فَعَلْتَ بِالصَّالِحِينَ مِنْ صَفْوَتِكَ،",
          "transliteration": "kama faa'l-ta bis'-s'aalih'eena min s'af-watika",
          "english_text": "just as You have done for the righteous, Your selected friends,",
          "source_pair_start": 20,
          "source_pair_end": 20,
          "recitation_segment": {
            "id": "segment-020",
            "title": "Recitation segment 20",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-021",
          "sequence": 21,
          "arabic_text": "وَالأَبْرارِ مِنْ خاصَّتِكَ!",
          "transliteration": "wal-ab-raari min khaaas'-s'atik",
          "english_text": "and for the pious, those whom You have singled out!",
          "source_pair_start": 21,
          "source_pair_end": 21,
          "recitation_segment": {
            "id": "segment-021",
            "title": "Recitation segment 21",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-022",
          "sequence": 22,
          "arabic_text": "يا أَرْحَمَ الرَّاحِمِينَ،",
          "transliteration": "yaa ar-h'amar-raah'imeen",
          "english_text": "O Most Merciful of the merciful,",
          "source_pair_start": 22,
          "source_pair_end": 22,
          "recitation_segment": {
            "id": "segment-022",
            "title": "Recitation segment 22",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        },
        {
          "id": "passage-023",
          "sequence": 23,
          "arabic_text": "وَيا أَكْرَمَ الأَكْرَمِينَ.",
          "transliteration": "wa yaaa ak-ramal-ak-rameen",
          "english_text": "O Most Generous of the most generous!",
          "source_pair_start": 23,
          "source_pair_end": 23,
          "recitation_segment": {
            "id": "segment-023",
            "title": "Recitation segment 23",
            "repeatable": true,
            "suggested_repetitions": 3,
            "pause_after": true
          }
        }
      ]
    }
  ]
}
