[{"id":"passage-121","sequence":121,"arabic_text":"يَا دَافِعَ النِّقَمِ","transliteration":"yā dāfiʿa al-niqam","english_text":"O Repeller of adversities!","source_pair_start":244,"source_pair_end":244,"recitation_segment":{"id":"segment-121","title":"Recitation segment 121","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-122","sequence":122,"arabic_text":"يَا نُورَ الْمُسْتَوْحِشِينَ فِي الظُّلَمِ","transliteration":"yā nūra al-mustawḥishīna fī aẓ-ẓulam","english_text":"O Light of those who are lonely in the darkness!","source_pair_start":245,"source_pair_end":245,"recitation_segment":{"id":"segment-122","title":"Recitation segment 122","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-123","sequence":123,"arabic_text":"يَا عَالِمًا لا يُعَلَّمُ","transliteration":"yā ʿāliman lā yuʿallamu","english_text":"O Knower who was never taught!","source_pair_start":246,"source_pair_end":246,"recitation_segment":{"id":"segment-123","title":"Recitation segment 123","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-124","sequence":124,"arabic_text":"صَلِّ عَلَى مُحَمَّدٍ وَّآلِ مُحَمَّدٍ","transliteration":"ṣalli ʿalā muḥammadin wa āli muḥammadin","english_text":"Bless Muhammad and Muhammad's household!","source_pair_start":247,"source_pair_end":247,"recitation_segment":{"id":"segment-124","title":"Recitation segment 124","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-125","sequence":125,"arabic_text":"وافْعَلْ بِي مَا أَنتَ أَهْلُهُ","transliteration":"wafʿal biy mā anta ahluhu","english_text":"And do with me what is worthy of You!","source_pair_start":248,"source_pair_end":248,"recitation_segment":{"id":"segment-125","title":"Recitation segment 125","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-126","sequence":126,"arabic_text":"وَصَلَّى اللَّهُ عَلَى رَسُولِهِ وَالأَئِمَّةِ الْمَيَامِينَ مِنْ آلِهِ وَسَلَّمَ تَسْلِيم