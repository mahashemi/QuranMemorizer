[{"id":"passage-091","sequence":91,"arabic_text":"يَا بْنَ الْخَضارِمَةِ الْمُنْتَجَبينَ","transliteration":"yā ibn al-khaḍārimah al-muntajabīn","english_text":"O Son of the impartial judges!","source_pair_start":141,"source_pair_end":141,"recitation_segment":{"id":"segment-091","title":"Recitation segment 91","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-092","sequence":92,"arabic_text":"يَا بْنَ الْقَماقِمَةِ الاَْكْرَمينَ (الأكْبَرينَ )","transliteration":"yā bn al-qamāqimati al-akramīn (al-akbarīn)","english_text":"O Son of the openhanded hosts!","source_pair_start":142,"source_pair_end":142,"recitation_segment":{"id":"segment-092","title":"Recitation segment 92","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-093","sequence":93,"arabic_text":"يَا بْنَ الْبُدُورِ الْمُنيرَةِ","transliteration":"yā bna al-budūri al-munīrah","english_text":"O Son of the mature teachers!","source_pair_start":143,"source_pair_end":143,"recitation_segment":{"id":"segment-093","title":"Recitation segment 93","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-094","sequence":94,"arabic_text":"يَا بْنَ السُّرُجِ الْمُضيئَةِ","transliteration":"yā bn al-surrūj al-muḍīʾah","english_text":"O Son of the brilliant fulfillers!","source_pair_start":144,"source_pair_end":144,"recitation_segment":{"id":"segment-094","title":"Recitation segment 94","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-095","sequence":95,"arabic_text":"يَا بْنَ الشُّهُبِ الثّاقِبَةِ","transliteration":"yā bna al-shuhubi al-ththāqibah","english_text":"O Son of the clear and precise arguments who penetrated deep (into the domain of mind)!","source_pair_start":145,"source_pair_end":145,"recitation_segment":{"id":"segment-095","title":"Recitation segment 95","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-096","sequence":96,"arabic_text":"يَا بْنَ الاَْنْجُمِ الزّاهِرَةِ","transliteration":"yā ibna al-anjumi al-zāhirati","english_text":"O inheritor of the made known prophesy!","source_pair_start":146,"source_pair_end":146,"recitation_segment":{"id":"segment-096","title":"Recitation segment 96","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-097","sequence":97,"arabic_text":"يَا بْنَ السُّبُلِ الْواضِحَةِ","transliteration":"yā ibna al-subuli al-wāḍiḥah","english_text":"O inheritor of the clear preaching!","source_pair_start":147,"source_pair_end":147,"recitation_segment":{"id":"segment-097","title":"Recitation segment 97","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-098","sequence":98,"arabic_text":"يَا بْنَ الاَْعْلامِ الّلائِحَةِ","transliteration":"yā ibna al-aʿlāmi al-lāʾiḥati","english_text":"O inheritor of the evident signs!","source_pair_start":148,"source_pair_end":148,"recitation_segment":{"id":"segment-098","title":"Recitation segment 98","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-099","sequence":99,"arabic_text":"يَا بْنَ الْعُلُومِ الْكامِلَةِ","transliteration":"yā ibn al-ʿulūm al-kāmilah","english_text":"O inheritor of the exact science!","source_pair_start":149,"source_pair_end":149,"recitation_segment":{"id":"segment-099","title":"Recitation segment 99","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-100","sequence":100,"arabic_text":"يَا بْنَ السُّنَنِ الْمَشْهُورَةِ","transliteration":"yā ibn al-sunnan al-mashhūrah","english_text":"O inheritor of the widely sought after culture and customs!","source_pair_start":150,"source_pair_end":150,"recitation_segment":{"id":"segment-100","title":"Recitation segment 100","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-101","sequence":101,"arabic_text":"يَا بْنَ الْمَعالِمِ الْمَأثُورَةِ","transliteration":"yā ibna al-maʿālimi al-maʾthūrah","english_text":"O inheritor of the milestones of glory and greatness!","source_pair_start":151,"source_pair_end":151,"recitation_segment":{"id":"segment-101","title":"Recitation segment 101","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-102","sequence":102,"arabic_text":"يَا بْنَ الْمُعْجِزاتِ الْمَوْجُودَةِ","transliteration":"yā ibn al-muʿjizāt al-mawjūdah","english_text":"O inheritor of the extraordinary events!","source_pair_start":152,"source_pair_end":152,"recitation_segment":{"id":"segment-102","title":"Recitation segment 102","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-103","sequence":103,"arabic_text":"يَا بْنَ الدَّلائِلِ الْمَشْهُودَةِ ( المَشْهُورَةِ )","transliteration":"yā ibna al-dalāʾili al-mashhūdah (al-mashhūrah)","english_text":"O inheritor of the reason that had been put to experiment!","source_pair_start":153,"source_pair_end":153,"recitation_segment":{"id":"segment-103","title":"Recitation segment 103","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-104","sequence":104,"arabic_text":"يَا بْنَ الصـِّراطِ الْمُسْتَقيمِ","transliteration":"yā ibna al-ṣirāṭ al-mustaqīm","english_text":"O inheritor of the Right Path!","source_pair_start":154,"source_pair_end":154,"recitation_segment":{"id":"segment-104","title":"Recitation segment 104","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-105","sequence":105,"arabic_text":"يَا بْنَ النَّبَأِ الْعَظيمِ","transliteration":"yā ibna al-nabaʾi al-ʿaẓīm","english_text":"O inheritor of the Message that made deep impression on mankind!","source_pair_start":155,"source_pair_end":155,"recitation_segment":{"id":"segment-105","title":"Recitation segment 105","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-106","sequence":106,"arabic_text":"يَا بْنَ مَنْ هُوَ في اُمِّ الْكِتابِ لَدَى اللهِ عَلِيٌّ حَكيمٌ","transliteration":"yā ibna man huwa fī umm al-kitāb ladayya allāhu ʿaliyyun hakīmun","english_text":"O Son of him who is in the \"Mother of the Book\" kept with Allah, the Highest High, the All-wise.","source_pair_start":156,"source_pair_end":156,"recitation_segment":{"id":"segment-106","title":"Recitation segment 106","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-107","sequence":107,"arabic_text":"يَا بْنَ الآياتِ وَ الْبَيِّناتِ","transliteration":"yā ibna al-ʾāyāti wa al-bayyināti","english_text":"O inheritor of the convincing proofs!","source_pair_start":157,"source_pair_end":157,"recitation_segment":{"id":"segment-107","title":"Recitation segment 107","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-108","sequence":108,"arabic_text":"يَا بْنَ الدَّلائِلِ الظّاهِراتِ","transliteration":"yā ibn al-dalāʾil al-ẓāhirāt","english_text":"O inheritor of the genuine evidence!","source_pair_start":158,"source_pair_end":158,"recitation_segment":{"id":"segment-108","title":"Recitation segment 108","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-109","sequence":109,"arabic_text":"يَا بْنَ الْبَراهينِ الْواضِحاتِ الْباهِراتِ","transliteration":"yā ibnal-barāhīn al-wāḍiḥāt al-bāhirāt","english_text":"O inheritor of the distinctly visible demonstration!","source_pair_start":159,"source_pair_end":159,"recitation_segment":{"id":"segment-109","title":"Recitation segment 109","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-110","sequence":110,"arabic_text":"يَا بْنَ الْحُجَجِ الْبالِغاتِ","transliteration":"yā ibna al-ḥujajil bāliġāt","english_text":"O inheritor of the decisive information!","source_pair_start":160,"source_pair_end":160,"recitation_segment":{"id":"segment-110","title":"Recitation segment 110","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-111","sequence":111,"arabic_text":"يَا بْنَ النِّعَمِ السّابِغاتِ","transliteration":"yā ibn al-niʿami al-sābighāt","english_text":"O inheritor of the absolute joy and happiness!","source_pair_start":161,"source_pair_end":161,"recitation_segment":{"id":"segment-111","title":"Recitation segment 111","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-112","sequence":112,"arabic_text":"يَا بْنَ طه وَ الْـمُحْكَماتِ","transliteration":"yā ibna ṭahā wal-muḥkamāt","english_text":"O inheritor of \"T’aa-haa\" and clear wisdom!","source_pair_start":162,"source_pair_end":162,"recitation_segment":{"id":"segment-112","title":"Recitation segment 112","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-113","sequence":113,"arabic_text":"يَا بْنَ يس وَ الذّارِياتِ يَا بْنَ الطُّورِ وَ الْعادِياتِ يَا بْنَ مَنْ دَنا فَتَدَلّى فَكانَ قابَ قَوْسَيْنِ اَوْ اَدْنى دُنُوّاً وَ اقْتِراباً مِنَ الْعَلِيِّ الاَْعْلى","transliteration":"yā ibna yis wa aldhāriyāt yā bn aṭ-ṭūr wa al-ʿādīyāt yā bin man danā fatadallā fakāna qāba qawsayni aw adnā dunuwān wa iqti'rāban min al-'aliyyi al-a'la","english_text":"O inheritor of \"Yaa seen\" and \"Zaariyaat\" O inheritor of \"T’oor\" and \"A’adiyaat\" O Son of him who \"drew near and came down till he was two bows’ length or nearer.\" (The Highest High came near and received him gladly).","source_pair_start":163,"source_pair_end":165,"recitation_segment":{"id":"segment-113","title":"Recitation segment 113","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-114","sequence":114,"arabic_text":"لَيْتَ شِعْري اَيْنَ اسْتَقَرَّتْ بِكَ النَّوى","transliteration":"layta shiʿri ʾayna istaqarrat bika al-nawá","english_text":"If I but knew the destination of your purposeful journey!","source_pair_start":166,"source_pair_end":166,"recitation_segment":{"id":"segment-114","title":"Recitation segment 114","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-115","sequence":115,"arabic_text":"بَلْ اَيُّ اَرْضٍ تُقِلُّكَ اَوْ ثَرى ، اَبِرَضْوى اَوْ غَيْرِها اَمْ ذي طُوى","transliteration":"bal ayyu arḍin tuqilluka aw tharā, abradwā aw ghayrihā am dhī ṭuwā","english_text":"To which isolated land did you go? Good, pleasant and satisfying? Or otherwise? Or in well guarded concealment?","source_pair_start":167,"source_pair_end":167,"recitation_segment":{"id":"segment-115","title":"Recitation segment 115","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-116","sequence":116,"arabic_text":"عَزيزٌ عَلَيَّ اَنْ اَرَى الْخَلْقَ وَ لا تُرى وَ لا اَسْمَعُ لَكَ حَسيساً وَ لا نَجْوى","transliteration":"ʿazīzun ʿalayy(a) an arā al-khalqa wa lā turā wa lā 'asmā'u laka ḥasīsan wa lā najwā","english_text":"It breaks my heart (when) I look at all that has been created, but cannot see you, nor hear a whisper about your whereabouts, nor any secret communication!","source_pair_start":168,"source_pair_end":169,"recitation_segment":{"id":"segment-116","title":"Recitation segment 116","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-117","sequence":117,"arabic_text":"عَزيزٌ عَلَيَّ اَنْ ( لا تُحِيطَ بِِيَ دُونكَ ) تُحيطَ بِكَ دُونِيَ الْبَلْوى وَ لا يَنالُكَ مِنّي ضَجيجٌ وَ لا شَكْوى","transliteration":"ʿazīzun ʿalayya ʾan (lā tuḥīṭa biya dūnaka) tuḥīṭa bika dūnī","english_text":"It is disheartening to know that you are attending to and watching over the disorder and confusion, and I, in the thick of violent turmoil, am far away, unable to give report of injustice.","source_pair_start":170,"source_pair_end":170,"recitation_segment":{"id":"segment-117","title":"Recitation segment 117","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-118","sequence":118,"arabic_text":"بِنَفْسي اَنْتَ مِنْ مُغَيَّبٍ لَمْ يَخْلُ مِنّا","transliteration":"bi-nafsi anta min mughayyabin lam yakhlu minna","english_text":"I eagerly long for you who is out of sight, but has not forsaken us.","source_pair_start":171,"source_pair_end":171,"recitation_segment":{"id":"segment-118","title":"Recitation segment 118","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-119","sequence":119,"arabic_text":"بِنَفْسي اَنْتَ مِنْ نازِحٍ ما نَزَحَ ( يَنْزِحُ ) عَنّا","transliteration":"bi-nafsi anta min nazihin ma nazaha (yanzihu) 'anna","english_text":"I eagerly long for you who has departed and is invisible, but is not far from us.","source_pair_start":172,"source_pair_end":172,"recitation_segment":{"id":"segment-119","title":"Recitation segment 119","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-120","sequence":120,"arabic_text":"بِنَفْسي اَنْتَ اُمْنِيَّةُ شائِقٍ يَتَمَنّى ، مِنْ مُؤْمِن وَ مُؤْمِنَةٍ ذَكَرا فَحَنّا","transliteration":"bi nafsi anta umniyyatu sha'iqin yatamannaa, min mu'minin wa mu'minatin dhakaran fahanna","english_text":"I eagerly long for you who inspires love and deep affection, and the faithful men and women take delight in your memorable glory. So we are excited with a longing desire.","source_pair_start":173,"source_pair_end":173,"recitation_segment":{"id":"segment-120","title":"Recitation segment 120","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
