[{"id":"passage-001","sequence":1,"arabic_text":"إِلـٰهِي أَلْبَسَتْنِي الْخَطايا ثَوْبَ مَذَلَّتِي،","transliteration":"ilaaheee al-basat-neel-khat'aayaa thaw-ba mad'al-latee","english_text":"My God, offenses have clothed me in the garment of my lowliness,","source_pair_start":1,"source_pair_end":1,"recitation_segment":{"id":"segment-001","title":"Recitation segment 1","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-002","sequence":2,"arabic_text":"وَجَلَّلَنِي التَّباعُدُ مِنْكَ لِباسَ مَسْكَنَتِي،","transliteration":"wa jal-lalaneet-tabaau'du minka libaasa mas-kanatee","english_text":"separation from You has wrapped me in the clothing of my misery!","source_pair_start":2,"source_pair_end":2,"recitation_segment":{"id":"segment-002","title":"Recitation segment 2","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-003","sequence":3,"arabic_text":"وَأَماتَ قَلْبِي عَظِيمُ جِنايَتِي،","transliteration":"wa amaata qal-bee a'z'eemu jinaayatee","english_text":"My dreadful crimes have deadened my heart,","source_pair_start":3,"source_pair_end":3,"recitation_segment":{"id":"segment-003","title":"Recitation segment 3","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-004","sequence":4,"arabic_text":"فَأَحْيِهِ بِتَوْبَةٍ مِنْكَ يا أَمَلِي وَبُغْيَتِي،","transliteration":"faah'-yihee bitaw-batim-minka yaaa amalee wa bugh-yatee","english_text":"so bring it to life by a repentance from You! O my hope and my aim!","source_pair_start":4,"source_pair_end":4,"recitation_segment":{"id":"segment-004","title":"Recitation segment 4","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-005","sequence":5,"arabic_text":"وَيا سُؤْلِي وَمُنْيَتِي،","transliteration":"wa yaa soo-lee wa munyatee","english_text":"O my wish and my want!","source_pair_start":5,"source_pair_end":5,"recitation_segment":{"id":"segment-005","title":"Recitation segment 5","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-006","sequence":6,"arabic_text":"فَوَعِزَّتِكَ ما أَجِدُ لِذُنُوبِي سِواكَ غافِراً،","transliteration":"fawai'z-zatik maaa ajidu lid'unoobee siwaaka ghafiraa","english_text":"By Your might, I find no one but You to forgive my sins","source_pair_start":6,"source_pair_end":6,"recitation_segment":{"id":"segment-006","title":"Recitation segment 6","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-007","sequence":7,"arabic_text":"وَلا أَرَىٰ لِكَسْرِي غَيْرَكَ جابِراً،","transliteration":"wa laaa araa likas-ree ghay-raka jaabiraa","english_text":"and I see none but You to mend my brokenness!","source_pair_start":7,"source_pair_end":7,"recitation_segment":{"id":"segment-007","title":"Recitation segment 7","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-008","sequence":8,"arabic_text":"وَقَدْ خَضَعْتُ بِالإِنابَةِ إلَيْكَ،","transliteration":"wa qad khaz''aa'-tu bil-inaabati ilay-k","english_text":"I have subjected myself to You in repeated turning,","source_pair_start":8,"source_pair_end":8,"recitation_segment":{"id":"segment-008","title":"Recitation segment 8","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-009","sequence":9,"arabic_text":"وَعَنَوْتُ بِالاسْتِكانَةِ لَدَيْكَ،","transliteration":"wa a'naw-tu bilis-tikaanati laday-k","english_text":"I have humbled myself to You in abasement.","source_pair_start":9,"source_pair_end":9,"recitation_segment":{"id":"segment-009","title":"Recitation segment 9","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-010","sequence":10,"arabic_text":"فَإنْ طَرَدْتَنِي مِنْ بابِكَ فَبِمَنْ أَلُوذُ؟","transliteration":"fa in t'arat-tanee mim-baabika fabiman alood'","english_text":"If You cast me out from Your door, in whom shall I take shelter?","source_pair_start":10,"source_pair_end":10,"recitation_segment":{"id":"segment-010","title":"Recitation segment 10","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-011","sequence":11,"arabic_text":"وَإنْ رَدَدْتَنِي عَنْ جَنابِكَ فَبِمَنْ أَعُوذُ؟","transliteration":"wa ir-radat-tanee a'n janaabika fabiman au'wd'","english_text":"If You repel me from Your side, in whom shall I seek refuge?","source_pair_start":11,"source_pair_end":11,"recitation_segment":{"id":"segment-011","title":"Recitation segment 11","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-012","sequence":12,"arabic_text":"فَوَا أَسَفاهُ مِنْ خَجْلَتِي وَافْتِضاحِي،","transliteration":"fawaaa asafaahoo min khaj-latee wa af-tiz''aah'ee","english_text":"O my grief at my ignominy and disgrace!","source_pair_start":12,"source_pair_end":12,"recitation_segment":{"id":"segment-012","title":"Recitation segment 12","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-013","sequence":13,"arabic_text":"وَوا لَهْفاهُ مِنْ سُوءِ عَمَلِي وَاجْتِراحِي. ","transliteration":"wa waa lah-fahoo min sooo-i a'malee wa aj-tiraah'ee","english_text":"O my sorrow at my evil works and what I have committed!","source_pair_start":13,"source_pair_end":13,"recitation_segment":{"id":"segment-013","title":"Recitation segment 13","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-014","sequence":14,"arabic_text":"أَسْأَلُكَ يا غافِرَ الذَّنْبِ الْكَبِيرِ،","transliteration":"as-aluka yaa ghaafirad'-d'ambil-kabeer","english_text":"I ask You, O Forgiver of great sins,","source_pair_start":14,"source_pair_end":14,"recitation_segment":{"id":"segment-014","title":"Recitation segment 14","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-015","sequence":15,"arabic_text":"وَيا جابِرَ الْعَظْمِ الْكَسِيرِ،","transliteration":"wa yaa jaabiral-a'z'-mil-kaseer","english_text":"O Mender of broken bones,","source_pair_start":15,"source_pair_end":15,"recitation_segment":{"id":"segment-015","title":"Recitation segment 15","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-016","sequence":16,"arabic_text":"أَنْ تَهَبَ لِي مُوبِقاتِ الْجَرائِرِ،","transliteration":"an tahaba lee moobiqaatil-jaraaa-ir","english_text":"to overlook my ruinous misdeeds","source_pair_start":16,"source_pair_end":16,"recitation_segment":{"id":"segment-016","title":"Recitation segment 16","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-017","sequence":17,"arabic_text":"وَتَسْتُرَ عَلَيَّ فاضِحاتِ السَّرائِرِ،","transliteration":"wa tas-tura a'lay-ya faaz''ih'aatis-saraaa-ir","english_text":"and cover my disgraceful secret thoughts!","source_pair_start":17,"source_pair_end":17,"recitation_segment":{"id":"segment-017","title":"Recitation segment 17","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-018","sequence":18,"arabic_text":"وَلا تُخْلِنِي فِي مَشْهَدِ الْقِيامَةِ مِنْ بَرْدِ عَفْوِكَ وَغَفْرِكَ،","transliteration":"wa laa tukh-linee fee mash-hadil-qeeaamati mim-bar-di a'f-wika wa ghaf-rik","english_text":"At the witnessing place of the Resurrection, empty me not of the coolness of Your pardon and forgiveness,","source_pair_start":18,"source_pair_end":18,"recitation_segment":{"id":"segment-018","title":"Recitation segment 18","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-019","sequence":19,"arabic_text":"وَلا تُعْرِنِي مِنْ جَمِيلِ صَفْحِكَ وَسَتْرِكَ. ","transliteration":"wa laa tua'-rinee min jameeli s'af-h'ika wa sat-rik","english_text":"and strip me not of Your beautiful forbearance and covering!","source_pair_start":19,"source_pair_end":19,"recitation_segment":{"id":"segment-019","title":"Recitation segment 19","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-020","sequence":20,"arabic_text":"إِلـٰهِي ظَلِّلْ عَلَىٰ ذُنُوبِي غَمامَ رَحْمَتِكَ،","transliteration":"ilaahee z'al-lil a'laa d'unoobee ghamaama rah'-matika","english_text":"My God, let the cloud of Your mercy cast its shadow upon my sins","source_pair_start":20,"source_pair_end":20,"recitation_segment":{"id":"segment-020","title":"Recitation segment 20","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-021","sequence":21,"arabic_text":"وَأَرْسِلْ عَلىٰ عُيُوبِي سَحابَ رَأْفَتِكَ،","transliteration":"wa ar-sil a'laa u'yoobee sah'aaba raa-fatik","english_text":"and send the billow of Your clemency flowing over my faults!","source_pair_start":21,"source_pair_end":21,"recitation_segment":{"id":"segment-021","title":"Recitation segment 21","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-022","sequence":22,"arabic_text":"إِلـٰهِي هَلْ يَرْجِعُ الْعَبْدُ الأَبِقُ إلاَّ إلَىٰ مَوْلاهُ؟","transliteration":"ilaahee hal yar-jiu'l-a'b-dul-aaabiqu il-laaa ilaa maw-laahoo","english_text":"My God, does the fugitive servant return to anyone other than his Master?","source_pair_start":22,"source_pair_end":22,"recitation_segment":{"id":"segment-022","title":"Recitation segment 22","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-023","sequence":23,"arabic_text":"أَمْ هَلْ يُجِيرُهُ مِنْ سَخَطِهِ أَحَدٌ سِواهُ؟","transliteration":"am hal yujeeruhoo min sakhat'iheee ah'dun siwaah","english_text":"Or does anyone grant him sanctuary from his Master's wrath other than his Master Himself?","source_pair_start":23,"source_pair_end":23,"recitation_segment":{"id":"segment-023","title":"Recitation segment 23","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-024","sequence":24,"arabic_text":"إِلـٰهِي إنْ كانَ النَّدَمُ عَلَىٰ الذَّنْبِ تَوْبَةً،","transliteration":"ilaahee in kanan-nadamu a'laad'-d'ambi taw-batan","english_text":"My God, if remorse for sins is a repentance,","source_pair_start":24,"source_pair_end":24,"recitation_segment":{"id":"segment-024","title":"Recitation segment 24","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-025","sequence":25,"arabic_text":"فَإِنِّي وَعِزَّتِكَ مِنَ النَّادِمِينَ،","transliteration":"fa in-nee wa i'z-zatika minan-naadimeen","english_text":"I - by Your might - am one of the remorseful!","source_pair_start":25,"source_pair_end":25,"recitation_segment":{"id":"segment-025","title":"Recitation segment 25","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-026","sequence":26,"arabic_text":"وَإِنْ كانَ الاسْتِغْفارُ مِنَ الْخَطيئَةِ حِطَّةً،","transliteration":"wa in kaanalis-tigh-faaru minal-khat'ee-ati h'it'-t'atan","english_text":"If praying forgiveness for offenses is an alleviation,","source_pair_start":26,"source_pair_end":26,"recitation_segment":{"id":"segment-026","title":"Recitation segment 26","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-027","sequence":27,"arabic_text":"فَإِنِّي لَكَ مِنَ الْمُسْتَغْفِرِينَ،","transliteration":"fa in-nee laka minal-mus-tagh-fireena","english_text":"I am one of those who pray forgiveness!","source_pair_start":27,"source_pair_end":27,"recitation_segment":{"id":"segment-027","title":"Recitation segment 27","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-028","sequence":28,"arabic_text":"لَكَ الْعُتْبىٰ حَتَّىٰ تَرْضَىٰ. ","transliteration":"lakal-u't-baa h'at-taa tar-z''aa","english_text":"To You I return that You may be well pleased!","source_pair_start":28,"source_pair_end":28,"recitation_segment":{"id":"segment-028","title":"Recitation segment 28","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-029","sequence":29,"arabic_text":"إِلـٰهِي بِقُدْرَتِكَ عَلَيَّ تُبْ عَلَيَّ،","transliteration":"ilaahee biqud-ratika a'lay-ya tub a'lay","english_text":"My God, through Your power over me, turn toward me,","source_pair_start":29,"source_pair_end":29,"recitation_segment":{"id":"segment-029","title":"Recitation segment 29","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-030","sequence":30,"arabic_text":"وَبِحِلْمِكَ عَنِّي اعْفُ عَنِّي،","transliteration":"wa bih'il-mika a'n-nee aa'-fu a'n-nee","english_text":"through Your clemency toward me, pardon me,","source_pair_start":30,"source_pair_end":30,"recitation_segment":{"id":"segment-030","title":"Recitation segment 30","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
