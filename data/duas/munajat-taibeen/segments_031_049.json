[{"id":"passage-031","sequence":31,"arabic_text":"وَبِعِلْمِكَ بِي ارْفُقْ بِي. ","transliteration":"wa bii'l-mika bee ar-fuq bee","english_text":"and through Your knowledge of me, be gentle toward me!","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"إِلـٰهِي أَنْتَ الَّذِي فَتَحْتَ لِعِبادِكَ باباً إلَىٰ عَفْوِكَ سَمَّيْتَهُ التَّوْبَةَ،","transliteration":"ilaaheee antal-lad'ee fatah'-ta lii'baadika baaban ilaa a'f-wika sam-may-tahut-taw-bata","english_text":"My God, You are He who has opened a door to Your pardon and named it 'repentance',","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"فَقُلْتَ تُوبُوا إلَىٰ اللَّهِ تَوْبَةً نَصُوحاً،","transliteration":"faqul-ta tooboo ilaal-laahee taw-batan-nas'ooh'a","english_text":"for You said, Repent to God with unswerving repentance.","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"فَما عُذْرُ مَنْ أَغْفَلَ دُخُولَ الْبابِ بَعْدَ فَتْحِهِ؟","transliteration":"famaa u'd'-ru man agh-fala dukhoolal-baabi baa'-da fat-h'ih","english_text":"What is the excuse of him who remains heedless of entering the door after its opening?","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"إِلـٰهِي إنْ كانَ قَبُحَ الذَّنْبُ مِنْ عَبْدِكَ،","transliteration":"ilaaheee in kaana qabuh'ad'-d'ambu min a'b-dika","english_text":"My God, though the sins of Your servant are ugly,","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"فَلْيَحْسُنِ الْعَفْوُ مِنْ عِنْدِكَ. ","transliteration":"fal-yah'-sunil-a'f-wu min i'ndik","english_text":"Your pardon is beautiful.","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"إِلـٰهِي ما أَنَا بِأَوَّلِ مَنْ عَصاكَ فَتُبْتَ عَلَيْهِ،","transliteration":"ilaahee maaa ana biw-wali man- a's'aaka fatub-ta a'lay-h","english_text":"My God, I am not the first to have disobeyed You, and You turned toward him,","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"وَتَعَرَّضَ لِمَعْرُوفِكَ فَجُدْتَ عَلَيْهِ،","transliteration":"wa taa'r-raz''a limaa'-roofika fajud-ta a'lay-h","english_text":"or to have sought to attain Your favour, and You were munificent toward him.","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-039","sequence":39,"arabic_text":"يا مُجِيبَ الْمُضْطَرِّ،","transliteration":"yaa mujeebal-muz''-t'ar","english_text":"O Responder to the distressed!","source_pair_start":39,"source_pair_end":39,"recitation_segment":{"id":"segment-039","title":"Recitation segment 39","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-040","sequence":40,"arabic_text":"يا كاشِفَ الضُّرِّ،","transliteration":"yaa kaashifaz''-z''ur","english_text":"O Remover of injury!","source_pair_start":40,"source_pair_end":40,"recitation_segment":{"id":"segment-040","title":"Recitation segment 40","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-041","sequence":41,"arabic_text":"يا عَظِيمَ الْبِرِّ،","transliteration":"yaa a'z'eemal-bir","english_text":"O Great in goodness!","source_pair_start":41,"source_pair_end":41,"recitation_segment":{"id":"segment-041","title":"Recitation segment 41","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-042","sequence":42,"arabic_text":"يا عَلِيماً بِما فِي السِّرِّ،","transliteration":"yaa a'leeman bemaa fis-sir","english_text":"O Knower of everything secret!","source_pair_start":42,"source_pair_end":42,"recitation_segment":{"id":"segment-042","title":"Recitation segment 42","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-043","sequence":43,"arabic_text":"يا جَمِيلَ السِّتْرِ،","transliteration":"yaa jameelas-sit-r","english_text":"O Beautiful through covering over!","source_pair_start":43,"source_pair_end":43,"recitation_segment":{"id":"segment-043","title":"Recitation segment 43","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-044","sequence":44,"arabic_text":"اسْتَشْفَعْتُ بِجُودِكَ وَكَرَمِكَ إلَيْكَ،","transliteration":"is-tash-faa'-tu bijoodika wa karamika ilay-k","english_text":"I seek Your munificence and Your generosity to intercede with You,","source_pair_start":44,"source_pair_end":44,"recitation_segment":{"id":"segment-044","title":"Recitation segment 44","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-045","sequence":45,"arabic_text":"وَتَوَسَّلْتُ بِجَنابِكَ وَتَرَحُّمِكَ لَدَيْكَ،","transliteration":"wa tawas-sal-tu bijanabika wa tarah'-h'umika laday-ka","english_text":"I seek Your side and Your showing mercy to mediate with You,","source_pair_start":45,"source_pair_end":45,"recitation_segment":{"id":"segment-045","title":"Recitation segment 45","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-046","sequence":46,"arabic_text":"فَاسْتَجِبْ دُعائِي،","transliteration":"fas-tajib dua'aa-ee","english_text":"so grant my supplication,","source_pair_start":46,"source_pair_end":46,"recitation_segment":{"id":"segment-046","title":"Recitation segment 46","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-047","sequence":47,"arabic_text":"وَلا تُخَيِّبْ فِيكَ رَجائِي،","transliteration":"wa laa tukhay-yib feeka rajaaa-ee","english_text":"disappoint not my hope in You,","source_pair_start":47,"source_pair_end":47,"recitation_segment":{"id":"segment-047","title":"Recitation segment 47","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-048","sequence":48,"arabic_text":"وَتَقَبَّلْ تَوْبَتِي،","transliteration":"wa taqab-bal taw-batee","english_text":"accept my repentance,","source_pair_start":48,"source_pair_end":48,"recitation_segment":{"id":"segment-048","title":"Recitation segment 48","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-049","sequence":49,"arabic_text":"وَكَفِّرْ خَطيئَتِي بِمَنِّكَ وَرَحْمَتِكَ يا أَرْحَمَ الرَّاحِمِينَ.","transliteration":"wa kaf-fir khat'ee-atee biman-nika wa rah'-matika yaaa ar-h'amar-raah'imeen","english_text":"and hide my offense, through Your kindness and mercy, O Most Merciful of the merciful!","source_pair_start":49,"source_pair_end":49,"recitation_segment":{"id":"segment-049","title":"Recitation segment 49","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
