[{"id":"passage-061","sequence":61,"arabic_text":"اَلسَّلامُ عَلى حُجَّةِ رَبِّ الْعالَمينَ،","transliteration":"assalāmu alā ħujjati rabbil ālamīn,","english_text":"Peace be upon the Proof of the Lord of the worlds.","source_pair_start":61,"source_pair_end":61,"recitation_segment":{"id":"segment-061","title":"Recitation segment 61","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-062","sequence":62,"arabic_text":"اَلسَّلامُ عَلَيْكَ وَ عَلى آبائِكَ الطّاهِرينَ،","transliteration":"assalāmu alayka wa alā ābā'ikaţ-ţāhirīn,","english_text":"Peace be upon you and upon your pure ancestors.","source_pair_start":62,"source_pair_end":62,"recitation_segment":{"id":"segment-062","title":"Recitation segment 62","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-063","sequence":63,"arabic_text":"اَلسَّلامُ عَلَيْكَ وَ عَلى أبْنائِكَ الْمُسْتَشْهَدينَ،","transliteration":"assalāmu alayka wa alā 'abnā'ikal mustash-hadīn,","english_text":"Peace be upon you and upon your martyred sons.","source_pair_start":63,"source_pair_end":63,"recitation_segment":{"id":"segment-063","title":"Recitation segment 63","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-064","sequence":64,"arabic_text":"اَلسَّلامُ عَلَيْكَ وَ عَلى ذُرِّيَّتِكَ النّاصِرينَ،","transliteration":"assalāmu alayka wa alā dhurriyyatikan-nāširīn,","english_text":"Peace be upon you and upon your children who aided (you).","source_pair_start":64,"source_pair_end":64,"recitation_segment":{"id":"segment-064","title":"Recitation segment 64","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-065","sequence":65,"arabic_text":"اَلسَّلامُ عَلَيْكَ وَ عَلَى الْمَلائِكَةِ الْمُضاجِعينَ،","transliteration":"assalāmu alayka wa alal malā'ikatil muđhājiīn,","english_text":"Peace be upon you and upon the accompanying Angels.","source_pair_start":65,"source_pair_end":65,"recitation_segment":{"id":"segment-065","title":"Recitation segment 65","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-066","sequence":66,"arabic_text":"اَلسَّلامُ عَلَى الْقَتيلِ الْمَظْلُومِ،","transliteration":"assalāmu alal qatīlil mađlūm,","english_text":"Peace be upon the slain and the oppressed one.","source_pair_start":66,"source_pair_end":66,"recitation_segment":{"id":"segment-066","title":"Recitation segment 66","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-067","sequence":67,"arabic_text":"اَلسَّلامُ عَلى أخيهِ الْمَسْمُومِ،","transliteration":"assalāmu alā 'akhīhil masmūm,","english_text":"Peace be upon his poisoned brother (Imam al-Hasan).","source_pair_start":67,"source_pair_end":67,"recitation_segment":{"id":"segment-067","title":"Recitation segment 67","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-068","sequence":68,"arabic_text":"اَلسَّلامُ عَلى عَلِيٍّ الْكَبيرِ،","transliteration":"assalāmu alā aliyyinil kabīr,","english_text":"Peace be upon Ali, the elder (Ali al-Akbar).","source_pair_start":68,"source_pair_end":68,"recitation_segment":{"id":"segment-068","title":"Recitation segment 68","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-069","sequence":69,"arabic_text":"اَلسَّلامُ عَلَى الرَّضيعِ الصَّغيرِ،","transliteration":"assalāmu alar-rađhīiš-šaghīr,","english_text":"Peace be upon the suckling infant (Ali al-Asghar).","source_pair_start":69,"source_pair_end":69,"recitation_segment":{"id":"segment-069","title":"Recitation segment 69","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-070","sequence":70,"arabic_text":"اَلسَّلامُ عَلَى الأبْدانِ السَّليبَةِ،","transliteration":"assalāmu alal abdānis-salība,","english_text":"Peace be upon the plundered bodies.","source_pair_start":70,"source_pair_end":70,"recitation_segment":{"id":"segment-070","title":"Recitation segment 70","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-071","sequence":71,"arabic_text":"اَلسَّلامُ عَلَى الْعِتْرَةِ الْقَريبَةِ [الْغََريبَةِ]،","transliteration":"assalāmu alal itratil qarība [gharība],","english_text":"Peace be upon the family and children who were nearby (the place of martyrdom) [who where without support among strangers].","source_pair_start":71,"source_pair_end":71,"recitation_segment":{"id":"segment-071","title":"Recitation segment 71","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-072","sequence":72,"arabic_text":"اَلسَّلامُ عَلَى الْمُجَدَّلينَ فِي الْفَلَواتِ،","transliteration":"assalāmu alal mujaddalīna fil falawāt,","english_text":"Peace be upon the mangled corpses (left) in the desert.","source_pair_start":72,"source_pair_end":72,"recitation_segment":{"id":"segment-072","title":"Recitation segment 72","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-073","sequence":73,"arabic_text":"اَلسَّلامُ عَلَى النّازِحينَ عَنِ الأوْطانِ،","transliteration":"assalāmu alan-nāziħīna anil 'awţān,","english_text":"Peace be upon those who were left far from their homeland.","source_pair_start":73,"source_pair_end":73,"recitation_segment":{"id":"segment-073","title":"Recitation segment 73","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-074","sequence":74,"arabic_text":"اَلسَّلامُ عَلَى الْمَدْفُونينَ بِلا أكْفان،","transliteration":"assalāmu alal madfūnīna bilā 'akfān,","english_text":"Peace be upon those who were buried without shrouds.","source_pair_start":74,"source_pair_end":74,"recitation_segment":{"id":"segment-074","title":"Recitation segment 74","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-075","sequence":75,"arabic_text":"اَلسَّلامُ عَلَى الرُّؤُوسِ الْمُفَرَّقَةِ عَنِ الأبْدانِ،","transliteration":"assalāmu alar-ru'ūsil muffarraqati anil 'abdān,","english_text":"Peace be upon the heads severed from the bodies.","source_pair_start":75,"source_pair_end":75,"recitation_segment":{"id":"segment-075","title":"Recitation segment 75","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-076","sequence":76,"arabic_text":"اَلسَّلامُ عَلَى الْمُحْتَسِبِ الصّابِرِ،","transliteration":"assalāmu alal muħtasibiš-šābir,","english_text":"Peace be upon the bereaved and the patient one.","source_pair_start":76,"source_pair_end":76,"recitation_segment":{"id":"segment-076","title":"Recitation segment 76","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-077","sequence":77,"arabic_text":"اَلسَّلامُ عَلَى الْمَظْلُومِ بِلا ناصِر،","transliteration":"assalāmu alal mađlūmi bilā nāšir,","english_text":"Peace be upon the oppressed one who was without a helper.","source_pair_start":77,"source_pair_end":77,"recitation_segment":{"id":"segment-077","title":"Recitation segment 77","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-078","sequence":78,"arabic_text":"اَلسَّلامُ عَلى ساكِنِ التُّرْبَةِ الزّاكِيَةِ،","transliteration":"assalāmu alā sākinit-turbatiz-zākiya,","english_text":"Peace be upon the inhabitant of the purified soil.","source_pair_start":78,"source_pair_end":78,"recitation_segment":{"id":"segment-078","title":"Recitation segment 78","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-079","sequence":79,"arabic_text":"اَلسَّلامُ عَلى صاحِبِ الْقُبَّةِ السّامِيَةِ،","transliteration":"assalāmu alā šāħibil qubbatis-sāmiya,","english_text":"Peace be upon the possessor of the lofty dome.","source_pair_start":79,"source_pair_end":79,"recitation_segment":{"id":"segment-079","title":"Recitation segment 79","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-080","sequence":80,"arabic_text":"اَلسَّلامُ عَلى مَنْ طَهَّرَهُ الْجَليلُ،","transliteration":"assalāmu alā man ţahharahul jalīl,","english_text":"Peace be upon him, whom the Almighty purified.","source_pair_start":80,"source_pair_end":80,"recitation_segment":{"id":"segment-080","title":"Recitation segment 80","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-081","sequence":81,"arabic_text":"اَلسَّلامُ عَلى مَنِ افْتَخَرَ بِهِ جَبْرَئيلُ،","transliteration":"assalāmu alā maniftakhara bihi jabra'īl,","english_text":"Peace be upon him, of whom Gabriel (Jabra’il) was proud.","source_pair_start":81,"source_pair_end":81,"recitation_segment":{"id":"segment-081","title":"Recitation segment 81","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-082","sequence":82,"arabic_text":"اَلسَّلامُ عَلى مَنْ ناغاهُ فِي الْمَهْدِ ميكائيلُ،","transliteration":"assalāmu alā man nāghāhu fil mahdi mīkā'īl,","english_text":"Peace be upon the one to whom Michael (Mika’il) spoke tenderly in the cradle.","source_pair_start":82,"source_pair_end":82,"recitation_segment":{"id":"segment-082","title":"Recitation segment 82","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-083","sequence":83,"arabic_text":"اَلسَّلامُ عَلى مَنْ نُكِثَتْ ذِمَّتُهُ،","transliteration":"assalāmu alā man nukithat dhimmatuh,","english_text":"Peace be upon the one whose pact was broken.","source_pair_start":83,"source_pair_end":83,"recitation_segment":{"id":"segment-083","title":"Recitation segment 83","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-084","sequence":84,"arabic_text":"اَلسَّلامُ عَلى مَنْ هُتِكَتْ حُرْمَتُهُ،","transliteration":"assalāmu alā man hutikat ħurmatuh,","english_text":"Peace be upon the one whose rights and dignity were violated.","source_pair_start":84,"source_pair_end":84,"recitation_segment":{"id":"segment-084","title":"Recitation segment 84","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-085","sequence":85,"arabic_text":"اَلسَّلامُ عَلى مَنْ اُريقَ بِالظُّلْمِ دَمُهُ،","transliteration":"assalāmu alā man 'urīqa biđ-đulmi damuh,","english_text":"Peace be upon the one whose blood was shed unjustly.","source_pair_start":85,"source_pair_end":85,"recitation_segment":{"id":"segment-085","title":"Recitation segment 85","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-086","sequence":86,"arabic_text":"اَلسَّلامُ عَلَى الْمُغَسَّلِ بِدَمِ الْجِراحِ،","transliteration":"assalāmu alal mughassali bidamil jirāħ,","english_text":"Peace be upon the one who was bathed in the blood of his wounds.","source_pair_start":86,"source_pair_end":86,"recitation_segment":{"id":"segment-086","title":"Recitation segment 86","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-087","sequence":87,"arabic_text":"اَلسَّلامُ عَلَى الْمُجَرَّعِ بِكَأْساتِ الرِّماحِ،","transliteration":"assalāmu alal mujarrai bika'sātir-rimāħ,","english_text":"Peace be upon the one who tasted the spears raining down over his body.","source_pair_start":87,"source_pair_end":87,"recitation_segment":{"id":"segment-087","title":"Recitation segment 87","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-088","sequence":88,"arabic_text":"اَلسَّلامُ عَلَى الْمُضامِ الْمُسْتَباحِ،","transliteration":"assalāmu alal muđhāmil mustabāħ,","english_text":"Peace be upon the one against whom people came together and made lawful the shedding of his blood.","source_pair_start":88,"source_pair_end":88,"recitation_segment":{"id":"segment-088","title":"Recitation segment 88","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-089","sequence":89,"arabic_text":"اَلسَّلامُ عَلَى الْمَنْحُورِ فِي الْوَرى،","transliteration":"assalāmu alal manħūri fil warā,","english_text":"Peace be upon the one slaughtered in public.","source_pair_start":89,"source_pair_end":89,"recitation_segment":{"id":"segment-089","title":"Recitation segment 89","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-090","sequence":90,"arabic_text":"اَلسَّلامُ عَلى مَنْ دَفَنَهُ أهْلُ الْقُرى،","transliteration":"assalāmu alā man dafanahu 'ahlul qurā,","english_text":"Peace be upon the one who was buried by the strangers from (nearby) villages.","source_pair_start":90,"source_pair_end":90,"recitation_segment":{"id":"segment-090","title":"Recitation segment 90","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
