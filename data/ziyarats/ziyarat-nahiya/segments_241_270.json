[{"id":"passage-241","sequence":241,"arabic_text":"وَالتَّحْريمُ وَ التَّحْليلُ، وَ التَّنْزيلُ وَ التَّأْويلُ،","transliteration":"wat-taħrīmu wat-taħlīl, wat-tanzīlu wat-ta'wīl,","english_text":"His prohibitions, sanctions, revelation, and interpretation were lost.","source_pair_start":242,"source_pair_end":242,"recitation_segment":{"id":"segment-241","title":"Recitation segment 241","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-242","sequence":242,"arabic_text":"وَ ظَهَرَ بَعْدَكَ التَّغْييرُ وَ التَّبْديلُ، وَ الإلْحادُ وَ التَّعْطيلُ، وَ الأهْواءُ وَ الأضاليلُ، وَ الْفِتَنُ وَ الأباطيلُ،","transliteration":"wa đahara badakat-taghyīru wat-tabdīl, wal 'ilħādu wat-taţīl, wal 'ahwā'u wal 'ađhālīl, wal fitanu wal 'abāţīl,","english_text":"After you, alteration, distortion, infidelity, abandonment (of the Islamic laws), vagary, misguidance, turmoil and falsehood became prevalent.","source_pair_start":243,"source_pair_end":243,"recitation_segment":{"id":"segment-242","title":"Recitation segment 242","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-243","sequence":243,"arabic_text":"فَقامَ ناعيكَ عِنْدَ قَبْرِ جَدِّكَ الرَّسُولِ صَلَّى اللهُ عَلَيْهِ وَ آلِهِ،","transliteration":"faqāma nāīka inda qabri jaddikar-rasūli, šallal-lāhu layhi wa ālih,","english_text":"The announcer of your martyrdom came near the grave of your grandfather, the Messenger (PBUH&HF),","source_pair_start":244,"source_pair_end":244,"recitation_segment":{"id":"segment-243","title":"Recitation segment 243","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-244","sequence":244,"arabic_text":"فَنَعاكَ إلَيْهِ بِالدَّمْعِ الْهَطُولِ، قائِلا:","transliteration":"fanaāka 'ilayhi biddamil haţūli, qā'ilan:","english_text":"gave the news to him with tears flowing, saying:","source_pair_start":245,"source_pair_end":245,"recitation_segment":{"id":"segment-244","title":"Recitation segment 244","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-245","sequence":245,"arabic_text":"يا رَسُولَ اللهِ، قُتِلَ سِبْطُكَ وَ فَتاكَ،","transliteration":"ya rasūlal-lāh, qutila sibţuka wa fatāk,","english_text":"0 the Messenger of Allah! Your brave grandson was slain,","source_pair_start":246,"source_pair_end":246,"recitation_segment":{"id":"segment-245","title":"Recitation segment 245","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-246","sequence":246,"arabic_text":"وَ اسْتُبيحَ أهْلُكَ وَ حِماكَ،","transliteration":"was-tubīħa 'ahluka wa ħimāk,","english_text":"and abuse of your family and supporters were deemed lawful.","source_pair_start":247,"source_pair_end":247,"recitation_segment":{"id":"segment-246","title":"Recitation segment 246","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-247","sequence":247,"arabic_text":"وَ سُبِيَتْ بَعْدَكَ ذَراريكَ،","transliteration":"wa subiyat badaka dharārīk,","english_text":"After you, your progeny were captured,","source_pair_start":248,"source_pair_end":248,"recitation_segment":{"id":"segment-247","title":"Recitation segment 247","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-248","sequence":248,"arabic_text":"وَ وَقَعَ الْمَحْذُورُ بِعِتْرَتِكَ وَ ذَويكَ،","transliteration":"wa waqaal maħdhūru biitratika wa dhawīk,","english_text":"and adversity befell your family and your offspring.","source_pair_start":249,"source_pair_end":249,"recitation_segment":{"id":"segment-248","title":"Recitation segment 248","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-249","sequence":249,"arabic_text":"فَانْزَعَجَ الرَّسُولُ، وَ بَكى قَلْبُهُ الْمَهُولُ،","transliteration":"fanzaajar-rasūl, wa bakā qalbuhul mahūl,","english_text":"Indeed, the Messenger (PBUH&HF) became distressed and his depressed heart wept,","source_pair_start":250,"source_pair_end":250,"recitation_segment":{"id":"segment-249","title":"Recitation segment 249","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-250","sequence":250,"arabic_text":"وَ عَزّاهُ بِكَ الْمَلائِكَةُ وَ الأنْبِياءُ،","transliteration":"wa azzāhu bikal malā'ikatu wal 'anbiyā',","english_text":"The Angels and the prophets offered their condolences to him for your martyrdom,","source_pair_start":251,"source_pair_end":251,"recitation_segment":{"id":"segment-250","title":"Recitation segment 250","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-251","sequence":251,"arabic_text":"وَ فُجِعَتْ بِكَ اُمُّكَ الزَّهْراءُ،","transliteration":"wa fujiat bika ummukaz-zahrā',","english_text":"Your mother, al-Zahra, became distressed and bereft of you,","source_pair_start":252,"source_pair_end":252,"recitation_segment":{"id":"segment-251","title":"Recitation segment 251","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-252","sequence":252,"arabic_text":"وَ اخْتَلَفَتْ جُنُودُ الْمَلائِكَةِ الْمُقَرَّبينَ، تُعَزّي أباكَ أميرَالْمُؤْمِنينَ،","transliteration":"wakhtalafat junūdul malā'ikatil muqarrabīn, tuazzī 'abāka 'amīral mu'minīn,","english_text":"Legions of favored Angels came in waves to offer their condolences to your father, the Leader of the Faithful,","source_pair_start":253,"source_pair_end":253,"recitation_segment":{"id":"segment-252","title":"Recitation segment 252","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-253","sequence":253,"arabic_text":"وَ اُقيمَتْ لَكَ الْمَآتِمُ في أعْلا عِلِّيّينَ،","transliteration":"wa 'uqīmat lakal ma'ātimu fī 'alā illiyyīn,","english_text":"Mourning commemorations were held for you in the utmost exalted place Heaven,","source_pair_start":254,"source_pair_end":254,"recitation_segment":{"id":"segment-253","title":"Recitation segment 253","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-254","sequence":254,"arabic_text":"وَ لَطَمَتْ عَلَيْكَ الْحُورُ الْعينُ،","transliteration":"wa laţamat alaykal ħūrul īn,","english_text":"and the dark-eyed Maidens (of Paradise) hit their own heads and faces in grief,","source_pair_start":255,"source_pair_end":255,"recitation_segment":{"id":"segment-254","title":"Recitation segment 254","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-255","sequence":255,"arabic_text":"وَ بَكَتِ السَّماءُ وَ سُكّانُها،","transliteration":"wa bakatis-samā'u wa sukkānuhā,","english_text":"The skies and their inhabitants wept,","source_pair_start":256,"source_pair_end":256,"recitation_segment":{"id":"segment-255","title":"Recitation segment 255","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-256","sequence":256,"arabic_text":"وَ الْجِنانُ وَ خُزّانُها،","transliteration":"wal jinānu wa khuzzānuhā,","english_text":"as did Paradise and its keepers,","source_pair_start":257,"source_pair_end":257,"recitation_segment":{"id":"segment-256","title":"Recitation segment 256","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-257","sequence":257,"arabic_text":"وَ الْهِضابُ وَ أقْطارُها،","transliteration":"wal hiđhābu wa 'aqţāruhā,","english_text":"the mountains and their surroundings,","source_pair_start":258,"source_pair_end":258,"recitation_segment":{"id":"segment-257","title":"Recitation segment 257","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-258","sequence":258,"arabic_text":"وَ الْبِحارُ وَ حيتانُها،","transliteration":"wal biħāru wa ħītānuhā,","english_text":"the oceans and their fishes,","source_pair_start":259,"source_pair_end":259,"recitation_segment":{"id":"segment-258","title":"Recitation segment 258","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-259","sequence":259,"arabic_text":"وَ الْجِنانُ وَ وِلْدانُها،","transliteration":"wal jinānu wa wildānuhā,","english_text":"the heavens and their servants,","source_pair_start":260,"source_pair_end":260,"recitation_segment":{"id":"segment-259","title":"Recitation segment 259","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-260","sequence":260,"arabic_text":"وَ الْبَيْتُ وَ الْمَقامُ،","transliteration":"wal baytu wal maqām,","english_text":"the House (Ka’ba), and the Station (of Abraham),","source_pair_start":261,"source_pair_end":261,"recitation_segment":{"id":"segment-260","title":"Recitation segment 260","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-261","sequence":261,"arabic_text":"وَ الْمَشْعَرُ الْحَرامُ،","transliteration":"wal masharul ħarām,","english_text":"the Sacred Monument,","source_pair_start":262,"source_pair_end":262,"recitation_segment":{"id":"segment-261","title":"Recitation segment 261","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-262","sequence":262,"arabic_text":"وَ الْحِلُّ وَ الإحْلإحْرامُ،","transliteration":"wal ħillu wal iħrām,","english_text":"and Mecca and its sanctuary.","source_pair_start":263,"source_pair_end":263,"recitation_segment":{"id":"segment-262","title":"Recitation segment 262","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-263","sequence":263,"arabic_text":"اَللّهُمَّ فَبِحُرْمَةِ هذَا الْمَكانِ الْمُنيفِ،","transliteration":"allāhumma fabiħurmati hadhal makānil munīf,","english_text":"O Allah! By the sanctity of this exalted place (the tomb of Imam al-Husain (PBUH)),","source_pair_start":264,"source_pair_end":264,"recitation_segment":{"id":"segment-263","title":"Recitation segment 263","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-264","sequence":264,"arabic_text":"صَلِّ عَلى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ،","transliteration":"šalli alā muħammadin wa āli muħammad,","english_text":"bestow blessings upon Muhammad and the family of Muhammad,","source_pair_start":265,"source_pair_end":265,"recitation_segment":{"id":"segment-264","title":"Recitation segment 264","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-265","sequence":265,"arabic_text":"وَاحْشُرْني في زُمْرَتِهِمْ،","transliteration":"waħshurnī fī zumratihim,","english_text":"assemble me in their company,","source_pair_start":266,"source_pair_end":266,"recitation_segment":{"id":"segment-265","title":"Recitation segment 265","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-266","sequence":266,"arabic_text":"وَ أدْخِلْنِي الْجَنَّةَ بِشَفاعَتِهِمْ،","transliteration":"wa 'adkhilnil jannata bi shafāatihim,","english_text":"and admit me to Paradise by their intercession.","source_pair_start":267,"source_pair_end":267,"recitation_segment":{"id":"segment-266","title":"Recitation segment 266","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-267","sequence":267,"arabic_text":"اَللّهُمَّ إنّي أتَوَسَّلُ إلَيْكَ يا أسْرَعَ الْحاسِبينَ،","transliteration":"allāhumma 'innī 'atawassalu 'ilayka yā 'asraal ħāsibīn,","english_text":"My Allah! I implore You, O He who is the quickest of the reckoners!","source_pair_start":268,"source_pair_end":268,"recitation_segment":{"id":"segment-267","title":"Recitation segment 267","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-268","sequence":268,"arabic_text":"وَ ياأكْرَمَ الأكْرَمينَ، وَ ياأحْكَمَ الْحاكِمينَ،","transliteration":"wa yā 'akramal 'akramīn, wa yā 'aħkamal ħākimīn,","english_text":"O the most generous of the generous and the wisest of judges!","source_pair_start":269,"source_pair_end":269,"recitation_segment":{"id":"segment-268","title":"Recitation segment 268","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-269","sequence":269,"arabic_text":"بِمُحَمَّدٍ خاتَمِ النَّبِيّينَ، رَسُولِكَ إلَى الْعالَمينَ أجْمَعينَ،","transliteration":"bi muħammadin khātamin-nabiyyīn, rasūlika 'ilal ālamīna 'ajmaīn,","english_text":"By Muhammad, the seal of the prophets, Your Messenger to all the worlds,","source_pair_start":270,"source_pair_end":270,"recitation_segment":{"id":"segment-269","title":"Recitation segment 269","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-270","sequence":270,"arabic_text":"وَ بِأخيهِ وَ ابْنِ عَمِّهِ الأنْزَعِ الْبَطينِ، الْعالِمِ الْمَكينِ، عَلِيٍّ أميرِ الْمُؤْمِنينَ،","transliteration":"wa bi 'akhīhi wabni ammihil 'anzail baţīn, al-ālimil makīn, aliyyin 'amīril mu'minīn,","english_text":"By his brother and cousin, the uprooter of hidden polytheism, the distinguished and learned, Ali, the Prince of the Faithful,","source_pair_start":271,"source_pair_end":271,"recitation_segment":{"id":"segment-270","title":"Recitation segment 270","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
