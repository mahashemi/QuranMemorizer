[{"id":"passage-331","sequence":331,"arabic_text":"وَ لا خُلْقاً إلاّ حَسَّنْتَهُ،","transliteration":"wa lā khulqan 'illā ħassantah,","english_text":"Nor any character but that You improve,","source_pair_start":332,"source_pair_end":332,"recitation_segment":{"id":"segment-331","title":"Recitation segment 331","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-332","sequence":332,"arabic_text":"وَ لا إنْفاقاً إلاّ أخْلَفْتَهُ،","transliteration":"wa lā 'infāqan 'illā 'akhlaftah,","english_text":"Nor any charity but that You repay,","source_pair_start":333,"source_pair_end":333,"recitation_segment":{"id":"segment-332","title":"Recitation segment 332","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-333","sequence":333,"arabic_text":"وَ لا حالاً إلاّ عَمَرْتَهُ،","transliteration":"wa lā ħālan 'illā amartah,","english_text":"Nor any condition but that You cause to improve,","source_pair_start":334,"source_pair_end":334,"recitation_segment":{"id":"segment-333","title":"Recitation segment 333","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-334","sequence":334,"arabic_text":"وَ لا حَسُوداً إلاّ قَمَعْتَهُ،","transliteration":"wa lā ħasūdan 'illā qamatah,","english_text":"Nor any envious (one) but that You suppress,","source_pair_start":335,"source_pair_end":335,"recitation_segment":{"id":"segment-334","title":"Recitation segment 334","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-335","sequence":335,"arabic_text":"وَ لا عَدُوّاً إلاّ أرْدَيْتَهُ،","transliteration":"wa lā aduwwan 'illā 'ardaytah,","english_text":"Nor any enemy but that You destroy,","source_pair_start":336,"source_pair_end":336,"recitation_segment":{"id":"segment-335","title":"Recitation segment 335","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-336","sequence":336,"arabic_text":"وَ لا شَرّاً إلاّ كَفَيْتَهُ،","transliteration":"wa lā sharran 'illā kafaytah,","english_text":"Nor any evil but that You suffice,","source_pair_start":337,"source_pair_end":337,"recitation_segment":{"id":"segment-336","title":"Recitation segment 336","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-337","sequence":337,"arabic_text":"وَ لا مَرَضاً إلاّ شَفَيْتَهُ،","transliteration":"wa lā marađhan 'illā shafaytah,","english_text":"Nor any ailment but that You cure,","source_pair_start":338,"source_pair_end":338,"recitation_segment":{"id":"segment-337","title":"Recitation segment 337","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-338","sequence":338,"arabic_text":"وَ لا بَعيداً إلاّ أدْنَيْتَهُ،","transliteration":"wa lā baīdan 'illā 'adnaytah,","english_text":"Nor any distant (one) but that You bring near,","source_pair_start":339,"source_pair_end":339,"recitation_segment":{"id":"segment-338","title":"Recitation segment 338","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-339","sequence":339,"arabic_text":"وَ لا شَعَثاً إلاّ لَمَمْتَهُ،","transliteration":"wa lā shaathan 'illā lamamtah,","english_text":"Nor any scattering but that You reunite,","source_pair_start":340,"source_pair_end":340,"recitation_segment":{"id":"segment-339","title":"Recitation segment 339","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-340","sequence":340,"arabic_text":"وَ لا سُؤالاً [سُؤْلاً] إلاّ أعْطَيْتَهُ،","transliteration":"wa lā su'ālan [su'lan] 'illā 'aţaytah,","english_text":"Nor any request but that You grant.","source_pair_start":341,"source_pair_end":341,"recitation_segment":{"id":"segment-340","title":"Recitation segment 340","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-341","sequence":341,"arabic_text":"اَللّهُمَّ إنّي أسْئَلُكَ خَيْرَ الْعاجِلَةِ،","transliteration":"allāhumma 'innī 'as'aluka khayral ajilah,","english_text":"O Allah! I ask You for the goodness of this transitory world,","source_pair_start":342,"source_pair_end":342,"recitation_segment":{"id":"segment-341","title":"Recitation segment 341","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-342","sequence":342,"arabic_text":"وَ ثَوابَ الآجِلَةِ،","transliteration":"wa thawabal ājilah,","english_text":"and the reward of the hereafter.","source_pair_start":343,"source_pair_end":343,"recitation_segment":{"id":"segment-342","title":"Recitation segment 342","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-343","sequence":343,"arabic_text":"اَللّهُمَّ أغْنِني بِحَلالِكَ عَنِ الْحَرامِ،","transliteration":"allāhumma 'aghninī biħalālika anil ħarām,","english_text":"O Allah! Suffice me with what You made lawful from the unlawful,","source_pair_start":344,"source_pair_end":344,"recitation_segment":{"id":"segment-343","title":"Recitation segment 343","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-344","sequence":344,"arabic_text":"وَ بِفَضْلِكَ عَنْ جَميعِ الأنامِ،","transliteration":"wa bifađhlika an jamīil 'anām,","english_text":"and with Your grace from all other creatures.","source_pair_start":345,"source_pair_end":345,"recitation_segment":{"id":"segment-344","title":"Recitation segment 344","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-345","sequence":345,"arabic_text":"اَللّهُمَّ إنّي أسْئَلُكَ عِلْماً نافِعاً،","transliteration":"allāhumma 'innī 'as'aluka ilman nāfiā,","english_text":"My Allah! I ask You for beneficial knowledge,","source_pair_start":346,"source_pair_end":346,"recitation_segment":{"id":"segment-345","title":"Recitation segment 345","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-346","sequence":346,"arabic_text":"وَ قَلْباً خاشِعاً،","transliteration":"wa qalban khāshiā,","english_text":"a humble heart,","source_pair_start":347,"source_pair_end":347,"recitation_segment":{"id":"segment-346","title":"Recitation segment 346","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-347","sequence":347,"arabic_text":"وَ يَقيناً شافِياً،","transliteration":"wa yaqīnan shāfiyā,","english_text":"unequivocal certitude,","source_pair_start":348,"source_pair_end":348,"recitation_segment":{"id":"segment-347","title":"Recitation segment 347","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-348","sequence":348,"arabic_text":"وَ عَمَلا زاكِياً،","transliteration":"wa amalan zākiyā,","english_text":"pure action,","source_pair_start":349,"source_pair_end":349,"recitation_segment":{"id":"segment-348","title":"Recitation segment 348","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-349","sequence":349,"arabic_text":"وَ صَبْراً جَميلاً،","transliteration":"wa šabran jamīlā,","english_text":"beautiful patience,","source_pair_start":350,"source_pair_end":350,"recitation_segment":{"id":"segment-349","title":"Recitation segment 349","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-350","sequence":350,"arabic_text":"وَ أجْراً جَزيلاً،","transliteration":"wa ajran 'jazīlā,","english_text":"and a bountiful reward.","source_pair_start":351,"source_pair_end":351,"recitation_segment":{"id":"segment-350","title":"Recitation segment 350","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-351","sequence":351,"arabic_text":"اَللّهُمَّ ارْزُقْني شُكْرَ نِعْمَتِكَ عَلَىَّ،","transliteration":"allāhummarzuqnī shukra nimatika alayy,","english_text":"O Allah! Grant me gratitude of Your blessing upon me,","source_pair_start":352,"source_pair_end":352,"recitation_segment":{"id":"segment-351","title":"Recitation segment 351","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-352","sequence":352,"arabic_text":"وَ زِدْ في إحْسانِكَ وَ كَرَمِكَ إلَىَّ،","transliteration":"wa zid fī 'iħsānika wa karamika 'ilayy,","english_text":"Increase Your favor and munificence on me,","source_pair_start":353,"source_pair_end":353,"recitation_segment":{"id":"segment-352","title":"Recitation segment 352","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-353","sequence":353,"arabic_text":"وَ اجْعَلْ قَوْلي فِي النّاسِ مَسْمُوعاً،","transliteration":"wajal qawlī fin-nāsi masmūā,","english_text":"Make my speech amongst people effective,","source_pair_start":354,"source_pair_end":354,"recitation_segment":{"id":"segment-353","title":"Recitation segment 353","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-354","sequence":354,"arabic_text":"وَ عَمَلي عِنْدَكَ مَرْفُوعاً،","transliteration":"wa amalī indaka marfūā,","english_text":"my deeds elevated and worthy of being delivered to You,","source_pair_start":355,"source_pair_end":355,"recitation_segment":{"id":"segment-354","title":"Recitation segment 354","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-355","sequence":355,"arabic_text":"وَ أثَري فِي الْخَيْراتِ مَتْبُوعاً،","transliteration":"wa 'atharī fil khayrāti matbūā,","english_text":"my righteous works followed (by others),","source_pair_start":356,"source_pair_end":356,"recitation_segment":{"id":"segment-355","title":"Recitation segment 355","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-356","sequence":356,"arabic_text":"وَ عَدُوّي مَقْمُوعاً،","transliteration":"wa aduwwī maqmūā,","english_text":"and my enemy quelled,","source_pair_start":357,"source_pair_end":357,"recitation_segment":{"id":"segment-356","title":"Recitation segment 356","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-357","sequence":357,"arabic_text":"اَللّهُمَّ صَلِّ عَلى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ الأخْيارِ، في آناءِ اللَّيْلِ وَ أطْرافِ النَّهارِ،","transliteration":"allāhumma šalli alā muħammadin wa āli muħammadinil 'akhyār, fī ānā'il-layli wa 'aţrāfin-nahār,","english_text":"O Allah! Send blessings upon Muhammad and the family of Muhammad, the best of the creations, day and night,","source_pair_start":358,"source_pair_end":358,"recitation_segment":{"id":"segment-357","title":"Recitation segment 357","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-358","sequence":358,"arabic_text":"وَ اكْفِني شَرَّ الأشْرارِ،","transliteration":"wakfinī sharral ashrār,","english_text":"Spare me from the evil of the wicked,","source_pair_start":359,"source_pair_end":359,"recitation_segment":{"id":"segment-358","title":"Recitation segment 358","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-359","sequence":359,"arabic_text":"وَ طَهِّرْني مِنَ الذُّنُوبِ وَ الأوْزارِ،","transliteration":"wa ţahhirnī minadh-dhunūbi wal awzār,","english_text":"Purify me from sins and burdens,","source_pair_start":360,"source_pair_end":360,"recitation_segment":{"id":"segment-359","title":"Recitation segment 359","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-360","sequence":360,"arabic_text":"وَ أجِرْني مِنَ النّارِ،","transliteration":"wa 'ajirnī minan-nār,","english_text":"Give me refuge from Hell-fire,","source_pair_start":361,"source_pair_end":361,"recitation_segment":{"id":"segment-360","title":"Recitation segment 360","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
