[{"id":"passage-031","sequence":31,"arabic_text":"اَلسَّلامُ عَلى مَنِ الأئِمَّةُ مِنْ ذُرِّيَّتِهِ،","transliteration":"assalāmu alā manil 'a'immatu min dhurriyyatih,","english_text":"Peace be upon the one in whose descendants are the Imams (after him).","source_pair_start":31,"source_pair_end":31,"recitation_segment":{"id":"segment-031","title":"Recitation segment 31","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-032","sequence":32,"arabic_text":"اَلسَّلامُ عَلَى ابْنِ خاتَمِ الأنْبِياءِ،","transliteration":"assalāmu alabni khātamil anbiyā',","english_text":"Peace be upon the son of the seal of the prophets.","source_pair_start":32,"source_pair_end":32,"recitation_segment":{"id":"segment-032","title":"Recitation segment 32","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-033","sequence":33,"arabic_text":"اَلسَّلامُ عَلَى ابْنِ سَيِّدِ الأوْصِياءِ،","transliteration":"assalāmu alabni sayyidil awšiyā',","english_text":"Peace be upon the son of the chief of the executors.","source_pair_start":33,"source_pair_end":33,"recitation_segment":{"id":"segment-033","title":"Recitation segment 33","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-034","sequence":34,"arabic_text":"اَلسَّلامُ عَلَى ابْنِ فاطِمَةَ الزَّهْراءِ،","transliteration":"assalāmu alabni fāţimaz-zahrā',","english_text":"Peace be upon the son of Fatima, the radiant.","source_pair_start":34,"source_pair_end":34,"recitation_segment":{"id":"segment-034","title":"Recitation segment 34","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-035","sequence":35,"arabic_text":"اَلسَّلامُ عَلَى ابْنِ خَديجَةَ الْكُبْرى،","transliteration":"assalāmu alabni khadijatal kubrā,","english_text":"Peace be upon the son of Khadija, the great.","source_pair_start":35,"source_pair_end":35,"recitation_segment":{"id":"segment-035","title":"Recitation segment 35","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-036","sequence":36,"arabic_text":"اَلسَّلامُ عَلَى ابْنِ سِدْرَةِ الْمُنْتَهى،","transliteration":"assalāmu alabni sidratil muntahā,","english_text":"Peace be upon the son of the lote-tree in the outermost boundary (of Heaven).[1]","source_pair_start":36,"source_pair_end":36,"recitation_segment":{"id":"segment-036","title":"Recitation segment 36","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-037","sequence":37,"arabic_text":"اَلسَّلامُ عَلَى ابْنِ جَنَّةِ الْمَأْوى،","transliteration":"assalāmu alabni jannatil ma'wā,","english_text":"Peace be upon the son of the Garden of refuge.","source_pair_start":37,"source_pair_end":37,"recitation_segment":{"id":"segment-037","title":"Recitation segment 37","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-038","sequence":38,"arabic_text":"اَلسَّلامُ عَلَى ابْنِ زَمْزَمَ وَ الصَّفا،","transliteration":"assalāmu alabni zamzama waš-šafā","english_text":"Peace be upon the son of Zamzam and al-Safaa.","source_pair_start":38,"source_pair_end":38,"recitation_segment":{"id":"segment-038","title":"Recitation segment 38","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-039","sequence":39,"arabic_text":"اَلسَّلامُ عَلَى الْمُرَمَّلِ بِالدِّماءِ،","transliteration":"assalāmu alal murrammali bid-dimā',","english_text":"Peace be upon him, who was saturated in (his) blood.","source_pair_start":39,"source_pair_end":39,"recitation_segment":{"id":"segment-039","title":"Recitation segment 39","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-040","sequence":40,"arabic_text":"اَلسَّلامُ عَلَى الْمَهْتُوكِ الْخِباءِ،","transliteration":"assalāmu alal mahtūkil khibā',","english_text":"Peace be upon him, whose tents were violated.","source_pair_start":40,"source_pair_end":40,"recitation_segment":{"id":"segment-040","title":"Recitation segment 40","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-041","sequence":41,"arabic_text":"اَلسَّلامُ عَلى خامِسِ أصْحابِ الْكِساءِ،","transliteration":"assalāmu alā khāmisi 'ašħābil kisā',","english_text":"Peace be upon the fifth of the People of the Cloak.","source_pair_start":41,"source_pair_end":41,"recitation_segment":{"id":"segment-041","title":"Recitation segment 41","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-042","sequence":42,"arabic_text":"اَلسَّلامُ عَلى غَريبِ الْغُرَباءِ،","transliteration":"assalāmu alā gharībil ghurabā',","english_text":"Peace be upon the loneliest of the lonely.","source_pair_start":42,"source_pair_end":42,"recitation_segment":{"id":"segment-042","title":"Recitation segment 42","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-043","sequence":43,"arabic_text":"اَلسَّلامُ عَلى شَهيدِ الشُّهَداءِ،","transliteration":"assalāmu alā shahīdish-shuhadā',","english_text":"Peace be upon the (greatest) martyr of all martyrs.","source_pair_start":43,"source_pair_end":43,"recitation_segment":{"id":"segment-043","title":"Recitation segment 43","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-044","sequence":44,"arabic_text":"اَلسَّلامُ عَلى قَتيلِ الأدْعِياءِ،","transliteration":"assalāmu alā qatīlil adiyā',","english_text":"Peace be upon him, who was slain by the individuals of illegitimate birth.","source_pair_start":44,"source_pair_end":44,"recitation_segment":{"id":"segment-044","title":"Recitation segment 44","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-045","sequence":45,"arabic_text":"اَلسَّلامُ عَلى ساكِنِ كَرْبَلاءَ،","transliteration":"assalāmu alā sākini karbalā',","english_text":"Peace be upon the one who is at rest in Karbala.","source_pair_start":45,"source_pair_end":45,"recitation_segment":{"id":"segment-045","title":"Recitation segment 45","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-046","sequence":46,"arabic_text":"اَلسَّلامُ عَلى مَنْ بَكَتْهُ مَلائِكَةُ السَّماءِ،","transliteration":"assalāmu alā man bakat-hu malā'ikatus-samā'","english_text":"Peace be upon the one for whom the heavenly Angels wept.","source_pair_start":46,"source_pair_end":46,"recitation_segment":{"id":"segment-046","title":"Recitation segment 46","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-047","sequence":47,"arabic_text":"اَلسَّلامُ عَلى مَنْ ذُرِّيَّتُهُ الأزْكِياءُ،","transliteration":"assalāmu alā man dhuriyyatuhul azkiyā',","english_text":"Peace be upon the one whose descendants are the pure.","source_pair_start":47,"source_pair_end":47,"recitation_segment":{"id":"segment-047","title":"Recitation segment 47","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-048","sequence":48,"arabic_text":"اَلسَّلامُ عَلى يَعْسُوبِ الدّينِ،","transliteration":"assalāmu alā yasūbid-dīn","english_text":"Peace be upon the chief of the religion.","source_pair_start":48,"source_pair_end":48,"recitation_segment":{"id":"segment-048","title":"Recitation segment 48","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-049","sequence":49,"arabic_text":"اَلسَّلامُ عَلى مَنازِلِ الْبَراهينِ،","transliteration":"assalāmu alā manāzilil barāhīn,","english_text":"Peace be upon the places of the (divine) proofs.","source_pair_start":49,"source_pair_end":49,"recitation_segment":{"id":"segment-049","title":"Recitation segment 49","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-050","sequence":50,"arabic_text":"اَلسَّلامُ عَلَى الأئِمَّةِ السّاداتِ،","transliteration":"assalāmu alal 'a'immatis-sādāt,","english_text":"Peace be upon the Imams, the masters (of mankind).","source_pair_start":50,"source_pair_end":50,"recitation_segment":{"id":"segment-050","title":"Recitation segment 50","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-051","sequence":51,"arabic_text":"اَلسَّلامُ عَلَى الْجُيُوبِ الْمُضَرَّجاتِ،","transliteration":"assalāmu alal juyūbil muđharrajāt,","english_text":"Peace be upon the bloodstained chests.","source_pair_start":51,"source_pair_end":51,"recitation_segment":{"id":"segment-051","title":"Recitation segment 51","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-052","sequence":52,"arabic_text":"اَلسَّلامُ عَلَى الشِّفاهِ الذّابِلاتِ،","transliteration":"assalāmu alash-shifāhidh-dhābilāt,","english_text":"Peace be upon the parched lips.","source_pair_start":52,"source_pair_end":52,"recitation_segment":{"id":"segment-052","title":"Recitation segment 52","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-053","sequence":53,"arabic_text":"اَلسَّلامُ عَلَى النُّفُوسِ الْمُصْطَلَماتِ،","transliteration":"assalāmu alan-nufūsil mušţalamāt,","english_text":"Peace be upon the plucked souls.","source_pair_start":53,"source_pair_end":53,"recitation_segment":{"id":"segment-053","title":"Recitation segment 53","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-054","sequence":54,"arabic_text":"اَلسَّلامُ عَلَى الأرْواحِ الْمُخْتَلَساتِ،","transliteration":"assalāmu alal 'arwāħil mukhtalasāt,","english_text":"Peace be upon the snatched spirits.","source_pair_start":54,"source_pair_end":54,"recitation_segment":{"id":"segment-054","title":"Recitation segment 54","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-055","sequence":55,"arabic_text":"اَلسَّلامُ عَلَى الأجْسادِ الْعارِياتِ،","transliteration":"assalāmu alal 'ajsādil ariyāt,","english_text":"Peace be upon the stripped corpses.","source_pair_start":55,"source_pair_end":55,"recitation_segment":{"id":"segment-055","title":"Recitation segment 55","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-056","sequence":56,"arabic_text":"اَلسَّلامُ عَلَى الْجُسُومِ الشّاحِباتِ،","transliteration":"assalāmu alal jusūmish-shāħibāt,","english_text":"Peace be upon the pallid bodies.","source_pair_start":56,"source_pair_end":56,"recitation_segment":{"id":"segment-056","title":"Recitation segment 56","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-057","sequence":57,"arabic_text":"اَلسَّلامُ عَلَى الدِّماءِ السّائِلاتِ،","transliteration":"asslāmu alad-dimā'is-sā'ilāt,","english_text":"Peace be upon the gushing bloods.","source_pair_start":57,"source_pair_end":57,"recitation_segment":{"id":"segment-057","title":"Recitation segment 57","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-058","sequence":58,"arabic_text":"اَلسَّلامُ عَلَى الأعْضاءِ الْمُقَطَّعاتِ،","transliteration":"assalāmu alal ađhā'il muqqaţţaāt,","english_text":"Peace be upon the dismembered limbs.","source_pair_start":58,"source_pair_end":58,"recitation_segment":{"id":"segment-058","title":"Recitation segment 58","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-059","sequence":59,"arabic_text":"اَلسَّلامُ عَلَى الرُّؤُوسِ الْمُشالاتِ،","transliteration":"assalāmu alar-ru'ūsil mushālāt,","english_text":"Peace be upon the heads raised upon lances.","source_pair_start":59,"source_pair_end":59,"recitation_segment":{"id":"segment-059","title":"Recitation segment 59","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-060","sequence":60,"arabic_text":"اَلسَّلامُ عَلَى النِّسْوَةِ الْبارِزاتِ،","transliteration":"assalāmu alan-niswatil bārizāt,","english_text":"Peace be upon the women (forcibly) exposed.","source_pair_start":60,"source_pair_end":60,"recitation_segment":{"id":"segment-060","title":"Recitation segment 60","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
