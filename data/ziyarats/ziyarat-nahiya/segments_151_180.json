[{"id":"passage-151","sequence":151,"arabic_text":"وَ فِي الطّاعَةِ مُجْتَهِداً،","transliteration":"wa fiţ-ţāati mujtahidā,","english_text":"You were diligent in obedience,","source_pair_start":152,"source_pair_end":152,"recitation_segment":{"id":"segment-151","title":"Recitation segment 151","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-152","sequence":152,"arabic_text":"حافِظاً لِلْعَهْدِ وَ الْميثاقِ،","transliteration":"ħāfiđan lil ahdi wal mīthāq,","english_text":"a protector of the covenant and oath,","source_pair_start":153,"source_pair_end":153,"recitation_segment":{"id":"segment-152","title":"Recitation segment 152","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-153","sequence":153,"arabic_text":"ناكِباً عَنْ سُبُلِ الْفُسّاقِ،","transliteration":"nākiban an subulil fussāq,","english_text":"keeping away from the paths of the debauched,","source_pair_start":154,"source_pair_end":154,"recitation_segment":{"id":"segment-153","title":"Recitation segment 153","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-154","sequence":154,"arabic_text":"[وَ] باذِلاً لِلْمَجْهُودِ،","transliteration":"[wa] bādhilan lil majhūd,","english_text":"sparing no effort (in fulfilling the duties),","source_pair_start":155,"source_pair_end":155,"recitation_segment":{"id":"segment-154","title":"Recitation segment 154","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-155","sequence":155,"arabic_text":"طَويلَ الرُّكُوعِ وَ السُّجُودِ،","transliteration":"ţawīlar-rukūi was-sujūd,","english_text":"performing prolonged bowing and prostrations,","source_pair_start":156,"source_pair_end":156,"recitation_segment":{"id":"segment-155","title":"Recitation segment 155","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-156","sequence":156,"arabic_text":"زاهِداً فِي الدُّنْيا زُهْدَ الرّاحِلِ عَنْها،","transliteration":"zāhidan fid-dunya zuhdar-rāħili anhā,","english_text":"abstaining from the world, like one who is departing from it,","source_pair_start":157,"source_pair_end":157,"recitation_segment":{"id":"segment-156","title":"Recitation segment 156","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-157","sequence":157,"arabic_text":"ناظِراً إلَيْها بِعَيْنِ الْمُسْتَوْحِشينَ مِنْها،","transliteration":"nāđiran 'ilayhā biaynil-mustawħishīna minhā,","english_text":"looking upon it (the world) through the eyes of one estranged (from it).","source_pair_start":158,"source_pair_end":158,"recitation_segment":{"id":"segment-157","title":"Recitation segment 157","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-158","sequence":158,"arabic_text":"آمالُكَ عَنْها مَكْفُوفَةٌ،","transliteration":"āmāluka anhā makfūfah,","english_text":"Your desires from it (the world) were abstentious,","source_pair_start":159,"source_pair_end":159,"recitation_segment":{"id":"segment-158","title":"Recitation segment 158","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-159","sequence":159,"arabic_text":"وَ هِمَّتُكَ عَنْ زينَتِها مَصْرُوفَةٌ،","transliteration":"wa himmatuka an zīnatihā mašrūfah,","english_text":"your efforts were far-removed from its embellishments,","source_pair_start":160,"source_pair_end":160,"recitation_segment":{"id":"segment-159","title":"Recitation segment 159","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-160","sequence":160,"arabic_text":"وَ ألْحاظُكَ عَنْ بَهْجَتِها مَطْرُوفَةٌ،","transliteration":"wa 'alħāđuka an bahjatihā maţrūfah,","english_text":"your glances removed from its joys,","source_pair_start":161,"source_pair_end":161,"recitation_segment":{"id":"segment-160","title":"Recitation segment 160","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-161","sequence":161,"arabic_text":"وَ رَغْبَتُكَ فِي الآخِرَةِ مَعْرُوفَةٌ،","transliteration":"wa raghbatuka fil ākhirati marūfah,","english_text":"and your desire for the hereafter was well-known,","source_pair_start":162,"source_pair_end":162,"recitation_segment":{"id":"segment-161","title":"Recitation segment 161","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-162","sequence":162,"arabic_text":"حَتّى إذَا الْجَوْرُ مَدَّ باعَهُ،","transliteration":"ħattā 'idhal jowru madda bāah,","english_text":"even when tyranny became wide-spread,","source_pair_start":163,"source_pair_end":163,"recitation_segment":{"id":"segment-162","title":"Recitation segment 162","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-163","sequence":163,"arabic_text":"وَ أسْفَرَ الظُّلْمُ قِناعَهُ،","transliteration":"wa 'asfarađ-đulmu qināah,","english_text":"injustice removed its veil,","source_pair_start":164,"source_pair_end":164,"recitation_segment":{"id":"segment-163","title":"Recitation segment 163","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-164","sequence":164,"arabic_text":"وَ دَعَا الْغَيُّ أتْباعَهُ،","transliteration":"wa daal ghayyu 'atbāah,","english_text":"wickedness called upon its followers,","source_pair_start":165,"source_pair_end":165,"recitation_segment":{"id":"segment-164","title":"Recitation segment 164","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-165","sequence":165,"arabic_text":"وَ أنْتَ في حَرَمِ جَدِّكَ قاطِنٌ،","transliteration":"wa 'anta fī ħarami jaddika qāţin,","english_text":"and you were residing in the sanctuary of your grandfather,","source_pair_start":166,"source_pair_end":166,"recitation_segment":{"id":"segment-165","title":"Recitation segment 165","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-166","sequence":166,"arabic_text":"وَ لِلظّالِمينَ مُبايِنٌ،","transliteration":"wa liđ-đālimīna mubāyin,","english_text":"detached from the oppressors,","source_pair_start":167,"source_pair_end":167,"recitation_segment":{"id":"segment-166","title":"Recitation segment 166","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-167","sequence":167,"arabic_text":"جَليسُ الْبَيْتِ وَ الْمِحْرابِ،","transliteration":"jalīsul bayti wal miħrāb,","english_text":"sitting in the house and the prayer niche,","source_pair_start":168,"source_pair_end":168,"recitation_segment":{"id":"segment-167","title":"Recitation segment 167","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-168","sequence":168,"arabic_text":"مُعْتَزِلٌ عَنِ اللَّذّاتِ وَ الشَّهَواتِ،","transliteration":"mutazilun anil-ladh-dhāti wash-shahawāt,","english_text":"unattached to (worldly) pleasures and carnal desires,","source_pair_start":169,"source_pair_end":169,"recitation_segment":{"id":"segment-168","title":"Recitation segment 168","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-169","sequence":169,"arabic_text":"تُنْكِرُ الْمُنْكَرَ بِقَلْبِكَ وَ لِسانِكَ، عَلى حَسَبِ طاقَتِكَ وَ إمْكانِكَ،","transliteration":"tunkirul munkara biqalbika wa lisānik, alā ħasabi ţāqatika wa 'imkānik,","english_text":"and renouncing evil in your heart and on your tongue to the extent of your strength and ability.","source_pair_start":170,"source_pair_end":170,"recitation_segment":{"id":"segment-169","title":"Recitation segment 169","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-170","sequence":170,"arabic_text":"ثُمَّ اقْتَضاكَ الْعِلْمُ لِلإْنْكارِ،","transliteration":"thummaqtađhākal ilmu lil 'inkār,","english_text":"Then the knowledge demanded you for disavowal (of falsehood),","source_pair_start":171,"source_pair_end":171,"recitation_segment":{"id":"segment-170","title":"Recitation segment 170","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-171","sequence":171,"arabic_text":"وَ لَزِمَكَ [ألْزَمَكَ] أنْ تُجاهِدَ الْفُجّارَ،","transliteration":"wa lazimika 'an tujāhidal fujjār,","english_text":"and made it incumbent on you to struggle against the deviant.","source_pair_start":172,"source_pair_end":172,"recitation_segment":{"id":"segment-171","title":"Recitation segment 171","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-172","sequence":172,"arabic_text":"فَسِرْتَ في أوْلادِكَ وَ أهاليكَ، وَ شيعَتِكَ وَ مَواليكَ","transliteration":"fasirta fī 'awlādika wa 'ahālīk, wa shīatika wa mawālīk,","english_text":"Therefore, you set out in company of your children, kinsfolk, followers, and supporters,","source_pair_start":173,"source_pair_end":173,"recitation_segment":{"id":"segment-172","title":"Recitation segment 172","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-173","sequence":173,"arabic_text":"وَ صَدَعْتَ بِالْحَقِّ وَ الْبَيِّنَةِ،","transliteration":"wa šadata bil ħaqqi wal bayyinah,","english_text":"disclosed the truth and clear proofs,","source_pair_start":174,"source_pair_end":174,"recitation_segment":{"id":"segment-173","title":"Recitation segment 173","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-174","sequence":174,"arabic_text":"وَ دَعَوْتَ إلَى اللهِ بِالْحِكْمَةِ وَ الْمَوْعِظَةِ الْحَسَنَةِ،","transliteration":"wa daawta 'ilal-lāhi bil ħikmakti wal mawiđatil ħasanah,","english_text":"summoned people towards Allah with wisdom and fine exhortation,","source_pair_start":175,"source_pair_end":175,"recitation_segment":{"id":"segment-174","title":"Recitation segment 174","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-175","sequence":175,"arabic_text":"وَ أمَرْتَ بِإقامَةِ الْحُدُودِ، وَ الطّاعَةِ لِلْمَعْبُودِ،","transliteration":"wa 'amarta bi'iqāmatil ħudūd, waţ-ţāati lil mabūd,","english_text":"ordered the establishment of the limits of divine law, and the obedience to the One Who should be worshipped,","source_pair_start":176,"source_pair_end":176,"recitation_segment":{"id":"segment-175","title":"Recitation segment 175","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-176","sequence":176,"arabic_text":"وَ نَهَيْتَ عَنِ الْخَبائِثِ وَ الطُّغْيانِ،","transliteration":"wa nahayta anil khabā'ithi waţ-ţughyān","english_text":"and forbade (people) from wickedness and oppression.","source_pair_start":177,"source_pair_end":177,"recitation_segment":{"id":"segment-176","title":"Recitation segment 176","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-177","sequence":177,"arabic_text":"وَ واجَهُوكَ بِالظُّلْمِ وَ الْعُدْوانِ،","transliteration":"wa wājahūka biđ-đulmi wal udwān,","english_text":"But, they confronted you with injustice and aggression.","source_pair_start":178,"source_pair_end":178,"recitation_segment":{"id":"segment-177","title":"Recitation segment 177","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-178","sequence":178,"arabic_text":"فَجاهَدْتَهُمْ بَعْدَ الإيعازِ لَهُمْ [الإيعادِ إلَيْهِمْ] وَ تَأْكيدِ الْحُجَّةِ عَلَيْهِمْ،","transliteration":"fa jāhadtahum badal 'īāzi lahum [al-īādi 'ilayhim] wa ta'kīdil ħujjati alayhim,","english_text":"Therefore, you resisted them after advising them and stressing over (divine) proofs against them.","source_pair_start":179,"source_pair_end":179,"recitation_segment":{"id":"segment-178","title":"Recitation segment 178","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-179","sequence":179,"arabic_text":"فَنَكَثُوا ذِمامَكَ وَ بَيْعَتَكَ،","transliteration":"fanakathū dhimāmaka wa bayatak,","english_text":"However, they violated your (divine) rights and oath.","source_pair_start":180,"source_pair_end":180,"recitation_segment":{"id":"segment-179","title":"Recitation segment 179","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-180","sequence":180,"arabic_text":"وَ أسْخَطُوا رَبَّكَ وَ جَدَّكَ،","transliteration":"wa 'askhaţu rabbaka wa jaddak,","english_text":"angered your Lord and your grandfather,","source_pair_start":181,"source_pair_end":181,"recitation_segment":{"id":"segment-180","title":"Recitation segment 180","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
