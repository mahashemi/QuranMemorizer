[{"id":"passage-301","sequence":301,"arabic_text":"أنْ تَكْشِفَ ما بي مِنَ الْغُمُومِ،","transliteration":"'an takshifa mā bī minal ghumūm,","english_text":"that You dispel from me all that grieves me,","source_pair_start":302,"source_pair_end":302,"recitation_segment":{"id":"segment-301","title":"Recitation segment 301","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-302","sequence":302,"arabic_text":"وَ تَصْرِفَ عَنّي شَرَّ الْقَدَرِ الْمَحْتُومِ،","transliteration":"wa tašrifa annī sharral qadaril maħtūm,","english_text":"divert from me the harm of the decisive foreordained plan,","source_pair_start":303,"source_pair_end":303,"recitation_segment":{"id":"segment-302","title":"Recitation segment 302","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-303","sequence":303,"arabic_text":"وَ تُجيرَني مِنَ النّارِ ذاتِ السَّمُومِ،","transliteration":"wa tujīrani minan-nāri dhātis-samūm,","english_text":"and give me refuge from the Hellfire with scorching winds.","source_pair_start":304,"source_pair_end":304,"recitation_segment":{"id":"segment-303","title":"Recitation segment 303","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-304","sequence":304,"arabic_text":"اَللّهُمَّ جَلِّلْني بِنِعْمَتِكَ،","transliteration":"allāhumma jallilnī binimatik,","english_text":"My Allah! Honor me with Your bounties,","source_pair_start":305,"source_pair_end":305,"recitation_segment":{"id":"segment-304","title":"Recitation segment 304","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-305","sequence":305,"arabic_text":"وَ رَضِّني بِقَسْمِكَ،","transliteration":"wa rađhđhinnī bi-qasmik,","english_text":"Make me content with Your apportionment,","source_pair_start":306,"source_pair_end":306,"recitation_segment":{"id":"segment-305","title":"Recitation segment 305","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-306","sequence":306,"arabic_text":"وَ تَغَمَّدْني بِجُودِكَ وَ كَرَمِكَ،","transliteration":"wa taghammadnī bijūdika wa karamik,","english_text":"Encompass me with Your munificence and generosity,","source_pair_start":307,"source_pair_end":307,"recitation_segment":{"id":"segment-306","title":"Recitation segment 306","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-307","sequence":307,"arabic_text":"وَ باعِدْني مِنْ مَكْرِكَ وَ نِقْمَتِكَ،","transliteration":"wa bāidnī min makrika wa niqmatik,","english_text":"And keep me far off from Your requital scheme and Your wrath.","source_pair_start":308,"source_pair_end":308,"recitation_segment":{"id":"segment-307","title":"Recitation segment 307","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-308","sequence":308,"arabic_text":"اَللّهُمَّ اعْصِمْني مِنَ الزَّلَلِ،","transliteration":"allāhumma-šimnī minaz-zalal,","english_text":"O Allah! Protect me from errors,","source_pair_start":309,"source_pair_end":309,"recitation_segment":{"id":"segment-308","title":"Recitation segment 308","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-309","sequence":309,"arabic_text":"وَ سدِّدْني فِي الْقَوْلِ وَ الْعَمَلِ،","transliteration":"wa saddidnī fil qawli wal amal,","english_text":"Make me firm in speech and action,","source_pair_start":310,"source_pair_end":310,"recitation_segment":{"id":"segment-309","title":"Recitation segment 309","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-310","sequence":310,"arabic_text":"وَافْسَحْ لي في مُدَّةِ الأجَلِ،","transliteration":"wafsaħ lī fī muddatil 'ajal,","english_text":"Extend for me the period (of life),","source_pair_start":311,"source_pair_end":311,"recitation_segment":{"id":"segment-310","title":"Recitation segment 310","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-311","sequence":311,"arabic_text":"وَ اعْفِني مِنَ الأوْجاعِ وَ الْعِلَلِ،","transliteration":"wafinī minal 'awjāi wal ilal,","english_text":"Relieve me from pain and ailments,","source_pair_start":312,"source_pair_end":312,"recitation_segment":{"id":"segment-311","title":"Recitation segment 311","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-312","sequence":312,"arabic_text":"وَ بَلِّغْني بِمَوالِيَّ وَ بِفَضْلِكَ أفْضَلَ الأَمَلِ،","transliteration":"wa ballighnī bimawāliyya wa bifađhlika 'afđhalal 'amal,","english_text":"Make me achieve, through my masters and Your grace, the best of wishes.","source_pair_start":313,"source_pair_end":313,"recitation_segment":{"id":"segment-312","title":"Recitation segment 312","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-313","sequence":313,"arabic_text":"اَللّهُمَّ صَلِّ عَلى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ وَ اقْبَلْ تَوْبَتي،","transliteration":"allāhumma šalli alā muħammadin wa āli muħammad waqbal tawbati,","english_text":"O Allah! Bless Muhammad and the family of Muhammad and accept my repentance and my return,","source_pair_start":314,"source_pair_end":314,"recitation_segment":{"id":"segment-313","title":"Recitation segment 313","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-314","sequence":314,"arabic_text":"وَارْحَمْ عَبْرَتي،","transliteration":"warħam abratī,","english_text":"Have mercy upon my weeping,","source_pair_start":315,"source_pair_end":315,"recitation_segment":{"id":"segment-314","title":"Recitation segment 314","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-315","sequence":315,"arabic_text":"وَ أقِلْني عَثْرَتي،","transliteration":"wa 'aqilnī athratī,","english_text":"Lessen my lapses,","source_pair_start":316,"source_pair_end":316,"recitation_segment":{"id":"segment-315","title":"Recitation segment 315","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-316","sequence":316,"arabic_text":"وَ نَفِّسْ كُرْبَتي،","transliteration":"wa naffis kurbatī,","english_text":"Relieve my distress,","source_pair_start":317,"source_pair_end":317,"recitation_segment":{"id":"segment-316","title":"Recitation segment 316","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-317","sequence":317,"arabic_text":"وَاغْفِرْ لي خَطيئَتي،","transliteration":"waghfir lī khaţī'ati,","english_text":"Forgive me my mistake,","source_pair_start":318,"source_pair_end":318,"recitation_segment":{"id":"segment-317","title":"Recitation segment 317","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-318","sequence":318,"arabic_text":"وَ أصْلِحْ لي في ذُرِّيَّتي،","transliteration":"wa 'ašliħ lī fī dhurriyyatī,","english_text":"And improve my (righteousness) through my children.","source_pair_start":319,"source_pair_end":319,"recitation_segment":{"id":"segment-318","title":"Recitation segment 318","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-319","sequence":319,"arabic_text":"اَللّهُمَّ لا تَدَعْ لي في هذَا الْمَشْهَدِ الْمُعَظَّمِ وَ الْمَحَلِّ الْمُكَرَّمِ ذَنْباً إلاّ غَفَرْتَهُ،","transliteration":"allāhumma lā tada lī fī hādhal mash-hadil muađđami wal maħallil mukkarrami dhanban 'illā ghafartah,","english_text":"My Allah! Do not leave for me, in this exalted and honored place of martyrdom, any sin but that You forgive,","source_pair_start":320,"source_pair_end":320,"recitation_segment":{"id":"segment-319","title":"Recitation segment 319","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-320","sequence":320,"arabic_text":"وَ لا عَيْباً إلاّ سَتَرْتَهُ،","transliteration":"wa lā ayban 'illā satartah,","english_text":"Nor any defect but that You conceal,","source_pair_start":321,"source_pair_end":321,"recitation_segment":{"id":"segment-320","title":"Recitation segment 320","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-321","sequence":321,"arabic_text":"وَ لا غَمّاً إلاّ كَشَفْتَهُ،","transliteration":"wa lā ghamman 'illā kashaftah,","english_text":"Nor any grief but that You remove,","source_pair_start":322,"source_pair_end":322,"recitation_segment":{"id":"segment-321","title":"Recitation segment 321","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-322","sequence":322,"arabic_text":"وَ لا رِزْقاً إلاّ بَسَطْتَهُ،","transliteration":"wa lā rizqan 'illā basaţtah,","english_text":"Nor any sustenance but that You extend,","source_pair_start":323,"source_pair_end":323,"recitation_segment":{"id":"segment-322","title":"Recitation segment 322","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-323","sequence":323,"arabic_text":"وَ لا جاهاً إلاّ عَمَرْتَهُ،","transliteration":"wa lā jāhan 'illā amartah,","english_text":"Nor any (spiritual) status but that You cause to prosper,","source_pair_start":324,"source_pair_end":324,"recitation_segment":{"id":"segment-323","title":"Recitation segment 323","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-324","sequence":324,"arabic_text":"وَ لا فَساداً إلاّ أصْلَحْتَهُ،","transliteration":"wa lā fasādan 'illā 'ašlaħtah,","english_text":"Nor any corruption but that which You correct,","source_pair_start":325,"source_pair_end":325,"recitation_segment":{"id":"segment-324","title":"Recitation segment 324","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-325","sequence":325,"arabic_text":"وَ لا أمَلاً إلاّ بَلَّغْتَهُ،","transliteration":"wa lā 'amalan 'illā ballaghtah,","english_text":"Nor any wish but that You fulfill,","source_pair_start":326,"source_pair_end":326,"recitation_segment":{"id":"segment-325","title":"Recitation segment 325","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-326","sequence":326,"arabic_text":"وَ لا دُعاءً إلاّ أجَبْتَهُ،","transliteration":"wa lā duā'an 'illā 'ajabtah,","english_text":"Nor any supplication but that You answer,","source_pair_start":327,"source_pair_end":327,"recitation_segment":{"id":"segment-326","title":"Recitation segment 326","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-327","sequence":327,"arabic_text":"وَ لا مَضيقاً إلاّ فَرَّجْتَهُ،","transliteration":"wa lā mađhīqan 'illā farrajtah,","english_text":"Nor any pressure but that You relieve,","source_pair_start":328,"source_pair_end":328,"recitation_segment":{"id":"segment-327","title":"Recitation segment 327","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-328","sequence":328,"arabic_text":"وَ لا شَمْلاً إلاّ جَمَعْتَهُ،","transliteration":"wa lā shamlan 'illā jamatah,","english_text":"Nor any dispersed (believers) but that You reunify,","source_pair_start":329,"source_pair_end":329,"recitation_segment":{"id":"segment-328","title":"Recitation segment 328","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-329","sequence":329,"arabic_text":"وَ لا أمْراً إلاّ أتْمَمْتَهُ،","transliteration":"wa lā 'amran 'illā 'atmamtah,","english_text":"Nor any matter but that You complete,","source_pair_start":330,"source_pair_end":330,"recitation_segment":{"id":"segment-329","title":"Recitation segment 329","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-330","sequence":330,"arabic_text":"وَ لا مالاً إلاّ كَثَّرْتَهُ،","transliteration":"wa lā mālan 'illā kath-thartah,","english_text":"Nor any wealth but that You increase,","source_pair_start":331,"source_pair_end":331,"recitation_segment":{"id":"segment-330","title":"Recitation segment 330","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
