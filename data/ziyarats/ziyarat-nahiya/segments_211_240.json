[{"id":"passage-211","sequence":211,"arabic_text":"بَرَزْنَ مِنَ الْخُدُورِ،","transliteration":"barazna minal khudūr,","english_text":"they came from the tents,","source_pair_start":212,"source_pair_end":212,"recitation_segment":{"id":"segment-211","title":"Recitation segment 211","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-212","sequence":212,"arabic_text":"ناشِراتِ الشُّعُورِ،","transliteration":"nāshirātish-shuūr,","english_text":"disheveling their hair,","source_pair_start":213,"source_pair_end":213,"recitation_segment":{"id":"segment-212","title":"Recitation segment 212","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-213","sequence":213,"arabic_text":"عَلَى الْخُدُودِ لاطِماتِ الْوُجُوهِ سافِراتٍ،","transliteration":"alal khudūdi lāţimātil wujūhi sāfirāt,","english_text":"striking their now unveiled cheeks,","source_pair_start":214,"source_pair_end":214,"recitation_segment":{"id":"segment-213","title":"Recitation segment 213","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-214","sequence":214,"arabic_text":"وَ بِالْعَويلِ داعِياتٍ،","transliteration":"wa bil awīli dāiyāt,","english_text":"calling you by lamenting and wailing,","source_pair_start":215,"source_pair_end":215,"recitation_segment":{"id":"segment-214","title":"Recitation segment 214","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-215","sequence":215,"arabic_text":"وَ بَعْدَ الْعِزِّ مُذَلَّلاتِ،","transliteration":"wa badal izzi mudhallalāt,","english_text":"being humiliated after being honored,","source_pair_start":216,"source_pair_end":216,"recitation_segment":{"id":"segment-215","title":"Recitation segment 215","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-216","sequence":216,"arabic_text":"وَ إلى مَصْرَعِكَ مُبادِراتٍ،","transliteration":"wa 'ilā mašraika mubādirāt,","english_text":"hastening to where you lay wounded.","source_pair_start":217,"source_pair_end":217,"recitation_segment":{"id":"segment-216","title":"Recitation segment 216","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-217","sequence":217,"arabic_text":"وَ الشِّمْرُ جالِسٌ عَلى صَدْرِكَ،","transliteration":"wash-shimru jālisun alā šadrik,","english_text":"At that time Shimr (L) was sitting on your chest,","source_pair_start":218,"source_pair_end":218,"recitation_segment":{"id":"segment-217","title":"Recitation segment 217","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-218","sequence":218,"arabic_text":"وَ مُولِغٌ سَيْفَهُ عَلى نَحْرِكَ،","transliteration":"mūlighon sayfahu alā naħrik,","english_text":"quenching his sword with (the blood of) your throat,","source_pair_start":219,"source_pair_end":219,"recitation_segment":{"id":"segment-218","title":"Recitation segment 218","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-219","sequence":219,"arabic_text":"قابِضٌ عَلى شَيْبَتِكَ بِيَدِهِ،","transliteration":"qābiđhun alā shaybatika biyadih,","english_text":"grabbing your beard with his hand,","source_pair_start":220,"source_pair_end":220,"recitation_segment":{"id":"segment-219","title":"Recitation segment 219","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-220","sequence":220,"arabic_text":"ذابِحٌ لَكَ بِمُهَنَّدِهِ،","transliteration":"dhābiħun laka bimuhannadih,","english_text":"as he slew you with his sword.","source_pair_start":221,"source_pair_end":221,"recitation_segment":{"id":"segment-220","title":"Recitation segment 220","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-221","sequence":221,"arabic_text":"قَدْ سَكَنَتْ حَواسُّكَ،","transliteration":"qad sakanat ħawāsuka,","english_text":"Your faculties faded,","source_pair_start":222,"source_pair_end":222,"recitation_segment":{"id":"segment-221","title":"Recitation segment 221","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-222","sequence":222,"arabic_text":"وَ خَفِيَتْ أنْفاسُكَ،","transliteration":"wa khafiyat 'anfāsuka,","english_text":"your breath became shallow and ceased,","source_pair_start":223,"source_pair_end":223,"recitation_segment":{"id":"segment-222","title":"Recitation segment 222","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-223","sequence":223,"arabic_text":"وَ رُفِعَ عَلَى الْقَناةِ رَأْسُكَ،","transliteration":"wa rufia alal qanāti ra'suka,","english_text":"and your head was raised onto a spear.","source_pair_start":224,"source_pair_end":224,"recitation_segment":{"id":"segment-223","title":"Recitation segment 223","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-224","sequence":224,"arabic_text":"وَ سُبِيَ أهْلُكَ كَالْعَبيدِ،","transliteration":"wa subiya 'ahluka kal abīd,","english_text":"Your family were captured like slaves,","source_pair_start":225,"source_pair_end":225,"recitation_segment":{"id":"segment-224","title":"Recitation segment 224","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-225","sequence":225,"arabic_text":"وَ صُفِّدُوا فِي الْحَديدِ فَوْقَ أقْتابِ الْمَطِيّاتِ،","transliteration":"wa šuffidū fil ħadīdi fawqa 'aqtābil maţiyyāt,","english_text":"bound with iron chains atop camels,","source_pair_start":226,"source_pair_end":226,"recitation_segment":{"id":"segment-225","title":"Recitation segment 225","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-226","sequence":226,"arabic_text":"تَلْفَحُ وُجُوهَهُمْ حَرُّ الْهاجِراتِ،","transliteration":"talfaħu wujūhahum ħarrul hājirāt,","english_text":"with midday heat scorching their faces.","source_pair_start":227,"source_pair_end":227,"recitation_segment":{"id":"segment-226","title":"Recitation segment 226","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-227","sequence":227,"arabic_text":"يُساقُونَ فِي الْبَراري وَ الْفَلَواتِ،","transliteration":"yusāqūna fil barārī wal falawāt,","english_text":"They were driven across deserts and wastelands,","source_pair_start":228,"source_pair_end":228,"recitation_segment":{"id":"segment-227","title":"Recitation segment 227","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-228","sequence":228,"arabic_text":"أيْديهِمْ مَغلُولَةٌ إلَى الأعْناقِ،","transliteration":"'aydīhim maghlūlatun 'ilal 'anāq,","english_text":"with their hands chained to their necks,","source_pair_start":229,"source_pair_end":229,"recitation_segment":{"id":"segment-228","title":"Recitation segment 228","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-229","sequence":229,"arabic_text":"يُطافُ بِهِمْ فِي الأسْواقِ،","transliteration":"yuţāfu bihim fil 'aswāq,","english_text":"and were paraded around the markets.","source_pair_start":230,"source_pair_end":230,"recitation_segment":{"id":"segment-229","title":"Recitation segment 229","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-230","sequence":230,"arabic_text":"فَالْوَيْلُ لِلْعُصاةِ الْفُسّاقِ،","transliteration":"fal waylu lil ušātil fussāq,","english_text":"Woe be unto the wicked transgressors!","source_pair_start":231,"source_pair_end":231,"recitation_segment":{"id":"segment-230","title":"Recitation segment 230","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-231","sequence":231,"arabic_text":"لَقَدْ قَتَلُوا بِقَتْلِكَ الإسْلامَ،","transliteration":"laqad qatalū biqatlikal islām,","english_text":"Certainly, by killing you, they have killed Islam,[1]","source_pair_start":232,"source_pair_end":232,"recitation_segment":{"id":"segment-231","title":"Recitation segment 231","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-232","sequence":232,"arabic_text":"وَ عَطَّلُوا الصَّلوةَ وَ الصِّيامَ،","transliteration":"wa aţţaluš-šalāta waš-šiyām,","english_text":"disrupted (the truth of) prayer and fasting,","source_pair_start":233,"source_pair_end":233,"recitation_segment":{"id":"segment-232","title":"Recitation segment 232","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-233","sequence":233,"arabic_text":"وَ نَقَضُوا السُّنَنَ وَ الأحْكامَ،","transliteration":"wa naqađhus-sunana wal 'aħkām,","english_text":"revoked the (prophetic) customs and the (divine) laws,","source_pair_start":234,"source_pair_end":234,"recitation_segment":{"id":"segment-233","title":"Recitation segment 233","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-234","sequence":234,"arabic_text":"وَ هَدَمُوا قَواعِدَ الإيمانِ،","transliteration":"wa hadamū qawāidal 'īmān,","english_text":"destroyed the pillars of faith,","source_pair_start":235,"source_pair_end":235,"recitation_segment":{"id":"segment-234","title":"Recitation segment 234","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-235","sequence":235,"arabic_text":"وَ حَرَّفُوا آياتِ الْقُرْآنِ،","transliteration":"wa ħarrafū āyātil qur'ān,","english_text":"distorted the verses of the Quran,","source_pair_start":236,"source_pair_end":236,"recitation_segment":{"id":"segment-235","title":"Recitation segment 235","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-236","sequence":236,"arabic_text":"وَ هَمْلَجُوا فِي الْبَغْيِ وَ الْعُدْوانِ،","transliteration":"wa hamlajū fil baghyi wal udwān,","english_text":"and brutally rushed into tyranny and aggression.","source_pair_start":237,"source_pair_end":237,"recitation_segment":{"id":"segment-236","title":"Recitation segment 236","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-237","sequence":237,"arabic_text":"لَقَدْ أصْبَحَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَ آلِهِ مَوْتُوراً،","transliteration":"laqad 'ašbaħa rasūlul-lāhi šallal-lāhu alayhi wa ālihi mawtūrā,","english_text":"Certainly, (by this event,) the Messenger of Allah (PBUH&HF)was wronged, left alone, and denied vengeance,","source_pair_start":238,"source_pair_end":238,"recitation_segment":{"id":"segment-237","title":"Recitation segment 237","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-238","sequence":238,"arabic_text":"وَ عادَ كِتابُ اللهِ عَزَّوَجَلَّ مَهْجُوراً،","transliteration":"wa āda kitābul-lāhi azza wa jalla mahjūrā,","english_text":"the Book of Allah, the mighty and the majestic, was again abandoned,","source_pair_start":239,"source_pair_end":239,"recitation_segment":{"id":"segment-238","title":"Recitation segment 238","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-239","sequence":239,"arabic_text":"وَ غُودِرَ الْحَقُّ إذْ قُهِرْتَ مَقْهُوراً،","transliteration":"wa ghūdiral ħaqqu 'idh quhirta maqhūrā,","english_text":"truth was betrayed when you were forcibly overcome,","source_pair_start":240,"source_pair_end":240,"recitation_segment":{"id":"segment-239","title":"Recitation segment 239","repeatable":true,"suggested_repetitions":3,"pause_after":true}},{"id":"passage-240","sequence":240,"arabic_text":"وَ فُقِدَ بِفَقْدِكَ التَّكْبيرُ وَ التَّهْليلُ،","transliteration":"wa fuqida bi faqdikat-takbīru wat-tahlīl,","english_text":"And with your loss, call for Allah’s glorification and His Unity,","source_pair_start":241,"source_pair_end":241,"recitation_segment":{"id":"segment-240","title":"Recitation segment 240","repeatable":true,"suggested_repetitions":3,"pause_after":true}}]
